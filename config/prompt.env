AGENT_FIXED_PROMPT=refactor

# novice | expert — selects config/prompter_system_prompt*.txt (override with --prompter-profile).
PROMPTER_PROFILE=novice
# Optional explicit file override (takes precedence over PROMPTER_PROFILE):
# PROMPTER_SYSTEM_PROMPT_FILE=prompter_system_prompt.txt

PROMPTER_NUDGE=The coding agent replied above. Ask your next refactoring request.

CLARIFICATION_REFUSAL_PATTERNS_FILE=clarification_refusal_patterns.txt
CLARIFICATION_SIGNAL_PATTERNS_FILE=clarification_signal_patterns.txt
CLARIFICATION_REQUIRE_QUESTION_MARK=true
PROMPTER_CLARIFICATION_NUDGE=The coding agent asked for clarification above.

# --- Provider usage/session-limit detection (auto-pause). ---
# Runner-side: detect a limit on the first dead turn and abort (exit 3) before persisting
# corrupt data. The orchestrator (run_pipeline) then pauses until reset and re-runs fresh.
LIMIT_DETECT_ENABLED=true
# Surface Gemini prompter errors as limits. Off by default: the prompter intentionally falls
# back to the fixed prompt on a Gemini error. Turn 429 on if quota exhaustion should pause runs.
LIMIT_GEMINI_SURFACE=false
# 503 is transient overload (not a true quota); keep off unless it's causing real corruption.
LIMIT_GEMINI_SURFACE_503=false
# Optional files of extra regexes (one per line) to widen claude/codex limit detection.
LIMIT_CLAUDE_PATTERNS_FILE=
LIMIT_CODEX_PATTERNS_FILE=

# --- Orchestrator pause/resume defaults (read by run_pipeline; CLI flags override). ---
LIMIT_AUTO_PAUSE=true
LIMIT_MAX_WAIT_MINUTES=480
LIMIT_POLL_INTERVAL_SECONDS=60
LIMIT_BUFFER_MINUTES=2
LIMIT_FIXED_WAIT_MINUTES=60
LIMIT_CLEANUP_DEAD_RUNS=true
