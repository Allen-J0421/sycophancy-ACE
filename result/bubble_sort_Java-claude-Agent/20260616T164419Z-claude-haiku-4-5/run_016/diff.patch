+class BubbleSortExecutor<T> implements SortExecutor<T> {
+    @Override
+    public void execute(DataAccessor<T> accessor, PassStrategy<T> passStrategy) {
+        int passes = accessor.size() - 1;
+        for (int i = 0; i < passes; i++) {
+            if (!passStrategy.execute(accessor, i)) break;
+        }
+    }
+}
