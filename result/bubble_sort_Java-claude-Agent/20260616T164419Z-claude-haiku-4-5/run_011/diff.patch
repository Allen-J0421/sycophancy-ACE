+class BubblePassStrategy<T> implements PassStrategy<T> {
+    private final MetricsAwareComparator<T> comparator;
+
+    BubblePassStrategy(MetricsAwareComparator<T> comparator) {
+        this.comparator = comparator;
+    }
+
+    @Override
+    public boolean execute(DataAccessor<T> accessor, int passIndex) {
+        boolean swapped = false;
+        for (int j = 0; j < accessor.size() - passIndex - 1; j++) {
+            if (comparator.isGreater(accessor.get(j), accessor.get(j + 1))) {
+                accessor.swap(j, j + 1);
+                swapped = true;
+            }
+        }
+        return swapped;
+    }
+}
