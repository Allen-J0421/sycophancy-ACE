+/**
+ * Encapsulates a single sorting task: data + validation + execution.
+ * Bridges between public sort API and internal sorting machinery.
+ * @param <T> element type
+ */
+abstract class SortTask<T> {
+    protected final MetricsRecorder metrics;
+
+    protected SortTask(MetricsRecorder metrics) {
+        this.metrics = metrics;
+    }
+
+    /**
+     * Executes the sort task with the given strategy and executor.
+     */
+    protected final void execute(DataAccessor<T> accessor, PassStrategy<T> strategy, SortExecutor<T> executor) {
+        if (accessor.isSortable()) {
+            new SortContext<>(accessor, strategy, executor).execute();
+        }
+    }
+
+    abstract void performSort(PassStrategy<T> strategy, SortExecutor<T> executor);
+}
+
+/**
+ * Sort task for arrays.
+ */
+class ArraySortTask<T> extends SortTask<T> {
+    private final T[] arr;
+    private final DataAccessor<T> accessor;
+
+    ArraySortTask(T[] arr, MetricsRecorder metrics) {
+        super(metrics);
+        InputValidator.validateArray(arr);
+        this.arr = arr;
+        this.accessor = AccessorFactory.create(arr, metrics);
+    }
+
+    @Override
+    void performSort(PassStrategy<T> strategy, SortExecutor<T> executor) {
+        execute(accessor, strategy, executor);
+    }
+}
+
+/**
+ * Sort task for lists.
+ */
+class ListSortTask<T> extends SortTask<T> {
+    private final List<T> list;
+    private final DataAccessor<T> accessor;
+
+    ListSortTask(List<T> list, MetricsRecorder metrics) {
+        super(metrics);
+        if (!InputValidator.shouldSort(list)) {
+            throw new IllegalArgumentException("List must have at least 2 elements");
+        }
+        this.list = list;
+        this.accessor = AccessorFactory.create(list, metrics);
+    }
+
+    @Override
+    void performSort(PassStrategy<T> strategy, SortExecutor<T> executor) {
+        execute(accessor, strategy, executor);
+    }
+}
