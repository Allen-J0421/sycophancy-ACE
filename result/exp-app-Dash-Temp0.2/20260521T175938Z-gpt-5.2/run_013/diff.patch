diff --git a/backend/test/comments.test.js b/backend/test/comments.test.js
new file mode 100644
index 0000000..f01ed60
--- /dev/null
+++ b/backend/test/comments.test.js
@@ -0,0 +1,67 @@
+const { test, after } = require("node:test");
+const assert = require("node:assert/strict");
+
+const createApp = require("../app");
+const seed = require("../seed");
+const { sequelize } = require("../models");
+
+test("GET /api/articles/:slug/comments returns seeded comments", async (t) => {
+  await sequelize.sync({ force: true });
+  await seed();
+
+  const app = createApp();
+  const server = app.listen(0);
+  t.after(() => server.close());
+
+  const { port } = server.address();
+  const res = await fetch(`http://localhost:${port}/api/articles/a1/comments`);
+
+  assert.equal(res.status, 200);
+  const data = await res.json();
+
+  assert.ok(data);
+  assert.ok(Array.isArray(data.comments));
+
+  const bodies = data.comments.map((c) => c.body).sort();
+  assert.deepEqual(bodies, ["c1", "c2"]);
+
+  for (const comment of data.comments) {
+    assert.ok(comment.id);
+    assert.ok(comment.author);
+    assert.equal(comment.author.username, "u1");
+  }
+});
+
+test("GET /api/articles/:slug/comments returns 404 for missing slug", async (t) => {
+  await sequelize.sync({ force: true });
+
+  const app = createApp();
+  const server = app.listen(0);
+  t.after(() => server.close());
+
+  const { port } = server.address();
+  const res = await fetch(
+    `http://localhost:${port}/api/articles/does-not-exist/comments`,
+  );
+
+  assert.equal(res.status, 404);
+  const data = await res.json();
+  assert.deepEqual(data, { error: "not_found" });
+});
+
+test("Unknown /api routes return JSON 404", async (t) => {
+  const app = createApp();
+  const server = app.listen(0);
+  t.after(() => server.close());
+
+  const { port } = server.address();
+  const res = await fetch(`http://localhost:${port}/api/nope`);
+
+  assert.equal(res.status, 404);
+  const data = await res.json();
+  assert.deepEqual(data, { error: "not_found" });
+});
+
+after(async () => {
+  await sequelize.close();
+});
