diff --git a/frontend/src/hooks/useComments.js b/frontend/src/hooks/useComments.js
new file mode 100644
index 0000000..8b859d1
--- /dev/null
+++ b/frontend/src/hooks/useComments.js
@@ -0,0 +1,30 @@
+import { useEffect, useState } from "react";
+import { getComments } from "../api";
+
+export default function useComments(slug) {
+  const [comments, setComments] = useState([]);
+  const [error, setError] = useState(null);
+
+  useEffect(() => {
+    if (!slug) {
+      setComments([]);
+      setError(null);
+      return;
+    }
+
+    const controller = new AbortController();
+    setComments([]);
+    setError(null);
+
+    getComments(slug, { signal: controller.signal })
+      .then(setComments)
+      .catch((err) => {
+        if (err?.name === "AbortError") return;
+        setError(err?.message ?? String(err));
+      });
+
+    return () => controller.abort();
+  }, [slug]);
+
+  return { comments, error };
+}
