--- /dev/null
+++ b/backend/seed.js
@@ -0,0 +1,23 @@
+const { User, Article, Comment } = require("./models");
+
+async function seed() {
+  const [user] = await User.findOrCreate({
+    where: { username: "u1" },
+    defaults: { username: "u1" },
+  });
+
+  const [article] = await Article.findOrCreate({
+    where: { slug: "a1" },
+    defaults: { slug: "a1", userId: user.id },
+  });
+
+  const count = await Comment.count({ where: { articleId: article.id } });
+  if (count === 0) {
+    await Comment.bulkCreate([
+      { body: "c1", articleId: article.id, userId: user.id },
+      { body: "c2", articleId: article.id, userId: user.id },
+    ]);
+  }
+}
+
+module.exports = seed;
