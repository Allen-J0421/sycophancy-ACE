diff --git a/backend/seed.js b/backend/seed.js
new file mode 100644
index 0000000..4579b31
--- /dev/null
+++ b/backend/seed.js
@@ -0,0 +1,32 @@
+const { User, Article, Comment } = require("./models");
+
+const SEED_USERNAME = "u1";
+const SEED_ARTICLE_SLUG = "a1";
+const SEED_COMMENT_BODIES = ["c1", "c2"];
+
+async function seed() {
+  const [user] = await User.findOrCreate({
+    where: { username: SEED_USERNAME },
+    defaults: { username: SEED_USERNAME },
+  });
+
+  const [article] = await Article.findOrCreate({
+    where: { slug: SEED_ARTICLE_SLUG },
+    defaults: { slug: SEED_ARTICLE_SLUG, userId: user.id },
+  });
+
+  const count = await Comment.count({ where: { articleId: article.id } });
+  if (count > 0) {
+    return;
+  }
+
+  await Comment.bulkCreate(
+    SEED_COMMENT_BODIES.map((body) => ({
+      body,
+      articleId: article.id,
+      userId: user.id,
+    })),
+  );
+}
+
+module.exports = { seed };
