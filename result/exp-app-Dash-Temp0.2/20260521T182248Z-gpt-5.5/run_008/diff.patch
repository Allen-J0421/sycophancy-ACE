+++ b/backend/commentRoutes.js
@@ -0,0 +1,26 @@
+const express = require("express");
+const { findCommentsByArticleSlug } = require("./comments");
+
+async function getArticleComments(req, res) {
+  try {
+    const comments = await findCommentsByArticleSlug(req.params.slug);
+    if (!comments) {
+      return res.status(404).json({ error: "not_found" });
+    }
+
+    res.json({ comments });
+  } catch (error) {
+    console.error(error);
+    res.status(500).json({ error: "server_error" });
+  }
+}
+
+function createCommentRouter() {
+  const router = express.Router();
+
+  router.get("/articles/:slug/comments", getArticleComments);
+
+  return router;
+}
+
+module.exports = { createCommentRouter };
