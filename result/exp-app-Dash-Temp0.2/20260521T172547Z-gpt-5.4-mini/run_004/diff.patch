diff --git a/backend/articleModel.js b/backend/articleModel.js
new file mode 100644
index 0000000..68014c4
--- /dev/null
+++ b/backend/articleModel.js
@@ -0,0 +1,20 @@
+"use strict";
+
+const { DataTypes } = require("sequelize");
+const { sequelize, SerializableModel } = require("./database");
+
+class Article extends SerializableModel {
+  static associate(models) {
+    this.belongsTo(models.User, { foreignKey: "userId", as: "author" });
+    this.hasMany(models.Comment, { foreignKey: "articleId", onDelete: "cascade" });
+  }
+}
+
+Article.hiddenFields = ["id", "userId"];
+
+Article.init(
+  { slug: DataTypes.STRING },
+  { sequelize, modelName: "Article" },
+);
+
+module.exports = Article;
diff --git a/backend/commentModel.js b/backend/commentModel.js
new file mode 100644
index 0000000..3054d66
--- /dev/null
+++ b/backend/commentModel.js
@@ -0,0 +1,28 @@
+"use strict";
+
+const { DataTypes } = require("sequelize");
+const { sequelize, SerializableModel } = require("./database");
+
+class Comment extends SerializableModel {
+  static associate(models) {
+    this.belongsTo(models.Article, { foreignKey: "articleId" });
+    this.belongsTo(models.User, { as: "author", foreignKey: "userId" });
+  }
+}
+
+Comment.hiddenFields = ["articleId", "userId"];
+
+Comment.init(
+  {
+    id: {
+      allowNull: false,
+      autoIncrement: true,
+      primaryKey: true,
+      type: DataTypes.INTEGER,
+    },
+    body: DataTypes.TEXT,
+  },
+  { sequelize, modelName: "Comment" },
+);
+
+module.exports = Comment;
diff --git a/backend/database.js b/backend/database.js
new file mode 100644
index 0000000..6f38ae1
--- /dev/null
+++ b/backend/database.js
@@ -0,0 +1,27 @@
+"use strict";
+
+const { Sequelize, Model } = require("sequelize");
+
+const sequelize = new Sequelize({
+  dialect: "sqlite",
+  storage: ":memory:",
+  logging: false,
+});
+
+function stripFields(instance, fields) {
+  const data = { ...instance.get() };
+
+  for (const field of fields) {
+    delete data[field];
+  }
+
+  return data;
+}
+
+class SerializableModel extends Model {
+  toJSON() {
+    return stripFields(this, this.constructor.hiddenFields ?? []);
+  }
+}
+
+module.exports = { sequelize, SerializableModel };
