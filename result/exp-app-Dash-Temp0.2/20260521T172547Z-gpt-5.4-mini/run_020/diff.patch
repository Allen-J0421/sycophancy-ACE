diff --git a/backend/commentRepository.js b/backend/commentRepository.js
new file mode 100644
index 0000000..9312fa7
--- /dev/null
+++ b/backend/commentRepository.js
@@ -0,0 +1,28 @@
+"use strict";
+
+function buildCommentInclude(User) {
+  return [{ model: User, as: "author", attributes: ["username"] }];
+}
+
+function createCommentRepository({ Article, User }) {
+  const COMMENT_INCLUDE = buildCommentInclude(User);
+
+  async function getCommentsBySlug(slug) {
+    const article = await Article.findOne({ where: { slug } });
+    if (!article) {
+      return null;
+    }
+
+    return article.getComments({
+      include: COMMENT_INCLUDE,
+    });
+  }
+
+  return {
+    getCommentsBySlug,
+  };
+}
+
+module.exports = {
+  createCommentRepository,
+};
diff --git a/backend/commentSeeder.js b/backend/commentSeeder.js
new file mode 100644
index 0000000..44cd9de
--- /dev/null
+++ b/backend/commentSeeder.js
@@ -0,0 +1,41 @@
+"use strict";
+
+function createCommentSeeder({
+  User,
+  Article,
+  Comment,
+  articleSlug,
+  seedUser,
+  seedComments,
+}) {
+  async function seedDemoData() {
+    const [user] = await User.findOrCreate({
+      where: { username: seedUser.username },
+      defaults: { username: seedUser.username },
+    });
+
+    const [article] = await Article.findOrCreate({
+      where: { slug: articleSlug },
+      defaults: { slug: articleSlug, userId: user.id },
+    });
+
+    const count = await Comment.count({ where: { articleId: article.id } });
+    if (count === 0) {
+      await Comment.bulkCreate(
+        seedComments.map((body) => ({
+          body,
+          articleId: article.id,
+          userId: user.id,
+        })),
+      );
+    }
+  }
+
+  return {
+    seedDemoData,
+  };
+}
+
+module.exports = {
+  createCommentSeeder,
+};
