@@ -24,4 +24,13 @@ class SerializableModel extends Model {
   }
 }
 
-module.exports = { sequelize, SerializableModel };
+function defineSerializableModel(ModelClass, attributes, options = {}) {
+  const { modelName, hiddenFields = [] } = options;
+
+  ModelClass.hiddenFields = hiddenFields;
+  ModelClass.init(attributes, { sequelize, modelName });
+
+  return ModelClass;
+}
+
+module.exports = { sequelize, SerializableModel, defineSerializableModel };
