diff --git a/backend/commentRoutes.js b/backend/commentRoutes.js
new file mode 100644
index 0000000..15be521
--- /dev/null
+++ b/backend/commentRoutes.js
@@ -0,0 +1,26 @@
+"use strict";
+
+const express = require("express");
+const { getCommentsBySlug } = require("./commentService");
+
+function createCommentRouter() {
+  const router = express.Router();
+
+  router.get("/articles/:slug/comments", async (req, res) => {
+    try {
+      const comments = await getCommentsBySlug(req.params.slug);
+      if (!comments) {
+        return res.status(404).json({ error: "not_found" });
+      }
+
+      res.json({ comments });
+    } catch (error) {
+      console.error(error);
+      res.status(500).json({ error: "server_error" });
+    }
+  });
+
+  return router;
+}
+
+module.exports = { createCommentRouter };
