@@ -0,0 +1,29 @@
+"use strict";
+
+const express = require("express");
+const cors = require("cors");
+const { getCommentsBySlug } = require("./commentService");
+
+function createApp() {
+  const app = express();
+
+  app.use(cors());
+
+  app.get("/api/articles/:slug/comments", async (req, res) => {
+    try {
+      const comments = await getCommentsBySlug(req.params.slug);
+      if (!comments) {
+        return res.status(404).json({ error: "not_found" });
+      }
+
+      res.json({ comments });
+    } catch (error) {
+      console.error(error);
+      res.status(500).json({ error: "server_error" });
+    }
+  });
+
+  return app;
+}
+
+module.exports = { createApp };
