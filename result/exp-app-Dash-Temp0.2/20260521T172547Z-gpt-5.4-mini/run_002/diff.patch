+const { User, Article, Comment } = require("./models");
+
+const SEED = {
+  username: "u1",
+  slug: "a1",
+  comments: ["c1", "c2"],
+};
+
+const COMMENT_INCLUDE = [
+  { model: User, as: "author", attributes: ["username"] },
+];
+
+async function seedDemoData() {
+  const [user] = await User.findOrCreate({
+    where: { username: SEED.username },
+    defaults: { username: SEED.username },
+  });
+
+  const [article] = await Article.findOrCreate({
+    where: { slug: SEED.slug },
+    defaults: { slug: SEED.slug, userId: user.id },
+  });
+
+  const count = await Comment.count({ where: { articleId: article.id } });
+  if (count === 0) {
+    await Comment.bulkCreate(
+      SEED.comments.map((body) => ({
+        body,
+        articleId: article.id,
+        userId: user.id,
+      })),
+    );
+  }
+}
+
+async function getCommentsBySlug(slug) {
+  const article = await Article.findOne({ where: { slug } });
+  if (!article) {
+    return null;
+  }
+
+  return article.getComments({
+    include: COMMENT_INCLUDE,
+  });
+}
+
+module.exports = {
+  getCommentsBySlug,
+  seedDemoData,
+};
