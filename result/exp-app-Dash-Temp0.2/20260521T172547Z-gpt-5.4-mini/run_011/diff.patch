diff --git a/frontend/src/useAbortableAsync.js b/frontend/src/useAbortableAsync.js
new file mode 100644
index 0000000..11c14d2
--- /dev/null
+++ b/frontend/src/useAbortableAsync.js
@@ -0,0 +1,35 @@
+import { useEffect, useRef, useState } from "react";
+
+export default function useAbortableAsync(
+  factory,
+  dependencies,
+  { initialValue, errorMessage = "Request failed" } = {},
+) {
+  const factoryRef = useRef(factory);
+  const [value, setValue] = useState(initialValue);
+  const [error, setError] = useState(null);
+
+  factoryRef.current = factory;
+
+  useEffect(() => {
+    const controller = new AbortController();
+
+    setValue(initialValue);
+    setError(null);
+
+    Promise.resolve(factoryRef.current(controller.signal))
+      .then((nextValue) => {
+        if (!controller.signal.aborted) {
+          setValue(nextValue);
+        }
+      })
+      .catch((err) => {
+        if (err?.name === "AbortError") return;
+        setError(err?.message ?? errorMessage);
+      });
+
+    return () => controller.abort();
+  }, dependencies);
+
+  return { value, error };
+}
