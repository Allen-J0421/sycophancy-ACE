--- /dev/null
+++ b/backend/asyncHandler.js
@@ -0,0 +1,9 @@
+"use strict";
+
+function asyncHandler(handler) {
+  return (req, res, next) => {
+    Promise.resolve(handler(req, res, next)).catch(next);
+  };
+}
+
+module.exports = { asyncHandler };
