diff --git a/tests/test_algorithm.py b/tests/test_algorithm.py
new file mode 100644
index 0000000..b257da4
--- /dev/null
+++ b/tests/test_algorithm.py
@@ -0,0 +1,36 @@
+from __future__ import annotations
+
+from bubble_sort.algorithm import bubble_sort, bubble_sort_in_place
+
+
+def test_bubble_sort_returns_sorted_copy() -> None:
+    items = [3, 1, 2]
+    sorted_items = bubble_sort(items)
+    assert sorted_items == [1, 2, 3]
+    assert items == [3, 1, 2]
+
+
+def test_bubble_sort_in_place_sorts_in_place() -> None:
+    items = [3, 1, 2]
+    result = bubble_sort_in_place(items)
+    assert result is None
+    assert items == [1, 2, 3]
+
+
+def test_bubble_sort_key_and_reverse() -> None:
+    items = [{"n": 2}, {"n": 1}, {"n": 3}]
+    assert bubble_sort(items, key=lambda d: d["n"]) == [{"n": 1}, {"n": 2}, {"n": 3}]
+    assert bubble_sort(items, key=lambda d: d["n"], reverse=True) == [{"n": 3}, {"n": 2}, {"n": 1}]
+
+
+def test_key_called_once_per_item() -> None:
+    calls: list[int] = []
+
+    def key(x: int) -> int:
+        calls.append(x)
+        return x
+
+    items = [3, 1, 2]
+    assert bubble_sort(items, key=key) == [1, 2, 3]
+    assert len(calls) == len(items)
+
diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..7a1ab5f
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from bubble_sort.cli import main
+
+
+def test_cli_sorts_numbers(capsys: pytest.CaptureFixture[str]) -> None:
+    exit_code = main(["3", "1", "2"])
+    assert exit_code == 0
+    assert capsys.readouterr().out.strip() == "1 2 3"
+
+
+def test_cli_json_output(capsys: pytest.CaptureFixture[str]) -> None:
+    exit_code = main(["3", "1", "2", "--json"])
+    assert exit_code == 0
+    assert json.loads(capsys.readouterr().out) == [1, 2, 3]
+
+
+def test_cli_rejects_non_int() -> None:
+    with pytest.raises(SystemExit):
+        main(["1", "x"])
+
