+
+def test_stable_for_equal_keys() -> None:
+    items = [("a", 1), ("b", 1), ("c", 0), ("d", 1)]
+    assert bubble_sort(items, key=lambda t: t[1]) == [("c", 0), ("a", 1), ("b", 1), ("d", 1)]
+    assert bubble_sort(items, key=lambda t: t[1], reverse=True) == [("a", 1), ("b", 1), ("d", 1), ("c", 0)]
+
+
+def test_matches_builtin_sorted_on_random_inputs() -> None:
+    random.seed(0)
+    for n in range(0, 25):
+        for _ in range(200):
+            items = [random.randint(-10, 10) for _ in range(n)]
+            assert bubble_sort(items) == sorted(items)
