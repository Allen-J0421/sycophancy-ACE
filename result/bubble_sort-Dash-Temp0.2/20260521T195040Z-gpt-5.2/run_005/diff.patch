+def test_cli_reads_from_stdin(monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]) -> None:
+    monkeypatch.setattr("sys.stdin", io.StringIO("3 1 2"))
+    exit_code = main([])
+    assert exit_code == 0
+    assert capsys.readouterr().out.strip() == "1 2 3"
+
+
+def test_cli_type_str(capsys: pytest.CaptureFixture[str]) -> None:
+    exit_code = main(["b", "a", "--type", "str"])
