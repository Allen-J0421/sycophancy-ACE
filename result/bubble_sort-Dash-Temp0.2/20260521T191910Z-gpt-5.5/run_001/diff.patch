+from collections.abc import MutableSequence
+from typing import Any
+
+
+def bubble_sort(items: MutableSequence[Any]) -> None:
+    """Sort items in ascending order in place using bubble sort."""
+    unsorted_until = len(items) - 1
+
+    while unsorted_until > 0:
+        swapped = False
+
+        for index in range(unsorted_until):
+            if items[index] > items[index + 1]:
+                items[index], items[index + 1] = items[index + 1], items[index]
+                swapped = True
+
+        if not swapped:
+            break
+
+        unsorted_until -= 1
