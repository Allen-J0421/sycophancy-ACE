@@ -0,0 +1,14 @@
+from collections.abc import MutableSequence
+
+from .algorithm import bubble_sort
+
+
+DEFAULT_SAMPLE: tuple[int, ...] = (64, 34, 25, 12, 22, 11, 90)
+
+
+def main(values: MutableSequence[int] | None = None) -> None:
+    """Sort and print a sample list for the demo entry point."""
+
+    sample = list(DEFAULT_SAMPLE) if values is None else values
+    bubble_sort(sample)
+    print(sample)
