+import java.util.Arrays;
+
+public final class BubbleSort {
+    private static final int[] SAMPLE_ARRAY = {64, 34, 25, 12, 22, 11, 90};
+
+    private BubbleSort() {
+    }
+
+    public static void sort(int[] array) {
+        if (array == null || array.length < 2) {
+            return;
+        }
+
+        for (int pass = 0; pass < array.length - 1; pass++) {
+            boolean swapped = false;
+
+            for (int index = 0; index < array.length - pass - 1; index++) {
+                if (array[index] > array[index + 1]) {
+                    swap(array, index, index + 1);
+                    swapped = true;
+                }
+            }
+
+            if (!swapped) {
+                break;
+            }
+        }
+    }
+
+    public static String toDisplayString(int[] array) {
+        if (array == null) {
+            return "null";
+        }
+
+        StringBuilder builder = new StringBuilder();
+        for (int index = 0; index < array.length; index++) {
+            if (index > 0) {
+                builder.append(' ');
+            }
+            builder.append(array[index]);
+        }
+        return builder.toString();
+    }
+
+    private static void swap(int[] array, int leftIndex, int rightIndex) {
+        int temp = array[leftIndex];
+        array[leftIndex] = array[rightIndex];
+        array[rightIndex] = temp;
+    }
+
+    public static void main(String[] args) {
+        int[] array = buildSampleArray();
+        sort(array);
+        System.out.println("Sorted array:");
+        System.out.println(toDisplayString(array));
+    }
+
+    private static int[] buildSampleArray() {
+        return Arrays.copyOf(SAMPLE_ARRAY, SAMPLE_ARRAY.length);
+    }
+}
