@@ -0,0 +1,28 @@
+final class BubbleSortInputParser {
+    private BubbleSortInputParser() {
+        // Utility class; do not instantiate.
+    }
+
+    static int[] parse(String[] args) {
+        if (args.length == 0) {
+            throw new IllegalArgumentException("No integers provided.");
+        }
+
+        int[] values = new int[args.length];
+
+        for (int i = 0; i < args.length; i++) {
+            values[i] = parseValue(args[i], i + 1);
+        }
+
+        return values;
+    }
+
+    private static int parseValue(String arg, int position) {
+        try {
+            return Integer.parseInt(arg);
+        } catch (NumberFormatException ex) {
+            throw new IllegalArgumentException(
+                    "Invalid integer at argument " + position + ": \"" + arg + "\"");
+        }
+    }
+}
