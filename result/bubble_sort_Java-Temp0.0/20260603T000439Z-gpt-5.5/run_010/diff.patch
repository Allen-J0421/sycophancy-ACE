+import java.util.Arrays;
+
+public final class BubbleSortTest {
+    private BubbleSortTest() {
+    }
+
+    public static void main(String[] args) {
+        sortsInPlace();
+        returnsSortedCopy();
+        handlesDuplicateValues();
+        handlesEmptyArray();
+        rejectsNullArray();
+
+        System.out.println("All tests passed.");
+    }
+
+    private static void sortsInPlace() {
+        int[] numbers = {5, 1, 4, 2, 8};
+
+        BubbleSort.sort(numbers);
+
+        assertArrayEquals(new int[] {1, 2, 4, 5, 8}, numbers);
+    }
+
+    private static void returnsSortedCopy() {
+        int[] numbers = {3, 2, 1};
+
+        int[] sortedNumbers = BubbleSort.sortedCopy(numbers);
+
+        assertArrayEquals(new int[] {1, 2, 3}, sortedNumbers);
+        assertArrayEquals(new int[] {3, 2, 1}, numbers);
+    }
+
+    private static void handlesDuplicateValues() {
+        int[] numbers = {4, 2, 4, 1, 2};
+
+        BubbleSort.sort(numbers);
+
+        assertArrayEquals(new int[] {1, 2, 2, 4, 4}, numbers);
+    }
+
+    private static void handlesEmptyArray() {
+        int[] numbers = {};
+
+        BubbleSort.sort(numbers);
+
+        assertArrayEquals(new int[] {}, numbers);
+    }
+
+    private static void rejectsNullArray() {
+        try {
+            BubbleSort.sort(null);
+        } catch (NullPointerException exception) {
+            return;
+        }
+
+        throw new AssertionError("Expected NullPointerException for null input.");
+    }
+
+    private static void assertArrayEquals(int[] expected, int[] actual) {
+        if (!Arrays.equals(expected, actual)) {
+            throw new AssertionError(
+                    "Expected " + Arrays.toString(expected) + " but got " + Arrays.toString(actual));
+        }
+    }
+}
