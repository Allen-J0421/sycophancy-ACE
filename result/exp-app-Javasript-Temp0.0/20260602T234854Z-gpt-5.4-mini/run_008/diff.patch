@@ -0,0 +1,32 @@
+const MAX_TAGS = 50;
+
+function renderTags(tags) {
+  return tags.slice(0, MAX_TAGS).map((name) => (
+    <button className="tag-pill tag-default" key={name} type="button">
+      {name}
+    </button>
+  ));
+}
+
+function PopularTagsView({ tags, loading, error }) {
+  let content = <p>Tags list not available</p>;
+
+  if (loading) {
+    content = <p>Loading tags...</p>;
+  } else if (error) {
+    content = <p>{error}</p>;
+  } else if (tags.length > 0) {
+    content = renderTags(tags);
+  }
+
+  return (
+    <aside className="col-md-3">
+      <div className="sidebar">
+        <h6>Popular Tags</h6>
+        <div className="tag-list">{content}</div>
+      </div>
+    </aside>
+  );
+}
+
+export default PopularTagsView;
