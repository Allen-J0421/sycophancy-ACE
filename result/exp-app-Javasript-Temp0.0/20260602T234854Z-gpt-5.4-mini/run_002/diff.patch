--- /dev/null
+++ b/frontend/src/hooks/usePopularTags.js
@@ -0,0 +1,41 @@
+import { useEffect, useState } from "react";
+import getTags from "../services/getTags";
+
+function usePopularTags() {
+  const [tags, setTags] = useState([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    let isMounted = true;
+
+    async function loadTags() {
+      try {
+        const nextTags = await getTags();
+
+        if (isMounted) {
+          setTags(nextTags);
+        }
+      } catch (requestError) {
+        if (isMounted) {
+          setError("Tags list not available");
+        }
+        console.error(requestError);
+      } finally {
+        if (isMounted) {
+          setLoading(false);
+        }
+      }
+    }
+
+    loadTags();
+
+    return () => {
+      isMounted = false;
+    };
+  }, []);
+
+  return { tags, loading, error };
+}
+
+export default usePopularTags;
