index 0000000..81107f0
--- /dev/null
+++ b/frontend/src/services/tagsApi.js
@@ -0,0 +1,19 @@
+import axios from "axios";
+
+const TAGS_ENDPOINT = "/api/tags";
+
+function normalizeTagsResponse(data) {
+  if (Array.isArray(data?.tags)) {
+    return data.tags;
+  }
+
+  return [];
+}
+
+async function fetchTags(signal) {
+  const { data } = await axios.get(TAGS_ENDPOINT, { signal });
+
+  return normalizeTagsResponse(data);
+}
+
+export { TAGS_ENDPOINT, fetchTags, normalizeTagsResponse };
