 import usePopularTags from "../../hooks/usePopularTags";
-import PopularTagsView from "./PopularTagsView";
+
+const MAX_TAGS = 50;
 
 function PopularTags() {
   const { tags, loading, error } = usePopularTags();
 
-  return <PopularTagsView tags={tags} loading={loading} error={error} />;
+  let content = <p>Tags list not available</p>;
+
+  if (loading) {
+    content = <p>Loading tags...</p>;
+  } else if (error) {
+    content = <p>{error}</p>;
+  } else if (tags.length > 0) {
+    content = (
+      <ul className="tag-list-items">
+        {tags.slice(0, MAX_TAGS).map((name) => (
+          <li key={name}>
+            <button className="tag-pill tag-default" type="button">
+              {name}
+            </button>
+          </li>
+        ))}
+      </ul>
+    );
+  }
+
+  return (
+    <aside className="col-md-3">
+      <div className="sidebar">
+        <h6>Popular Tags</h6>
+        <div className="tag-list">{content}</div>
+      </div>
+    </aside>
+  );
 }
 
 export default PopularTags;
