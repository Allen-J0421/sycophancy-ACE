diff --git a/frontend/src/hooks/usePopularTags.js b/frontend/src/hooks/usePopularTags.js
index ee19570..8b03dd2 100644
--- a/frontend/src/hooks/usePopularTags.js
+++ b/frontend/src/hooks/usePopularTags.js
@@ -1,14 +1,46 @@
-import useAsyncValue from "./useAsyncValue";
+import { useEffect, useState } from "react";
 import { fetchTags } from "../services/tagsApi";
 
 function usePopularTags() {
-  const { value: tags, loading, error } = useAsyncValue(fetchTags, []);
+  const [tags, setTags] = useState([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
 
-  return {
-    tags,
-    loading,
-    error: error ? "Tags list not available" : "",
-  };
+  useEffect(() => {
+    const controller = new AbortController();
+
+    async function loadTags() {
+      setLoading(true);
+      setError("");
+
+      try {
+        const nextTags = await fetchTags(controller.signal);
+        setTags(nextTags);
+      } catch (requestError) {
+        const isCanceled =
+          requestError?.name === "CanceledError" ||
+          requestError?.code === "ERR_CANCELED";
+
+        if (!isCanceled) {
+          setError("Tags list not available");
+          setTags([]);
+          console.error(requestError);
+        }
+      } finally {
+        if (!controller.signal.aborted) {
+          setLoading(false);
+        }
+      }
+    }
+
+    loadTags();
+
+    return () => {
+      controller.abort();
+    };
+  }, []);
+
+  return { tags, loading, error };
 }
 
 export default usePopularTags;
