+import TagButton from "./TagButton";
+import { TAG_STATUS } from "./usePopularTags";
+
+function TagListContent({ status, tags }) {
+  if (status === TAG_STATUS.LOADING) {
+    return <p>Loading tags...</p>;
+  }
+
+  if (tags.length > 0) {
+    return <TagButton tags={tags} />;
+  }
+
+  if (status === TAG_STATUS.ERROR) {
+    return <p>Unable to load tags</p>;
+  }
+
+  return <p>Tags list not available</p>;
+}
+
+export default TagListContent;
