diff --git a/frontend/src/components/PopularTags/usePopularTags.js b/frontend/src/components/PopularTags/usePopularTags.js
new file mode 100644
index 0000000..231fa82
--- /dev/null
+++ b/frontend/src/components/PopularTags/usePopularTags.js
@@ -0,0 +1,43 @@
+import { useEffect, useState } from "react";
+import getTags from "../../services/getTags";
+
+const TAG_STATUS = {
+  IDLE: "idle",
+  LOADING: "loading",
+  SUCCESS: "success",
+  ERROR: "error",
+};
+
+function usePopularTags() {
+  const [tags, setTags] = useState([]);
+  const [status, setStatus] = useState(TAG_STATUS.IDLE);
+
+  useEffect(() => {
+    let isMounted = true;
+
+    setStatus(TAG_STATUS.LOADING);
+
+    getTags()
+      .then((tagsList) => {
+        if (!isMounted) return;
+
+        setTags(tagsList);
+        setStatus(TAG_STATUS.SUCCESS);
+      })
+      .catch((error) => {
+        if (!isMounted) return;
+
+        console.error(error);
+        setStatus(TAG_STATUS.ERROR);
+      });
+
+    return () => {
+      isMounted = false;
+    };
+  }, []);
+
+  return { status, tags };
+}
+
+export { TAG_STATUS };
+export default usePopularTags;
