diff --git a/frontend/src/styles.css b/frontend/src/styles.css
new file mode 100644
index 0000000..e610e6b
--- /dev/null
+++ b/frontend/src/styles.css
@@ -0,0 +1,56 @@
+:root {
+  color-scheme: light;
+  --page-text: #333;
+  --page-background: #fafafa;
+  --card-border: #eee;
+  --muted-text: #888;
+  --error-text: #b00;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  font-family: system-ui, sans-serif;
+  margin: 0;
+  padding: 2rem;
+  color: var(--page-text);
+  background: var(--page-background);
+}
+
+h1 {
+  margin-top: 0;
+}
+
+.page {
+  max-width: 640px;
+  margin: 0 auto;
+}
+
+.feed {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+}
+
+.comment {
+  border: 1px solid var(--card-border);
+  border-radius: 8px;
+  padding: 1rem;
+}
+
+.comment-body {
+  margin: 0 0 0.5rem;
+}
+
+.comment-meta {
+  margin: 0;
+  font-size: 0.85rem;
+  color: var(--muted-text);
+}
+
+.loading,
+.error {
+  color: var(--error-text);
+}
