@@ -0,0 +1,18 @@
+async function findOrCreateByField(Model, field, value, defaults = {}) {
+  return Model.findOrCreate({
+    where: { [field]: value },
+    defaults: { [field]: value, ...defaults },
+  });
+}
+
+async function createRecordsIfEmpty(Model, where, records) {
+  const count = await Model.count({ where });
+  if (count === 0) {
+    await Model.bulkCreate(records);
+  }
+}
+
+module.exports = {
+  findOrCreateByField,
+  createRecordsIfEmpty,
+};
