new file mode 100644
index 0000000..3f19c45
--- /dev/null
+++ b/frontend/src/useAsyncData.js
@@ -0,0 +1,59 @@
+import { useEffect, useState } from "react";
+
+function createLoadingState() {
+  return {
+    data: null,
+    error: null,
+    status: "loading",
+  };
+}
+
+function createSuccessState(data) {
+  return {
+    data,
+    error: null,
+    status: "ready",
+  };
+}
+
+function createErrorState(error) {
+  return {
+    data: null,
+    error,
+    status: "error",
+  };
+}
+
+export function useAsyncData(load, deps) {
+  const [state, setState] = useState(() => createLoadingState());
+
+  useEffect(() => {
+    const controller = new AbortController();
+
+    setState(createLoadingState());
+
+    Promise.resolve()
+      .then(() => load({ signal: controller.signal }))
+      .then((data) => {
+        setState(createSuccessState(data));
+      })
+      .catch((error) => {
+        if (error?.name === "AbortError") {
+          return;
+        }
+
+        const message = error?.message ?? "Request failed";
+        setState(createErrorState(message));
+      });
+
+    return () => {
+      controller.abort();
+    };
+  }, deps);
+
+  return {
+    data: state.data,
+    error: state.error,
+    isLoading: state.status === "loading",
+  };
+}
