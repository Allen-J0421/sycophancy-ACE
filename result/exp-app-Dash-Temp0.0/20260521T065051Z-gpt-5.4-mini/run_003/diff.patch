diff --git a/backend/models/article.js b/backend/models/article.js
new file mode 100644
index 0000000..d5092b8
--- /dev/null
+++ b/backend/models/article.js
@@ -0,0 +1,19 @@
+const { DataTypes } = require("sequelize");
+const { sequelize } = require("../db");
+const { SerializableModel } = require("./base");
+
+class Article extends SerializableModel {
+  static associate(models) {
+    this.belongsTo(models.User, { foreignKey: "userId", as: "author" });
+    this.hasMany(models.Comment, { foreignKey: "articleId", onDelete: "CASCADE" });
+  }
+}
+
+Article.hiddenFields = ["id", "userId"];
+
+Article.init(
+  { slug: DataTypes.STRING },
+  { sequelize, modelName: "Article" },
+);
+
+module.exports = Article;
diff --git a/backend/models/base.js b/backend/models/base.js
new file mode 100644
index 0000000..6a28218
--- /dev/null
+++ b/backend/models/base.js
@@ -0,0 +1,16 @@
+const { Model } = require("sequelize");
+
+class SerializableModel extends Model {
+  toJSON() {
+    const data = { ...this.get() };
+    const hiddenFields = this.constructor.hiddenFields ?? [];
+
+    for (const field of hiddenFields) {
+      delete data[field];
+    }
+
+    return data;
+  }
+}
+
+module.exports = { SerializableModel };
diff --git a/backend/models/comment.js b/backend/models/comment.js
new file mode 100644
index 0000000..2b182e5
--- /dev/null
+++ b/backend/models/comment.js
@@ -0,0 +1,27 @@
+const { DataTypes } = require("sequelize");
+const { sequelize } = require("../db");
+const { SerializableModel } = require("./base");
+
+class Comment extends SerializableModel {
+  static associate(models) {
+    this.belongsTo(models.Article, { foreignKey: "articleId" });
+    this.belongsTo(models.User, { as: "author", foreignKey: "userId" });
+  }
+}
+
+Comment.hiddenFields = ["articleId", "userId"];
+
+Comment.init(
+  {
+    id: {
+      allowNull: false,
+      autoIncrement: true,
+      primaryKey: true,
+      type: DataTypes.INTEGER,
+    },
+    body: DataTypes.TEXT,
+  },
+  { sequelize, modelName: "Comment" },
+);
+
+module.exports = Comment;
diff --git a/backend/models/index.js b/backend/models/index.js
new file mode 100644
index 0000000..d1d0d66
--- /dev/null
+++ b/backend/models/index.js
@@ -0,0 +1,14 @@
+const { sequelize } = require("../db");
+const User = require("./user");
+const Article = require("./article");
+const Comment = require("./comment");
+
+const models = { User, Article, Comment };
+
+for (const model of Object.values(models)) {
+  if (typeof model.associate === "function") {
+    model.associate(models);
+  }
+}
+
+module.exports = { sequelize, ...models };
diff --git a/backend/models/user.js b/backend/models/user.js
new file mode 100644
index 0000000..1a9af50
--- /dev/null
+++ b/backend/models/user.js
@@ -0,0 +1,19 @@
+const { DataTypes } = require("sequelize");
+const { sequelize } = require("../db");
+const { SerializableModel } = require("./base");
+
+class User extends SerializableModel {
+  static associate(models) {
+    this.hasMany(models.Article, { foreignKey: "userId", onDelete: "CASCADE" });
+    this.hasMany(models.Comment, { foreignKey: "userId" });
+  }
+}
+
+User.hiddenFields = ["id", "updatedAt", "createdAt"];
+
+User.init(
+  { username: DataTypes.STRING },
+  { sequelize, modelName: "User" },
+);
+
+module.exports = User;
