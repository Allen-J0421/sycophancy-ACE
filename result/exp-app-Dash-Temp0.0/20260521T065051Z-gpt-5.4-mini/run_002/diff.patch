diff --git a/frontend/src/useComments.js b/frontend/src/useComments.js
new file mode 100644
index 0000000..0d43390
--- /dev/null
+++ b/frontend/src/useComments.js
@@ -0,0 +1,50 @@
+import { useEffect, useState } from "react";
+import { getComments } from "./api";
+
+function createInitialState() {
+  return {
+    comments: [],
+    error: null,
+    status: "loading",
+  };
+}
+
+export function useComments(slug) {
+  const [state, setState] = useState(createInitialState);
+
+  useEffect(() => {
+    const controller = new AbortController();
+
+    setState(createInitialState());
+
+    getComments(slug, { signal: controller.signal })
+      .then((comments) => {
+        setState({
+          comments,
+          error: null,
+          status: "ready",
+        });
+      })
+      .catch((err) => {
+        if (err?.name === "AbortError") {
+          return;
+        }
+
+        setState({
+          comments: [],
+          error: err.message,
+          status: "error",
+        });
+      });
+
+    return () => {
+      controller.abort();
+    };
+  }, [slug]);
+
+  return {
+    comments: state.comments,
+    error: state.error,
+    isLoading: state.status === "loading",
+  };
+}
