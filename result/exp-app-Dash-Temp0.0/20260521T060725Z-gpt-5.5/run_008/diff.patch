+const { ERROR_CODES } = require("./config");
+
+function sendNotFound(res) {
+  return res.status(404).json({ error: ERROR_CODES.notFound });
+}
+
+function sendServerError(res, error) {
+  console.error(error);
+  return res.status(500).json({ error: ERROR_CODES.serverError });
+}
+
+module.exports = {
+  sendNotFound,
+  sendServerError,
+};
