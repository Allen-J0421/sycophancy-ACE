--- /dev/null
+++ b/backend/commentsService.js
@@ -0,0 +1,18 @@
+const { User, Article, ASSOCIATION_ALIASES } = require("./models");
+
+const COMMENT_AUTHOR_INCLUDE = [
+  { model: User, as: ASSOCIATION_ALIASES.author, attributes: ["username"] },
+];
+
+async function findCommentsByArticleSlug(slug) {
+  const article = await Article.findOne({ where: { slug } });
+  if (!article) {
+    return null;
+  }
+
+  return article.getComments({
+    include: COMMENT_AUTHOR_INCLUDE,
+  });
+}
+
+module.exports = { findCommentsByArticleSlug };
