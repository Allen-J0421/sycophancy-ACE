diff --git a/frontend/src/useComments.js b/frontend/src/useComments.js
new file mode 100644
index 0000000..a93cbe4
--- /dev/null
+++ b/frontend/src/useComments.js
@@ -0,0 +1,37 @@
+import { useEffect, useState } from "react";
+import { getComments } from "./api";
+
+const initialCommentState = {
+  comments: [],
+  error: null,
+};
+
+function useComments(slug) {
+  const [state, setState] = useState(initialCommentState);
+
+  useEffect(() => {
+    let isActive = true;
+
+    setState(initialCommentState);
+
+    getComments(slug)
+      .then((comments) => {
+        if (isActive) {
+          setState({ comments, error: null });
+        }
+      })
+      .catch((err) => {
+        if (isActive) {
+          setState({ comments: [], error: err.message });
+        }
+      });
+
+    return () => {
+      isActive = false;
+    };
+  }, [slug]);
+
+  return state;
+}
+
+export default useComments;
