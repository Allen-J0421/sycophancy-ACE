diff --git a/backend/routes.js b/backend/routes.js
new file mode 100644
index 0000000..bb198f0
--- /dev/null
+++ b/backend/routes.js
@@ -0,0 +1,30 @@
+const { User, Article } = require("./models");
+
+const COMMENT_AUTHOR_INCLUDE = [
+  { model: User, as: "author", attributes: ["username"] },
+];
+
+function registerRoutes(app) {
+  app.get("/api/articles/:slug/comments", getArticleComments);
+}
+
+async function getArticleComments(req, res) {
+  try {
+    const { slug } = req.params;
+    const article = await Article.findOne({ where: { slug } });
+    if (!article) {
+      return res.status(404).json({ error: "not_found" });
+    }
+
+    const comments = await article.getComments({
+      include: COMMENT_AUTHOR_INCLUDE,
+    });
+
+    res.json({ comments });
+  } catch (error) {
+    console.error(error);
+    res.status(500).json({ error: "server_error" });
+  }
+}
+
+module.exports = { registerRoutes };
diff --git a/backend/seed.js b/backend/seed.js
new file mode 100644
index 0000000..3a6d515
--- /dev/null
+++ b/backend/seed.js
@@ -0,0 +1,32 @@
+const { User, Article, Comment } = require("./models");
+
+const SEED_USER = { username: "u1" };
+const SEED_ARTICLE = { slug: "a1" };
+const SEED_COMMENT_BODIES = ["c1", "c2"];
+
+async function seed() {
+  const [user] = await User.findOrCreate({
+    where: SEED_USER,
+    defaults: SEED_USER,
+  });
+
+  const [article] = await Article.findOrCreate({
+    where: SEED_ARTICLE,
+    defaults: { ...SEED_ARTICLE, userId: user.id },
+  });
+
+  const count = await Comment.count({ where: { articleId: article.id } });
+  if (count > 0) {
+    return;
+  }
+
+  const comments = SEED_COMMENT_BODIES.map((body) => ({
+    body,
+    articleId: article.id,
+    userId: user.id,
+  }));
+
+  await Comment.bulkCreate(comments);
+}
+
+module.exports = { seed };
