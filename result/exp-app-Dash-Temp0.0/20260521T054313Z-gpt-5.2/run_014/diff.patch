diff --git a/backend/test/comments.test.js b/backend/test/comments.test.js
new file mode 100644
index 0000000..0e1d93d
--- /dev/null
+++ b/backend/test/comments.test.js
@@ -0,0 +1,65 @@
+const assert = require("node:assert/strict");
+const { once } = require("node:events");
+const { after, before, describe, it } = require("node:test");
+
+const { createApp } = require("../app");
+const { sequelize, User, Article, Comment } = require("../models");
+const { seedDatabase } = require("../seed");
+
+function closeServer(server) {
+  return new Promise((resolve, reject) => {
+    server.close((error) => (error ? reject(error) : resolve()));
+  });
+}
+
+describe("comments API", () => {
+  let server;
+  let port;
+
+  before(async () => {
+    await sequelize.sync({ force: true });
+    await seedDatabase({ User, Article, Comment });
+
+    const app = createApp({ User, Article });
+    server = app.listen(0);
+    await once(server, "listening");
+    port = server.address().port;
+  });
+
+  after(async () => {
+    if (server) await closeServer(server);
+    await sequelize.close();
+  });
+
+  it("returns seeded comments", async () => {
+    const res = await fetch(
+      `http://127.0.0.1:${port}/api/articles/a1/comments`,
+    );
+    assert.equal(res.status, 200);
+    const data = await res.json();
+
+    assert.ok(Array.isArray(data.comments));
+    assert.equal(data.comments.length, 2);
+
+    const bodies = new Set(data.comments.map((c) => c.body));
+    assert.ok(bodies.has("c1"));
+    assert.ok(bodies.has("c2"));
+
+    for (const comment of data.comments) {
+      assert.equal(typeof comment.body, "string");
+      assert.equal(typeof comment.createdAt, "string");
+      assert.ok(comment.author);
+      assert.equal(typeof comment.author.username, "string");
+    }
+  });
+
+  it("returns 404 for unknown slug", async () => {
+    const res = await fetch(
+      `http://127.0.0.1:${port}/api/articles/does-not-exist/comments`,
+    );
+    assert.equal(res.status, 404);
+    const data = await res.json();
+    assert.deepEqual(data, { error: "not_found" });
+  });
+});
+
