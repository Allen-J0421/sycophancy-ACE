+++ b/bubble_sort/core.py
@@ -0,0 +1,22 @@
+from collections.abc import MutableSequence
+from typing import Any
+
+
+def bubble_sort(values: MutableSequence[Any]) -> None:
+    """Sort values in ascending order in place using bubble sort."""
+    for sorted_count in range(len(values)):
+        swapped = False
+        unsorted_limit = len(values) - sorted_count - 1
+
+        for index in range(unsorted_limit):
+            if values[index] > values[index + 1]:
+                values[index], values[index + 1] = values[index + 1], values[index]
+                swapped = True
+
+        if not swapped:
+            break
+
+
+def bubbleSort(values: MutableSequence[Any]) -> None:
+    """Compatibility wrapper for callers using the original camelCase name."""
+    bubble_sort(values)
