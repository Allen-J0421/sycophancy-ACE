new file mode 100644
index 0000000..f123d05
--- /dev/null
+++ b/bubble_sort/__main__.py
@@ -0,0 +1,36 @@
+import argparse
+from typing import Any
+
+from . import bubble_sort
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Sort values using bubble sort (educational).")
+    parser.add_argument("items", nargs="*", help="Values to sort.")
+    parser.add_argument(
+        "--type",
+        choices=("int", "float", "str"),
+        default="int",
+        help="How to parse positional items.",
+    )
+    parser.add_argument("--reverse", action="store_true", help="Sort in descending order.")
+
+    args = parser.parse_args(argv)
+
+    if not args.items:
+        values: list[Any] = [64, 34, 25, 12, 22, 11, 90]
+    elif args.type == "int":
+        values = [int(item) for item in args.items]
+    elif args.type == "float":
+        values = [float(item) for item in args.items]
+    else:
+        values = list(args.items)
+
+    bubble_sort(values, reverse=args.reverse)
+    print(values)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
