+"""Bubble sort implementations (educational)."""
+
+from collections.abc import Callable, Iterable, MutableSequence
+from operator import gt, lt
+from typing import Any, TypeVar
+
+__all__ = ["bubble_sort", "bubble_sorted"]
+
+T = TypeVar("T")
+
+
+def bubble_sort(items: MutableSequence[T], *, key: Callable[[T], Any] | None = None, reverse: bool = False) -> None:
+    """Sort `items` in-place using bubble sort.
+
+    Notes:
+    - Time complexity: O(n^2) worst-case, O(n) best-case (already sorted).
+    - Space complexity: O(1) additional space without `key`, O(n) with `key` (keys are cached).
+    """
+
+    n = len(items)
+    if n < 2:
+        return
+
+    should_swap = lt if reverse else gt
+
+    if key is None:
+        for end in range(n - 1, 0, -1):
+            swapped = False
+
+            for i in range(end):
+                left = items[i]
+                right = items[i + 1]
+
+                if should_swap(left, right):
+                    items[i], items[i + 1] = right, left
+                    swapped = True
+
+            if not swapped:
+                return
+
+        return
+
+    keys = [key(item) for item in items]
+    for end in range(n - 1, 0, -1):
+        swapped = False
+
+        for i in range(end):
+            left_key = keys[i]
+            right_key = keys[i + 1]
+
+            if should_swap(left_key, right_key):
+                items[i], items[i + 1] = items[i + 1], items[i]
+                keys[i], keys[i + 1] = right_key, left_key
+                swapped = True
+
+        if not swapped:
+            return
+
+
+def bubble_sorted(iterable: Iterable[T], *, key: Callable[[T], Any] | None = None, reverse: bool = False) -> list[T]:
+    """Return a new list containing the items from `iterable`, sorted via bubble sort."""
+
+    items = list(iterable)
+    bubble_sort(items, key=key, reverse=reverse)
+    return items
+
