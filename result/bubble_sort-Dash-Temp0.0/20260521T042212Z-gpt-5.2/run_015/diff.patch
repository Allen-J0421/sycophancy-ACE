+++ b/bubble_sort/cli.py
@@ -0,0 +1,39 @@
+import argparse
+from typing import Any
+
+from . import bubble_sort
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Sort values using bubble sort (educational).")
+    parser.add_argument("items", nargs="*", help="Values to sort.")
+    parser.add_argument(
+        "--type",
+        choices=("int", "float", "str"),
+        default="int",
+        help="How to parse positional items.",
+    )
+    parser.add_argument("--reverse", action="store_true", help="Sort in descending order.")
+
+    args = parser.parse_args(argv)
+
+    if not args.items:
+        values: list[Any] = [64, 34, 25, 12, 22, 11, 90]
+    else:
+        if args.type == "str":
+            values = list(args.items)
+        else:
+            parse = int if args.type == "int" else float
+            try:
+                values = [parse(item) for item in args.items]
+            except ValueError as exc:
+                parser.error(f"Failed to parse {args.type}: {exc}")
+
+    bubble_sort(values, reverse=args.reverse)
+    print(values)
+    return 0
+
+
+def cli() -> None:
+    raise SystemExit(main())
+
