+++ b/tests/test_bubble_sort.py
@@ -0,0 +1,27 @@
+from bubble_sort import bubble_sort, bubble_sorted
+
+
+def test_bubble_sort_in_place() -> None:
+    values = [3, 1, 2]
+    bubble_sort(values)
+    assert values == [1, 2, 3]
+
+
+def test_bubble_sort_reverse_in_place() -> None:
+    values = [3, 1, 2]
+    bubble_sort(values, reverse=True)
+    assert values == [3, 2, 1]
+
+
+def test_bubble_sort_key() -> None:
+    values = ["a", "bbb", "cc"]
+    bubble_sort(values, key=len)
+    assert values == ["a", "cc", "bbb"]
+
+
+def test_bubble_sorted_does_not_mutate() -> None:
+    values = [3, 1, 2]
+    out = bubble_sorted(values)
+    assert out == [1, 2, 3]
+    assert values == [3, 1, 2]
+
