@@ -0,0 +1,12 @@
+import os
+import sys
+
+
+def pytest_configure() -> None:
+    # `python -m pytest` includes the working directory on sys.path, but invoking the
+    # `pytest` entrypoint script may not. Ensure the project root is importable so
+    # `import bubble_sort` works consistently.
+    project_root = os.path.dirname(__file__)
+    if project_root not in sys.path:
+        sys.path.insert(0, project_root)
+
