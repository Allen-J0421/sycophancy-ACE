diff --git a/BubbleSortTest.java b/BubbleSortTest.java
new file mode 100644
index 0000000..8a38c67
--- /dev/null
+++ b/BubbleSortTest.java
@@ -0,0 +1,65 @@
+import java.util.Arrays;
+
+final class BubbleSortTest {
+    private BubbleSortTest() {
+    }
+
+    public static void main(String[] args) {
+        sortsUnorderedValues();
+        leavesSortedValuesUnchanged();
+        handlesDuplicateValues();
+        handlesEmptyArrays();
+        formatsArraysWithOriginalSpacing();
+
+        System.out.println("All tests passed.");
+    }
+
+    private static void sortsUnorderedValues() {
+        int[] numbers = {64, 34, 25, 12, 22, 11, 90};
+
+        BubbleSort.sort(numbers);
+
+        assertArrayEquals(new int[] {11, 12, 22, 25, 34, 64, 90}, numbers);
+    }
+
+    private static void leavesSortedValuesUnchanged() {
+        int[] numbers = {1, 2, 3, 4};
+
+        BubbleSort.sort(numbers);
+
+        assertArrayEquals(new int[] {1, 2, 3, 4}, numbers);
+    }
+
+    private static void handlesDuplicateValues() {
+        int[] numbers = {5, 1, 5, 3, 1};
+
+        BubbleSort.sort(numbers);
+
+        assertArrayEquals(new int[] {1, 1, 3, 5, 5}, numbers);
+    }
+
+    private static void handlesEmptyArrays() {
+        int[] numbers = {};
+
+        BubbleSort.sort(numbers);
+
+        assertArrayEquals(new int[] {}, numbers);
+    }
+
+    private static void formatsArraysWithOriginalSpacing() {
+        assertEquals("3 4 5 ", IntArrayFormatter.format(new int[] {3, 4, 5}));
+    }
+
+    private static void assertArrayEquals(int[] expected, int[] actual) {
+        if (!Arrays.equals(expected, actual)) {
+            throw new AssertionError(
+                    "Expected " + Arrays.toString(expected) + " but got " + Arrays.toString(actual));
+        }
+    }
+
+    private static void assertEquals(String expected, String actual) {
+        if (!expected.equals(actual)) {
+            throw new AssertionError("Expected \"" + expected + "\" but got \"" + actual + "\"");
+        }
+    }
+}
