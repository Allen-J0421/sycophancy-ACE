diff --git a/Makefile b/Makefile
index 59f1b85..f877fce 100644
--- a/Makefile
+++ b/Makefile
@@ -1,20 +1,22 @@
 JAVAC = javac
 JAVA = java
+BUILD_DIR = out/classes
 SOURCES = $(wildcard *.java)
 
 .PHONY: compile test run run-legacy clean
 
 compile:
