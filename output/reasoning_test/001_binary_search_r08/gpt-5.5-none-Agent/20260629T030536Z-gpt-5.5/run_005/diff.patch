+
+        private SearchBounds(int left, int right) {
+            this.left = left;
+            this.right = right;
+        }
+
+        private static SearchBounds forArray(int[] sortedNumbers) {
+            return new SearchBounds(0, sortedNumbers.length - 1);
+        }
+
