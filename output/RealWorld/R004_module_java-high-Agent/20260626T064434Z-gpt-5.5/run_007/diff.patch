diff --git a/PredatorTrackingMovementStrategy.java b/PredatorTrackingMovementStrategy.java
new file mode 100644
index 0000000..3c1063b
--- /dev/null
+++ b/PredatorTrackingMovementStrategy.java
@@ -0,0 +1,15 @@
+/**
+ * Movement strategy that first seeks food, then falls back to a free adjacent location.
+ */
+public class PredatorTrackingMovementStrategy extends AbstractMovementStrategy
+{
+    @Override
+    public void move(Animal animal, Environment environment)
+    {
+        Location newLocation = animal.findFood(environment);
+        if(newLocation == null) {
+            newLocation = animal.getField().freeAdjacentLocation(animal.getLocation());
+        }
+        moveOrHandleBlocked(animal, newLocation);
+    }
+}
diff --git a/RandomWalkMovementStrategy.java b/RandomWalkMovementStrategy.java
new file mode 100644
index 0000000..99e70b1
--- /dev/null
+++ b/RandomWalkMovementStrategy.java
@@ -0,0 +1,11 @@
+/**
+ * Movement strategy that ignores food tracking and moves to a free adjacent location.
+ */
+public class RandomWalkMovementStrategy extends AbstractMovementStrategy
+{
+    @Override
+    public void move(Animal animal, Environment environment)
+    {
+        moveOrHandleBlocked(animal, animal.getField().freeAdjacentLocation(animal.getLocation()));
+    }
+}
