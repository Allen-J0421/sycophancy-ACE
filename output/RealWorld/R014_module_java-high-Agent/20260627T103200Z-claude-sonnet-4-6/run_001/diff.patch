@@ -0,0 +1,118 @@
+package sim.actors;
+
+import sim.Location;
+import sim.weather.WeatherAction;
+import sim.weather.WeatherEffectTypes;
+
+import java.util.EnumMap;
+import java.util.List;
+
+/**
+ * A simple model of a plant.
+ * Plants age, breed into adjacent locations, and die.
+ *
+ * @version (28/02/2022)
+ */
+public class Plant extends Actor
+{
+    private static final int BREEDING_AGE = 0;
+    private static final int MAX_AGE = 2;
+    private static final double BREEDING_PROBABILITY = 0.9;
+    private static final int MAX_LITTER_SIZE = 2;
+    private static final int PLANT_FOOD_VALUE = 7;
+
+    private EnumMap<WeatherEffectTypes, Double> weatherEffect = new EnumMap<>(WeatherEffectTypes.class);
+    private int age;
+
+    /**
+     * @param randomAge If true, the plant starts with a random age.
+     * @param field     The field currently occupied.
+     * @param location  The location within the field.
+     */
+    public Plant(boolean randomAge, Field field, Location location)
+    {
+        super(field, location);
+        setOverlap(true);
+        age = randomAge ? rand.nextInt(MAX_AGE) : 0;
+    }
+
+    /**
+     * During the day plants age and breed at full rate.
+     */
+    @Override
+    public void dayAct(List<Actor> newPlants)
+    {
+        incrementAge();
+        if (isAlive()) {
+            giveBirth(newPlants);
+        }
+    }
+
+    /**
+     * During the night plants breed at a sharply reduced rate.
+     */
+    @Override
+    public void nightAct(List<Actor> newPlants)
+    {
+        if (isAlive()) {
+            giveBirth(newPlants);
+        }
+    }
+
+    private void incrementAge()
+    {
+        age++;
+        if (age > MAX_AGE) {
+            setDead();
+        }
+    }
+
+    @Override
+    protected void setWeatherEffects()
+    {
+        weatherEffect = WeatherAction.weatherOnPlants(weather);
+    }
+
+    private void giveBirth(List<Actor> newPlants)
+    {
+        Field field = getField();
+        List<Location> free = field.getFreeAdjacentLocations(getLocation());
+        int births = breed();
+        for (int b = 0; b < births && !free.isEmpty(); b++) {
+            Location candidate = free.get(0);
+            Object occupant = field.getObjectAt(candidate);
+            if (occupant != null && this.getClass().equals(occupant.getClass())) {
+                free.remove(0);
+                continue;
+            }
+            Location loc = free.remove(0);
+            newPlants.add(new Plant(false, field, loc));
+        }
+    }
+
+    private int breed()
+    {
+        int births = 0;
+        if (canBreed() && rand.nextDouble() <= BREEDING_PROBABILITY * effectBreedingProbability()) {
+            births = rand.nextInt(MAX_LITTER_SIZE) + 1;
+        }
+        return births;
+    }
+
+    private double effectBreedingProbability()
+    {
+        double dayEffect = getDay() ? 1.0 : 0.01;
+        return dayEffect * weatherEffect.get(WeatherEffectTypes.BREED);
+    }
+
+    private boolean canBreed()
+    {
+        return age >= BREEDING_AGE;
+    }
+
+    @Override
+    public double getFoodValue()
+    {
+        return age * PLANT_FOOD_VALUE;
+    }
+}
