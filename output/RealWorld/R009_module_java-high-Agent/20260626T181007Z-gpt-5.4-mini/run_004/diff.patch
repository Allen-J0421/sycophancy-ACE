diff --git a/src/main/java/safari/SpawnRule.java b/src/main/java/safari/SpawnRule.java
new file mode 100644
index 0000000..f0bd3f9
--- /dev/null
+++ b/src/main/java/safari/SpawnRule.java
@@ -0,0 +1,18 @@
+package safari;
+
+import java.util.function.BiFunction;
+
+/**
+ * A single registry entry for population seeding.
+ */
+record SpawnRule(
+    String name,
+    double probability,
+    BiFunction<Field, Location, Actor> constructor
+)
+{
+    Actor create(Field field, Location location)
+    {
+        return constructor.apply(field, location);
+    }
+}
