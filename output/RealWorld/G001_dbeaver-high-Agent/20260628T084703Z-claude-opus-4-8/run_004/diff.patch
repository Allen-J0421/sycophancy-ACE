+    /**
+     * Combines the five JDBC "supports ... in X" capability flags (data manipulation, table
+     * definitions, procedure calls, index definitions, privilege definitions) into a single
+     * {@link SQLDialect} USAGE_* bitmask. Used identically for catalog and schema usage.
+     */
+    private static int makeUsageFlags(
+        boolean dataManipulation,
+        boolean tableDefinitions,
+        boolean procedureCalls,
+        boolean indexDefinitions,
+        boolean privilegeDefinitions
+    ) {
+        return (dataManipulation ? SQLDialect.USAGE_DML : 0)
+            | (tableDefinitions ? SQLDialect.USAGE_DDL : 0)
+            | (procedureCalls ? SQLDialect.USAGE_PROC : 0)
+            | (indexDefinitions ? SQLDialect.USAGE_INDEX : 0)
+            | (privilegeDefinitions ? SQLDialect.USAGE_PRIV : 0);
+    }
