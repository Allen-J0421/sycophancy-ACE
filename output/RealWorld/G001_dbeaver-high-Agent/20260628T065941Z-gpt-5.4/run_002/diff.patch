+package org.jkiss.dbeaver.model.sql;
+
+import org.jkiss.junit.DBeaverUnitTest;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+public class SQLCompletionModeTest extends DBeaverUnitTest {
+
+    @Test
+    public void combinedModeShouldEnableBothAnalyzers() {
+        Assertions.assertTrue(SQLCompletionMode.COMBINED.usesLegacyAnalyzer());
+        Assertions.assertTrue(SQLCompletionMode.COMBINED.usesSemanticAnalyzer());
+    }
+
+    @Test
+    public void defaultModeShouldFallbackForUnknownPreferenceValue() {
+        Assertions.assertEquals(SQLCompletionMode.DEFAULT, SQLCompletionMode.valueByName("unknown"));
+    }
+}
