+import org.jkiss.dbeaver.model.sql.SQLSyntaxManager;
+import org.jkiss.dbeaver.model.sql.parser.SQLRuleManager;
+
+public class SQLCompletionTestContext extends AbstractSQLCompletionContext {
+    private final boolean showValues;
+
+    public SQLCompletionTestContext(
+        @Nullable DBPDataSource dataSource,
+        @Nullable DBCExecutionContext executionContext,
+        @NotNull SQLSyntaxManager syntaxManager,
+        @NotNull SQLRuleManager ruleManager,
+        @NotNull DBPPreferenceStore preferenceStore
+    ) {
+        this(dataSource, executionContext, syntaxManager, ruleManager, preferenceStore, false);
+    }
+
+    public SQLCompletionTestContext(
+        @Nullable DBPDataSource dataSource,
+        @Nullable DBCExecutionContext executionContext,
+        @NotNull SQLSyntaxManager syntaxManager,
+        @NotNull SQLRuleManager ruleManager,
+        @NotNull DBPPreferenceStore preferenceStore,
+        boolean showValues
+    ) {
+        super(dataSource, executionContext, syntaxManager, ruleManager, preferenceStore);
+        this.showValues = showValues;
+    }
+
+    @Override
+    public boolean isShowValues() {
+        return showValues;
+    }
+}
