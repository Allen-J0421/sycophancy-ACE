+  /**
+   * Delivers an exception thrown by a user-supplied {@link Callback} to the current thread's {@link
+   * Thread.UncaughtExceptionHandler}. The callback has already been invoked, so there is no caller
+   * to propagate the failure to; routing it through the uncaught handler lets applications observe
+   * it (for example via a logging framework or crash reporter) while still defaulting to printing
+   * the stack trace to {@code System.err} when no handler is installed.
+   */
+  private static void deliverCallbackException(Throwable t) {
+    Thread thread = Thread.currentThread();
+    thread.getUncaughtExceptionHandler().uncaughtException(thread, t);
+  }
