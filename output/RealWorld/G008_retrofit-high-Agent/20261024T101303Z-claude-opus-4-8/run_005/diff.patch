+  /**
+   * Returns a mock {@link Call} that applies the configured network delay and counts down {@code
+   * taskStarted} the moment the background task begins running (immediately before it enters the
+   * delay). This lets a test deterministically wait until the call is in-flight before canceling
+   * it, rather than guessing with a fixed {@link Thread#sleep}.
+   *
+   * <p>Callers must force the "response" branch of {@link NetworkBehavior} (zero failure and error
+   * percentages) so that the delegate is actually enqueued and the signal fires.
+   */
+  private Call<String> delayedResponseSignaling(CountDownLatch taskStarted) {
+    Call<String> response =
+        Calls.defer(
+            () -> {
+              taskStarted.countDown();
+              return Calls.response("Response!");
+            });
+    return delegate.returning(response).response();
+  }
+
