+  private static IllegalArgumentException missingFactoryException(
+      String description, Type type, List<?> factories, int start, boolean showSkipped) {
+    StringBuilder builder =
+        new StringBuilder("Could not locate ").append(description).append(" for ").append(type).append(".\n");
+    if (showSkipped) {
+      builder.append("  Skipped:");
+      for (int i = 0; i < start; i++) {
+        builder.append("\n   * ").append(factories.get(i).getClass().getName());
+      }
+      builder.append('\n');
+    }
+    builder.append("  Tried:");
+    for (int i = start, count = factories.size(); i < count; i++) {
+      builder.append("\n   * ").append(factories.get(i).getClass().getName());
+    }
+    return new IllegalArgumentException(builder.toString());
+  }
