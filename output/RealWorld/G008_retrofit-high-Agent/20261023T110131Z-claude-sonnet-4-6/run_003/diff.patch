+  private static <T> void applyStringMap(
+      Method method,
+      int p,
+      @Nullable Map<String, T> map,
+      String mapName,
+      Converter<T, String> converter,
+      BiConsumer<String, String> action) throws IOException {
+    if (map == null) {
+      throw Utils.parameterError(method, p, "%s map was null.", mapName);
+    }
+    for (Map.Entry<String, T> entry : map.entrySet()) {
+      String key = entry.getKey();
+      if (key == null) {
+        throw Utils.parameterError(method, p, "%s map contained null key.", mapName);
+      }
+      T value = entry.getValue();
+      if (value == null) {
+        throw Utils.parameterError(
+            method, p, "%s map contained null value for key '%s'.", mapName, key);
+      }
+      String converted = converter.convert(value);
+      if (converted == null) {
+        throw Utils.parameterError(
+            method,
+            p,
+            "%s map value '%s' converted to null by %s for key '%s'.",
+            mapName,
+            value,
+            converter.getClass().getName(),
+            key);
+      }
+      action.accept(key, converted);
+    }
+  }
