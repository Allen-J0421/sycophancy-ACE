+    private ParameterHandler<?> parseStringHandler(
+        int p,
+        Type type,
+        Annotation[] annotations,
+        Function<Converter<?, String>, ParameterHandler<?>> factory) {
+      Class<?> rawParameterType = Utils.getRawType(type);
+      if (Iterable.class.isAssignableFrom(rawParameterType)) {
+        if (!(type instanceof ParameterizedType)) {
+          throw parameterError(
+              method,
+              p,
+              rawParameterType.getSimpleName()
+                  + " must include generic type (e.g., "
+                  + rawParameterType.getSimpleName()
+                  + "<String>)");
+        }
+        Type iterableType = Utils.getParameterUpperBound(0, (ParameterizedType) type);
+        return factory.apply(retrofit.stringConverter(iterableType, annotations)).iterable();
+      } else if (rawParameterType.isArray()) {
+        Class<?> arrayComponentType = boxIfPrimitive(rawParameterType.getComponentType());
+        return factory.apply(retrofit.stringConverter(arrayComponentType, annotations)).array();
+      } else {
+        return factory.apply(retrofit.stringConverter(type, annotations));
+      }
+    }
