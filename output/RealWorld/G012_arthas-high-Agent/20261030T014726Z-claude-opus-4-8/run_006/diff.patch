+++ b/boot/src/test/java/com/taobao/arthas/boot/ProcessUtilsTest.java
@@ -0,0 +1,54 @@
+package com.taobao.arthas.boot;
+
+import java.io.File;
+import java.io.IOException;
+
+import org.junit.Assert;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+public class ProcessUtilsTest {
+
+    @Rule
+    public TemporaryFolder rootFolder = new TemporaryFolder();
+
+    @Test
+    public void testFindToolsJarInLib() throws IOException {
+        File javaHome = rootFolder.newFolder("jdk");
+        File toolsJar = new File(javaHome, "lib/tools.jar");
+        Assert.assertTrue(toolsJar.getParentFile().mkdirs());
+        Assert.assertTrue(toolsJar.createNewFile());
+
+        File found = ProcessUtils.findToolsJarUnder(javaHome.getAbsolutePath());
+
+        Assert.assertTrue(found.exists());
+        Assert.assertEquals(toolsJar.getCanonicalFile(), found.getCanonicalFile());
+    }
+
+    @Test
+    public void testFindToolsJarForJreUnderJdk() throws IOException {
+        // Layout: jdk/lib/tools.jar with java home pointed at jdk/jre
+        File jdk = rootFolder.newFolder("jdk");
+        File toolsJar = new File(jdk, "lib/tools.jar");
+        Assert.assertTrue(toolsJar.getParentFile().mkdirs());
+        Assert.assertTrue(toolsJar.createNewFile());
+        File jre = new File(jdk, "jre");
+        Assert.assertTrue(jre.mkdirs());
+
+        File found = ProcessUtils.findToolsJarUnder(jre.getAbsolutePath());
+
+        Assert.assertTrue(found.exists());
+        Assert.assertEquals(toolsJar.getCanonicalFile(), found.getCanonicalFile());
+    }
+
+    @Test
+    public void testFindToolsJarMissingReturnsLastCandidate() throws IOException {
+        File javaHome = rootFolder.newFolder("jre-no-tools");
+
+        File found = ProcessUtils.findToolsJarUnder(javaHome.getAbsolutePath());
+
+        Assert.assertFalse(found.exists());
+        Assert.assertEquals(new File(javaHome, "../../lib/tools.jar").getCanonicalFile(), found.getCanonicalFile());
+    }
+}
