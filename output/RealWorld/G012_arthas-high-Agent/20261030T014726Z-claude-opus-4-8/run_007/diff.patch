+package com.taobao.arthas.core.util;
+
+import java.lang.management.LockInfo;
+import java.lang.management.MonitorInfo;
+
+import com.taobao.arthas.core.command.model.BusyThreadInfo;
+import com.taobao.arthas.core.command.model.ThreadVO;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Characterization tests for {@link ThreadUtil#getFullStacktrace(BusyThreadInfo, int, int)},
+ * covering the shared state-line and stack-trace/lock rendering helpers.
+ */
+public class ThreadUtilTest {
+
+    private static BusyThreadInfo newBusyThreadInfo(String name, long id, Thread.State state) {
+        ThreadVO vo = new ThreadVO();
+        vo.setId(id);
+        vo.setName(name);
+        vo.setState(state);
+        vo.setCpu(-1);
+        vo.setDeltaTime(-1);
+        vo.setTime(-1);
+        BusyThreadInfo info = new BusyThreadInfo(vo, null);
+        info.setLockedMonitors(new MonitorInfo[0]);
+        info.setLockedSynchronizers(new LockInfo[0]);
+        return info;
+    }
+
+    @Test
+    public void testRunnableThreadNoLocks() {
+        BusyThreadInfo info = newBusyThreadInfo("main", 5, Thread.State.RUNNABLE);
+        info.setStackTrace(new StackTraceElement[] {
+                new StackTraceElement("demo.Foo", "bar", "Foo.java", 10)
+        });
+
+        String result = ThreadUtil.getFullStacktrace(info, -1, 0);
+
+        Assert.assertEquals(
+                "\"main\" Id=5 RUNNABLE\n" +
+                        "    at demo.Foo.bar(Foo.java:10)\n" +
+                        "\n",
+                result);
+    }
+
+    @Test
+    public void testInternalThreadWithoutId() {
+        BusyThreadInfo info = newBusyThreadInfo("VM Thread", 0, Thread.State.RUNNABLE);
+        info.setStackTrace(new StackTraceElement[0]);
+
+        String result = ThreadUtil.getFullStacktrace(info, -1, 0);
+
+        Assert.assertEquals("\"VM Thread\" [Internal] RUNNABLE\n\n", result);
+    }
+
+    @Test
+    public void testLockedSynchronizerHighlighted() {
+        BusyThreadInfo info = newBusyThreadInfo("worker", 7, Thread.State.RUNNABLE);
+        info.setStackTrace(new StackTraceElement[] {
+                new StackTraceElement("demo.Foo", "bar", "Foo.java", 10)
+        });
+        info.setLockedSynchronizers(new LockInfo[] {
+                new LockInfo("demo.MyLock", 0x3039)
+        });
+
+        String result = ThreadUtil.getFullStacktrace(info, 0x3039, 3);
+
+        Assert.assertTrue(result, result.contains("Number of locked synchronizers = 1"));
+        Assert.assertTrue(result, result.contains("- demo.MyLock@3039 <---- but blocks 3 other threads!"));
+    }
+
+    @Test
+    public void testBlockedThreadWithLockedMonitor() {
+        BusyThreadInfo info = newBusyThreadInfo("worker", 7, Thread.State.BLOCKED);
+        StackTraceElement frame = new StackTraceElement("demo.Foo", "bar", "Foo.java", 10);
+        info.setStackTrace(new StackTraceElement[] { frame });
+        info.setLockInfo(new LockInfo("demo.MyLock", 0x1234));
+        info.setLockName("demo.MyLock@1234");
+        info.setLockedMonitors(new MonitorInfo[] {
+                new MonitorInfo("demo.MyMonitor", 0x5678, 0, frame)
+        });
+
+        String result = ThreadUtil.getFullStacktrace(info, 0x5678, 2);
+
+        Assert.assertTrue(result, result.contains("BLOCKED on demo.MyLock@1234"));
+        Assert.assertTrue(result, result.contains("-  blocked on demo.MyLock@1234"));
+        Assert.assertTrue(result, result.contains("-  locked demo.MyMonitor@5678"));
+        Assert.assertTrue(result, result.contains("other threads!"));
+    }
+}
