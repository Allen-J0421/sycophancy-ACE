+package com.taobao.arthas.core.shell.term.impl.http;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.text.SimpleDateFormat;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.stream.Stream;
+
+import org.junit.After;
+import org.junit.Assert;
+import org.junit.Before;
+import org.junit.Test;
+
+/**
+ * Characterization test for {@link DirectoryBrowser#renderDir(File, boolean)} output rows.
+ */
+public class DirectoryBrowserTest {
+
+    private Path tempDir;
+
+    @Before
+    public void setUp() throws IOException {
+        tempDir = Files.createTempDirectory("arthas-dir-browser-test");
+    }
+
+    @After
+    public void tearDown() throws IOException {
+        if (tempDir != null && Files.exists(tempDir)) {
+            try (Stream<Path> paths = Files.walk(tempDir)) {
+                paths.sorted(Comparator.reverseOrder()).map(Path::toFile).forEach(File::delete);
+            }
+        }
+    }
+
+    @Test
+    public void testRenderDirRowsForDirectoryAndFile() throws IOException {
+        File subDir = new File(tempDir.toFile(), "subdir");
+        Assert.assertTrue(subDir.mkdir());
+
+        File file = new File(tempDir.toFile(), "file.txt");
+        Files.write(file.toPath(), "hello".getBytes(StandardCharsets.UTF_8));
+
+        long fixedTime = 1531204354000L;
+        Assert.assertTrue(subDir.setLastModified(fixedTime));
+        Assert.assertTrue(file.setLastModified(fixedTime));
+
+        String rendered = DirectoryBrowser.renderDir(tempDir.toFile(), false);
+
+        String date = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new Date(fixedTime));
+
+        String expectedDirRow = String.format("<a href=\"%s\" title=\"%s\">", "subdir/", "subdir/")
+                + String.format("%-60s", "subdir/</a>")
+                + date
+                + "         -      \r\n";
+
+        String expectedFileRow = String.format("<a href=\"%s\" title=\"%s\">", "file.txt", "file.txt")
+                + String.format("%-60s", "file.txt</a>")
+                + date
+                + String.format("%10d      ", file.length())
+                + "\r\n";
+
+        Assert.assertTrue("directory row missing: \n" + rendered, rendered.contains(expectedDirRow));
+        Assert.assertTrue("file row missing: \n" + rendered, rendered.contains(expectedFileRow));
+        // directories are listed before files
+        Assert.assertTrue(rendered.indexOf(expectedDirRow) < rendered.indexOf(expectedFileRow));
+    }
+}
