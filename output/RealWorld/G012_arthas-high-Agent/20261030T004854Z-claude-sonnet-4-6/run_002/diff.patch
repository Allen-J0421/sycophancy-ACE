+                        logger.info("profiler output file: " + model.getOutputFile());
+                        logger.info("stop profiler successfully.");
+                    } catch (Throwable e) {
+                        logger.error("stop profiler failure", e);
+                    }
+                }
+            }, this.duration, TimeUnit.SECONDS);
+            process.appendResult(profilerModel);
+        }
+    }
