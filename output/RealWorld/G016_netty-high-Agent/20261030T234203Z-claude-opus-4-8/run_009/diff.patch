 package io.netty.handler.codec.socks;
 
+import io.netty.util.NetUtil;
 import io.netty.util.internal.StringUtil;
 
+import java.net.IDN;
+
 final class SocksCommonUtils {
     public static final SocksRequest UNKNOWN_SOCKS_REQUEST = new UnknownSocksRequest();
     public static final SocksResponse UNKNOWN_SOCKS_RESPONSE = new UnknownSocksResponse();
@@ -28,6 +31,38 @@ final class SocksCommonUtils {
         // NOOP
     }
 
+    /**
+     * Validates the given {@code host} against the {@link SocksAddressType}, converting a {@code DOMAIN} host to its
+     * ASCII form via {@link IDN#toASCII(String)}.
+     *
+     * @return the (possibly ASCII-converted) host
+     * @throws IllegalArgumentException if the host is not valid for the address type
+     */
+    static String validateAddress(SocksAddressType addressType, String host) {
+        switch (addressType) {
+            case IPv4:
+                if (!NetUtil.isValidIpV4Address(host)) {
+                    throw new IllegalArgumentException(host + " is not a valid IPv4 address");
+                }
+                break;
+            case DOMAIN:
+                String asciiHost = IDN.toASCII(host);
+                if (asciiHost.length() > 255) {
+                    throw new IllegalArgumentException(host + " IDN: " + asciiHost + " exceeds 255 char limit");
+                }
+                host = asciiHost;
+                break;
+            case IPv6:
+                if (!NetUtil.isValidIpV6Address(host)) {
+                    throw new IllegalArgumentException(host + " is not a valid IPv6 address");
+                }
+                break;
+            case UNKNOWN:
+                break;
+        }
+        return host;
+    }
