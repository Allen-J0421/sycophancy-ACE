@@ -0,0 +1,76 @@
+import { beforeEach, expect, it, vi } from "vite-plus/test";
+
+const hasPermission = vi.hoisted(() => vi.fn());
+vi.mock("@halo-dev/ui-shared", () => ({
+  utils: { permission: { has: hasPermission } },
+}));
+
+import { useContentEditorUpload } from "../use-content-editor-upload";
+
+beforeEach(() => {
+  hasPermission.mockReset();
+});
+
+it("gates upload and match on permission", async () => {
+  hasPermission.mockReturnValue(false);
+  const uploadAttachment = vi.fn();
+  const matchAttachmentPermalinks = vi.fn();
+  const { canManageAttachments, handleUpload, handleMatchAttachmentPermalinks } =
+    useContentEditorUpload({
+      permissions: ["x:attachments:manage"],
+      uploadAttachment,
+      matchAttachmentPermalinks,
+    });
+
+  expect(canManageAttachments.value).toBe(false);
+  expect(await handleUpload(new File([], "a.png"))).toBeUndefined();
+  expect(uploadAttachment).not.toHaveBeenCalled();
+  expect(await handleMatchAttachmentPermalinks(["u"])).toEqual([]);
+  expect(matchAttachmentPermalinks).not.toHaveBeenCalled();
+});
+
+it("uploads files and urls when permitted", async () => {
+  hasPermission.mockReturnValue(true);
+  const attachment = { metadata: { name: "att" } };
+  const uploadAttachment = vi.fn().mockResolvedValue({ data: attachment });
+  const { handleUpload, handleUploadImage } = useContentEditorUpload({
+    permissions: ["x"],
+    uploadAttachment,
+    matchAttachmentPermalinks: vi.fn(),
+  });
+
+  const file = new File([], "a.png");
+  expect(await handleUpload(file)).toBe(attachment);
+  expect(uploadAttachment).toHaveBeenCalledWith({ file }, undefined);
+
+  await handleUpload("https://example.com/x.png");
+  expect(uploadAttachment).toHaveBeenCalledWith(
+    { url: "https://example.com/x.png" },
+    undefined
+  );
+
+  await handleUploadImage(file);
+  expect(uploadAttachment).toHaveBeenCalledTimes(3);
+});
+
+it("maps permalink match results and normalizes nullish fields", async () => {
+  hasPermission.mockReturnValue(true);
+  const matchAttachmentPermalinks = vi.fn().mockResolvedValue({
+    data: {
+      items: [
+        { url: "a", matched: true },
+        { url: undefined, matched: undefined },
+      ],
+    },
+  });
+  const { handleMatchAttachmentPermalinks } = useContentEditorUpload({
+    permissions: ["x"],
+    uploadAttachment: vi.fn(),
+    matchAttachmentPermalinks,
+  });
+
+  expect(await handleMatchAttachmentPermalinks(["a", "b"])).toEqual([
+    { url: "a", matched: true },
+    { url: "", matched: false },
+  ]);
+});
diff --git a/ui/console-src/composables/__tests__/use-editor-provider-selection.spec.ts b/ui/console-src/composables/__tests__/use-editor-provider-selection.spec.ts
