@@ -0,0 +1,56 @@
+import type { EditorProvider } from "@halo-dev/ui-shared";
+import { expect, it } from "vite-plus/test";
+import {
+  resolveEditorProvider,
+  useEditorProviderSelection,
+} from "../use-editor-provider-selection";
+
+function provider(name: string, rawType: string): EditorProvider {
+  return { name, rawType } as unknown as EditorProvider;
+}
+
+const providers = [provider("default", "HTML"), provider("markdown", "markdown")];
+
+it("prefers the provider matching the preferred name", () => {
+  expect(
+    resolveEditorProvider(providers, {
+      preferredName: "markdown",
+      rawType: "HTML",
+    })?.name
+  ).toBe("markdown");
+});
+
+it("falls back to a case-insensitive raw-type match when no preferred name", () => {
+  expect(
+    resolveEditorProvider(providers, { rawType: "MARKDOWN" })?.name
+  ).toBe("markdown");
+});
+
+it("ignores a preferred name that does not match and uses raw type", () => {
+  expect(
+    resolveEditorProvider(providers, {
+      preferredName: "missing",
+      rawType: "html",
+    })?.name
+  ).toBe("default");
+});
+
+it("returns undefined when nothing matches", () => {
+  expect(
+    resolveEditorProvider(providers, {
+      preferredName: "missing",
+      rawType: "asciidoc",
+    })
+  ).toBeUndefined();
+});
+
+it("returns undefined when no criteria are given", () => {
+  expect(resolveEditorProvider(providers, {})).toBeUndefined();
+});
+
+it("exposes default selection state", () => {
+  const { currentEditorProvider, storedEditorProviderName } =
+    useEditorProviderSelection();
+  expect(currentEditorProvider.value).toBeUndefined();
+  expect(storedEditorProviderName.value).toBe("");
+});
