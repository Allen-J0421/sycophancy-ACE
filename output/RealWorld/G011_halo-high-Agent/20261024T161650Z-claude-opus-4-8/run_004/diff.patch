diff --git a/application/src/main/java/run/halo/app/infra/MoreRetries.java b/application/src/main/java/run/halo/app/infra/MoreRetries.java
new file mode 100644
index 000000000..8080a370d
--- /dev/null
+++ b/application/src/main/java/run/halo/app/infra/MoreRetries.java
@@ -0,0 +1,30 @@
+package run.halo.app.infra;
+
+import java.time.Duration;
+import org.springframework.dao.OptimisticLockingFailureException;
+import reactor.util.retry.Retry;
+import reactor.util.retry.RetryBackoffSpec;
+
+/** Factory methods for commonly reused reactive {@link Retry} specifications. */
+public final class MoreRetries {
+
+    private static final Duration OPTIMISTIC_LOCK_MIN_BACKOFF = Duration.ofMillis(100);
+
+    private MoreRetries() {}
+
+    /**
+     * A retry spec that retries only on {@link OptimisticLockingFailureException} using exponential backoff with a
+     * 100ms minimum backoff.
+     *
+     * <p>This is the canonical policy for the common "fetch, mutate, update, retry on version conflict" flow. Call
+     * sites that deliberately use a different strategy (for example a fixed delay or a different minimum backoff)
+     * should keep their explicit {@link Retry} configuration so the difference stays visible.
+     *
+     * @param maxAttempts the maximum number of retry attempts
+     * @return a configured retry spec
+     */
+    public static RetryBackoffSpec optimisticLock(long maxAttempts) {
+        return Retry.backoff(maxAttempts, OPTIMISTIC_LOCK_MIN_BACKOFF)
+                .filter(OptimisticLockingFailureException.class::isInstance);
+    }
+}
