+import type { Attachment } from "@halo-dev/api-client";
+import { utils } from "@halo-dev/ui-shared";
+import type { AxiosRequestConfig } from "axios";
+import { computed } from "vue";
+
+export interface AttachmentPermalinkMatch {
+  url: string;
+  matched: boolean;
+}
+
+export interface UseContentEditorUploadOptions {
+  /** Permissions required to upload/match attachments (e.g. `["system:attachments:manage"]`). */
+  permissions: string[];
+  /** Uploads a file or remote URL, returning the created attachment. */
+  uploadAttachment: (
+    body: { file: File } | { url: string },
+    options?: AxiosRequestConfig
+  ) => Promise<{ data: Attachment }>;
+  /** Resolves which of the given URLs already have a matching attachment permalink. */
+  matchAttachmentPermalinks: (urls: string[]) => Promise<{
+    data: { items?: Array<{ url?: string; matched?: boolean }> };
+  }>;
+}
+
+/**
+ * Attachment-upload handlers shared by the console and user-center content editors. The two differ only in the
+ * API-client methods and the required permission, so those are injected; the permission gating, the legacy
+ * image-upload alias, and the permalink-match mapping are identical and handled here.
+ */
+export function useContentEditorUpload(options: UseContentEditorUploadOptions) {
+  const canManageAttachments = computed(() =>
+    utils.permission.has(options.permissions)
+  );
+
+  async function handleUpload(
+    fileOrUrl: File | string,
+    config?: AxiosRequestConfig
+  ): Promise<Attachment | undefined> {
+    if (!canManageAttachments.value) {
+      return;
+    }
+
+    const { data } = await options.uploadAttachment(
+      typeof fileOrUrl === "string" ? { url: fileOrUrl } : { file: fileOrUrl },
+      config
+    );
+    return data;
+  }
+
+  // Kept for third-party editor providers that still consume the legacy prop.
+  function handleUploadImage(file: File, config?: AxiosRequestConfig) {
+    return handleUpload(file, config);
+  }
+
+  async function handleMatchAttachmentPermalinks(
+    urls: string[]
+  ): Promise<AttachmentPermalinkMatch[]> {
+    if (!canManageAttachments.value) {
+      return [];
+    }
+
+    const { data } = await options.matchAttachmentPermalinks(urls);
+
+    return (data.items || []).map((item) => ({
+      url: item.url || "",
+      matched: item.matched || false,
+    }));
+  }
+
+  return {
+    canManageAttachments,
+    handleUpload,
+    handleUploadImage,
+    handleMatchAttachmentPermalinks,
+  };
+}
diff --git a/ui/packages/console-shared/src/composables/use-editor-provider-selection.ts b/ui/packages/console-shared/src/composables/use-editor-provider-selection.ts
