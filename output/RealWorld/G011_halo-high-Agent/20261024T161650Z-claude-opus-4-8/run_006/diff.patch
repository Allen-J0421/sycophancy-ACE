@@ -0,0 +1,62 @@
+import type { EditorProvider } from "@halo-dev/ui-shared";
+import { useLocalStorage } from "@vueuse/core";
+import { shallowRef } from "vue";
+
+const DEFAULT_STORAGE_KEY = "editor-provider-name";
+
+/**
+ * Resolves which editor provider to use for a piece of content: the one whose name matches the content's preferred
+ * editor if present, otherwise the first provider whose raw type matches the content's raw type.
+ *
+ * <p>This is the resolution logic duplicated in each content editor's `handleFetchContent`.
+ */
+export function resolveEditorProvider(
+  providers: EditorProvider[],
+  options: { preferredName?: string; rawType?: string }
+): EditorProvider | undefined {
+  const { preferredName, rawType } = options;
+
+  const preferred = preferredName
+    ? providers.find((provider) => provider.name === preferredName)
+    : undefined;
+  if (preferred) {
+    return preferred;
+  }
+
+  if (rawType) {
+    const lowerRawType = rawType.toLowerCase();
+    return providers.find(
+      (provider) => provider.rawType.toLowerCase() === lowerRawType
+    );
+  }
+
+  return undefined;
+}
+
+export interface UseEditorProviderSelectionOptions {
+  /** Local-storage key for the last-used provider name. Defaults to `"editor-provider-name"`. */
+  storageKey?: string;
+}
+
+/**
+ * Shared state for editor-provider selection across content editors: the currently active provider and the
+ * last-used provider name persisted to local storage.
+ *
+ * <p>Writing the provider onto the (structurally different) form state and persisting changes stays in the caller;
+ * this composable owns only the state that is identical across editors. Use {@link resolveEditorProvider} for the
+ * shared "preferred-then-raw-type" resolution.
+ */
+export function useEditorProviderSelection(
+  options: UseEditorProviderSelectionOptions = {}
+) {
+  const currentEditorProvider = shallowRef<EditorProvider>();
+  const storedEditorProviderName = useLocalStorage(
+    options.storageKey ?? DEFAULT_STORAGE_KEY,
+    ""
+  );
+
+  return {
+    currentEditorProvider,
+    storedEditorProviderName,
+  };
+}
