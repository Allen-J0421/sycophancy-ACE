@@ -0,0 +1,93 @@
+import { QueryClient, VueQueryPlugin } from "@tanstack/vue-query";
+import { flushPromises, mount } from "@vue/test-utils";
+import { expect, it, vi } from "vite-plus/test";
+import { defineComponent, h, ref } from "vue";
+import { useListQuery, type PagedList } from "../use-list-query";
+
+// Replace the route-backed refs with plain refs so the composable can be exercised without a router.
+vi.mock("@vueuse/router", async () => {
+  const { ref: vueRef } = await import("vue");
+  return {
+    useRouteQuery: (_key: string, defaultValue: unknown) => vueRef(defaultValue),
+  };
+});
+
+interface Item {
+  id: number;
+}
+
+function page(items: Item[], extra: Partial<PagedList<Item>> = {}): PagedList<Item> {
+  return {
+    items,
+    total: items.length,
+    page: 1,
+    size: 20,
+    hasNext: false,
+    hasPrevious: false,
+    totalPages: 1,
+    first: true,
+    last: true,
+    ...extra,
+  };
+}
+
+function mountWithQuery(fetchFn: (params: { page: number; size: number }) => Promise<PagedList<Item>>) {
+  const client = new QueryClient();
+  const wrapper = mount(
+    defineComponent({
+      setup() {
+        const filter = ref("a");
+        const api = useListQuery<Item>({
+          queryKey: [filter],
+          filters: [filter],
+          fetchFn,
+        });
+        return () =>
+          h("div", [
+            h("span", { class: "count" }, String(api.items.value.length)),
+            h("span", { class: "total" }, String(api.total.value)),
+            h("span", { class: "has-next" }, String(api.hasNext.value)),
+            h("span", { class: "page" }, String(api.page.value)),
+            h("button", { class: "to-page-2", onClick: () => (api.page.value = 2) }),
+            h("button", { class: "change-filter", onClick: () => (filter.value = "b") }),
+          ]);
+      },
+    }),
+    { global: { plugins: [[VueQueryPlugin, { queryClient: client }]] } }
+  );
+  return { wrapper, client };
+}
+
+it("derives items and pagination from the fetch response", async () => {
+  const fetchFn = vi.fn(async () => page([{ id: 1 }, { id: 2 }], { total: 5, hasNext: true }));
+  const { wrapper, client } = mountWithQuery(fetchFn);
+  try {
+    await flushPromises();
+    expect(wrapper.find(".count").text()).toBe("2");
+    expect(wrapper.find(".total").text()).toBe("5");
+    expect(wrapper.find(".has-next").text()).toBe("true");
+    expect(fetchFn).toHaveBeenCalledWith({ page: 1, size: 20 });
+  } finally {
+    wrapper.unmount();
+    client.clear();
+  }
+});
+
+it("resets page to 1 when a filter changes", async () => {
+  const fetchFn = vi.fn(async () => page([{ id: 1 }]));
+  const { wrapper, client } = mountWithQuery(fetchFn);
+  try {
+    await flushPromises();
+
+    await wrapper.find(".to-page-2").trigger("click");
+    await flushPromises();
+    expect(wrapper.find(".page").text()).toBe("2");
+
+    await wrapper.find(".change-filter").trigger("click");
+    await flushPromises();
+    expect(wrapper.find(".page").text()).toBe("1");
+  } finally {
+    wrapper.unmount();
+    client.clear();
+  }
+});
