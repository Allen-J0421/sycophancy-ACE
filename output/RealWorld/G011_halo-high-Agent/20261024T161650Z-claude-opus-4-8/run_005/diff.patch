@@ -0,0 +1,88 @@
+import { beforeEach, expect, it, vi } from "vite-plus/test";
+
+const toastSuccess = vi.hoisted(() => vi.fn());
+vi.mock("@halo-dev/components", () => ({
+  Toast: { success: toastSuccess },
+}));
+
+import { useBatchAction } from "../use-batch-action";
+
+beforeEach(() => {
+  toastSuccess.mockClear();
+});
+
+it("runs the action for every item", async () => {
+  const seen: number[] = [];
+  const { runBatch } = useBatchAction();
+
+  await runBatch({
+    items: [1, 2, 3, 4, 5, 6, 7],
+    action: async (n) => {
+      seen.push(n);
+    },
+    concurrency: 2,
+  });
+
+  expect([...seen].sort((a, b) => a - b)).toEqual([1, 2, 3, 4, 5, 6, 7]);
+});
+
+it("processes chunks sequentially and in-chunk concurrently", async () => {
+  const running: number[] = [];
+  let maxConcurrent = 0;
+  const { runBatch } = useBatchAction();
+
+  await runBatch({
+    items: [1, 2, 3, 4, 5],
+    concurrency: 2,
+    action: async (n) => {
+      running.push(n);
+      maxConcurrent = Math.max(maxConcurrent, running.length);
+      await Promise.resolve();
+      running.splice(running.indexOf(n), 1);
+    },
+  });
+
+  // With chunk size 2, no more than 2 actions are ever in flight at once.
+  expect(maxConcurrent).toBeLessThanOrEqual(2);
+});
+
+it("awaits onSuccess before showing the success toast", async () => {
+  const order: string[] = [];
+  const { runBatch } = useBatchAction();
+
+  await runBatch({
+    items: ["a"],
+    action: async () => {
+      order.push("action");
+    },
+    successMessage: "done",
+    onSuccess: async () => {
+      order.push("onSuccess");
+    },
+  });
+
+  expect(order).toEqual(["action", "onSuccess"]);
+  expect(toastSuccess).toHaveBeenCalledOnce();
+  expect(toastSuccess).toHaveBeenCalledWith("done");
+});
+
+it("does not show a toast when no successMessage is given", async () => {
+  const { runBatch } = useBatchAction();
+
+  await runBatch({
+    items: ["a"],
+    action: async () => {},
+  });
+
+  expect(toastSuccess).not.toHaveBeenCalled();
+});
+
+it("handles an empty item list without running the action or toasting", async () => {
+  const action = vi.fn();
+  const { runBatch } = useBatchAction();
+
+  await runBatch({ items: [], action, successMessage: "done" });
+
+  expect(action).not.toHaveBeenCalled();
+  expect(toastSuccess).toHaveBeenCalledWith("done");
+});
