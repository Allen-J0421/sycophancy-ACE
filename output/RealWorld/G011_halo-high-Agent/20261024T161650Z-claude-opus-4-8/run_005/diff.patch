index 000000000..ab23d0b29
--- /dev/null
+++ b/ui/console-src/composables/use-list-query.ts
@@ -0,0 +1,87 @@
+import { useQuery } from "@tanstack/vue-query";
+import { useRouteQuery } from "@vueuse/router";
+import { computed, watch, type WatchSource } from "vue";
+
+/**
+ * The pagination envelope shared by every generated `*List` response (e.g. `ListedPostList`). Declared structurally
+ * so any of those response types is assignable to it.
+ */
+export interface PagedList<T> {
+  items: T[];
+  total: number;
+  page: number;
+  size: number;
+  hasNext: boolean;
+  hasPrevious: boolean;
+  totalPages: number;
+  first: boolean;
+  last: boolean;
+}
+
+export interface UseListQueryOptions<T> {
+  /**
+   * Reactive query-key parts, typically the filter refs. `page` and `size` are appended automatically, so they must
+   * not be included here.
+   */
+  queryKey: unknown[];
+  /** Fetches a single page of results. Receives the current `page` and `size`. */
+  fetchFn: (params: { page: number; size: number }) => Promise<PagedList<T>>;
+  /** Filter sources that reset `page` back to 1 whenever any of them changes. */
+  filters?: WatchSource[];
+  /** Default page size, bound to the `size` route query. Defaults to 20. */
+  defaultSize?: number;
+  /**
+   * Polling interval, mirroring vue-query's `refetchInterval` but receiving the current items for convenience.
+   * Return `false` to stop polling.
+   */
+  refetchInterval?: (items: T[] | undefined) => number | false | undefined;
+}
+
+/**
+ * Encapsulates the list/pagination plumbing repeated across console list views:
+ *
+ * <ul>
+ *   <li>the `page`/`size` route-query refs and the "reset to page 1 when a filter changes" watch;</li>
+ *   <li>a vue-query query whose `page`/`size` are part of the key;</li>
+ *   <li>`total`/`hasNext`/`hasPrevious`/`totalPages` derived reactively from the response, instead of being written
+ *       as a side effect inside `queryFn`.</li>
+ * </ul>
+ *
+ * The returned object spreads the underlying vue-query result (`data`, `isLoading`, `isFetching`, `refetch`, ...) and
+ * adds `page`, `size`, `items`, and the pagination computeds.
+ */
+export function useListQuery<T>(options: UseListQueryOptions<T>) {
+  const page = useRouteQuery<number>("page", 1, { transform: Number });
+  const size = useRouteQuery<number>("size", options.defaultSize ?? 20, {
+    transform: Number,
+  });
+
+  if (options.filters && options.filters.length > 0) {
+    watch(options.filters, () => {
+      page.value = 1;
+    });
+  }
+
+  const query = useQuery<PagedList<T>>({
+    queryKey: [...options.queryKey, page, size],
+    queryFn: () => options.fetchFn({ page: page.value, size: size.value }),
+    refetchInterval: (data) => options.refetchInterval?.(data?.items) ?? false,
+  });
+
+  const items = computed<T[]>(() => query.data.value?.items ?? []);
+  const total = computed(() => query.data.value?.total ?? 0);
+  const hasNext = computed(() => query.data.value?.hasNext ?? false);
+  const hasPrevious = computed(() => query.data.value?.hasPrevious ?? false);
+  const totalPages = computed(() => query.data.value?.totalPages ?? 0);
+
+  return {
+    ...query,
+    page,
+    size,
+    items,
+    total,
+    hasNext,
+    hasPrevious,
+    totalPages,
+  };
+}
