index 000000000..d8dc8ee58
--- /dev/null
+++ b/ui/console-src/composables/use-batch-action.ts
@@ -0,0 +1,48 @@
+import { Toast } from "@halo-dev/components";
+import { chunk } from "es-toolkit";
+
+export interface BatchActionOptions<T> {
+  /** Items to run the action against (typically selected resource names). */
+  items: T[];
+  /** Action to run for a single item. */
+  action: (item: T) => Promise<unknown>;
+  /** Number of actions to run concurrently per chunk. Defaults to 5. */
+  concurrency?: number;
+  /** Message shown via {@link Toast.success} once every action has completed. */
+  successMessage?: string;
+  /**
+   * Called after all actions have completed and before the success toast, e.g. to refetch the list and clear the
+   * current selection.
+   */
+  onSuccess?: () => void | Promise<void>;
+}
+
+/**
+ * Encapsulates the batch-operation plumbing repeated across list views: run an async action against a list of items
+ * in bounded-concurrency chunks, then optionally refetch, clear selection, and show a success toast.
+ *
+ * <p>The surrounding confirmation dialog (and its wording) stays in the caller, since it varies per operation.
+ */
+export function useBatchAction() {
+  async function runBatch<T>(options: BatchActionOptions<T>): Promise<void> {
+    const {
+      items,
+      action,
+      concurrency = 5,
+      successMessage,
+      onSuccess,
+    } = options;
+
+    for (const batch of chunk(items, concurrency)) {
+      await Promise.all(batch.map((item) => action(item)));
+    }
+
+    await onSuccess?.();
+
+    if (successMessage) {
+      Toast.success(successMessage);
+    }
+  }
+
+  return { runBatch };
+}
