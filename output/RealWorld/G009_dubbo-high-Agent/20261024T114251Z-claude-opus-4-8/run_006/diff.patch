+package org.apache.dubbo.rpc.protocol.tri.rest.argument;
+
+import org.apache.dubbo.rpc.model.FrameworkModel;
+
+import java.lang.reflect.Type;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.nio.ByteBuffer;
+import java.nio.charset.Charset;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Currency;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.OptionalInt;
+import java.util.UUID;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Characterization tests that pin the current observable behavior of
+ * {@link GeneralTypeConverter} before refactoring its dispatch logic.
+ *
+ * <p>These tests intentionally assert the behavior as it exists today (including
+ * any quirks); they form a safety net so a behavior-preserving refactor can be
+ * verified. They are not a specification of "correct" behavior.
+ */
+class GeneralTypeConverterCharacterizationTest {
+
+    private final GeneralTypeConverter converter = new GeneralTypeConverter(FrameworkModel.defaultModel());
+
+    // Used to obtain a ParameterizedType for the Type-based conversion path.
+    public List<Integer> intList;
+
+    private enum Color {
+        RED,
+        GREEN,
+        BLUE
+    }
+
+    // ---- null / passthrough / Optional -------------------------------------
+
+    @Test
+    void nullSourceUsesTypeDefaults() {
+        assertEquals(0, converter.convert(null, int.class));
+        assertEquals(0L, converter.convert(null, long.class));
+        assertEquals(Boolean.FALSE, converter.convert(null, boolean.class));
+        assertNull(converter.convert(null, Integer.class));
+        assertNull(converter.convert(null, String.class));
+    }
+
+    @Test
+    void sameTypePassesThrough() {
+        String s = "abc";
+        assertSame(s, converter.convert(s, String.class));
+        Integer i = 5;
+        assertSame(i, converter.convert(i, Integer.class));
+    }
+
+    @Test
+    void optionalTargetWrapsSource() {
+        assertEquals(Optional.of("x"), converter.convert("x", Optional.class));
+    }
+
+    @Test
+    void optionalSourceIsUnwrapped() {
+        assertEquals(5, converter.convert(Optional.of("5"), Integer.class));
+        assertNull(converter.convert(Optional.empty(), Integer.class));
+    }
+
+    // ---- String -> number / boolean / char ---------------------------------
+
+    @Test
+    void stringToNumbers() {
+        assertEquals(42, converter.convert("42", Integer.class));
+        assertEquals(42, converter.convert("42", int.class));
+        assertEquals(100L, converter.convert("100", Long.class));
+        assertEquals((short) 5, converter.convert("5", Short.class));
+        assertEquals((byte) 7, converter.convert("7", Byte.class));
+        assertEquals(3.14d, converter.convert("3.14", Double.class));
+        assertEquals(3.14f, converter.convert("3.14", Float.class));
+        assertEquals(new BigInteger("123"), converter.convert("123", BigInteger.class));
+        assertEquals(0, ((BigDecimal) converter.convert("1.5", BigDecimal.class)).compareTo(new BigDecimal("1.5")));
+    }
+
+    @Test
+    void stringHexNumbersAreDecoded() {
+        assertEquals(31, converter.convert("0x1F", Integer.class));
+        assertEquals(255L, converter.convert("0xFF", Long.class));
+    }
+
+    @Test
+    void stringToNumberAbstractPicksLongOrDouble() {
+        assertEquals(42L, converter.convert("42", Number.class));
+        assertEquals(4.2d, converter.convert("4.2", Number.class));
+    }
+
+    @Test
+    void stringToBooleanVariants() {
+        assertEquals(Boolean.TRUE, converter.convert("true", Boolean.class));
+        assertEquals(true, converter.convert("true", boolean.class));
+        assertEquals(Boolean.TRUE, converter.convert("on", Boolean.class));
+        assertEquals(Boolean.TRUE, converter.convert("yes", Boolean.class));
+        assertEquals(Boolean.TRUE, converter.convert("1", Boolean.class));
+        assertEquals(Boolean.FALSE, converter.convert("0", Boolean.class));
+        assertEquals(Boolean.FALSE, converter.convert("off", Boolean.class));
+    }
+
+    @Test
+    void stringToChar() {
+        assertEquals('A', converter.convert("A", Character.class));
+        assertThrows(RuntimeException.class, () -> converter.convert("AB", char.class));
+    }
+
+    @Test
+    void emptyOrNullLiteralStringsUseEmptyDefaults() {
+        // non-primitive, non-container -> null
+        assertNull(converter.convert("", Integer.class));
+        assertNull(converter.convert("null", Integer.class));
+        assertNull(converter.convert("NULL", Integer.class));
+        // primitive -> type default
+        assertEquals(0, converter.convert("", int.class));
+        assertEquals(0, converter.convert("null", int.class));
+        // container -> empty container
+        assertTrue(((List<?>) converter.convert("", List.class)).isEmpty());
+    }
+
+    // ---- String -> misc value types ----------------------------------------
+
+    @Test
+    void stringToValueTypes() {
+        assertEquals(new Locale("en", "US"), converter.convert("en-US", Locale.class));
+        assertEquals(Currency.getInstance("USD"), converter.convert("USD", Currency.class));
+        assertEquals(StandardCharsets.UTF_8, converter.convert("UTF-8", Charset.class));
+        UUID uuid = UUID.randomUUID();
+        assertEquals(uuid, converter.convert(uuid.toString(), UUID.class));
+        assertEquals(Integer.class, converter.convert("java.lang.Integer", Class.class));
+    }
+
+    @Test
+    void stringToByteAndCharArrays() {
+        assertArrayEquals("hi".getBytes(StandardCharsets.UTF_8), converter.convert("hi", byte[].class));
+        assertArrayEquals(new char[] {'h', 'i'}, converter.convert("hi", char[].class));
+    }
+
+    @Test
+    void stringToOptionalInt() {
+        assertEquals(OptionalInt.of(5), converter.convert("5", OptionalInt.class));
+    }
+
+    @Test
+    void stringToEnum() {
+        assertEquals(Color.GREEN, converter.convert("GREEN", Color.class));
+    }
+
+    @Test
+    void stringToArrayAndCollection() {
+        assertArrayEquals(new int[] {1, 2, 3}, converter.convert("1,2,3", int[].class));
+        assertArrayEquals(new String[] {"a", "b"}, converter.convert("a,b", String[].class));
+        assertEquals(Arrays.asList("a", "b", "c"), converter.convert("a,b,c", List.class));
+    }
+
+    // ---- Number source ------------------------------------------------------
+
+    @Test
+    void numberConversions() {
+        assertEquals("42", converter.convert(42, String.class));
+        assertEquals(42.0d, converter.convert(42, Double.class));
+        assertEquals(42L, converter.convert(42, Long.class));
+        assertEquals('A', converter.convert(65, Character.class));
+        assertEquals(Boolean.TRUE, converter.convert(42, Boolean.class));
+        assertEquals(Boolean.FALSE, converter.convert(0, Boolean.class));
+        assertEquals(new Date(1000L), converter.convert(1000L, Date.class));
+    }
+
+    @Test
+    void numberToEnumByOrdinal() {
+        assertEquals(Color.GREEN, converter.convert(1, Color.class));
+    }
+
+    // ---- Enum source --------------------------------------------------------
+
+    @Test
+    void enumConversions() {
+        assertEquals("RED", converter.convert(Color.RED, String.class));
+        assertEquals(1, converter.convert(Color.GREEN, Integer.class));
+        assertEquals(1, converter.convert(Color.GREEN, int.class));
+    }
+
+    // ---- byte[] source ------------------------------------------------------
+
+    @Test
+    void byteArrayConversions() {
+        assertEquals("hi", converter.convert("hi".getBytes(StandardCharsets.UTF_8), String.class));
+        byte[] intBytes = ByteBuffer.allocate(4).putInt(42).array();
+        assertEquals(42, converter.convert(intBytes, Integer.class));
+        assertNull(converter.convert(new byte[0], Integer.class));
+    }
+
+    // ---- Date source --------------------------------------------------------
+
+    @Test
+    void dateConversions() {
+        Date date = new Date(1000L);
+        assertEquals(1000L, converter.convert(date, Long.class));
+        assertEquals(1000L, converter.convert(date, long.class));
+        assertEquals(java.time.Instant.ofEpochMilli(1000L), converter.convert(date, java.time.Instant.class));
+    }
+
+    // ---- Map target ---------------------------------------------------------
+
+    @Test
+    void mapConversion() {
+        Object result = converter.convert(java.util.Collections.singletonMap("a", "1"), java.util.HashMap.class);
+        assertEquals(java.util.Collections.singletonMap("a", "1"), result);
+        assertTrue(result instanceof java.util.HashMap);
+    }
+
+    // ---- byte[] -> boolean --------------------------------------------------
+
+    @Test
+    void byteArrayToBoolean() {
+        assertEquals(Boolean.FALSE, converter.convert(new byte[] {0}, Boolean.class));
+        assertEquals(Boolean.TRUE, converter.convert(new byte[] {1}, Boolean.class));
+    }
+
+    // ---- collection/array source collapsing to scalar ----------------------
+
+    @Test
+    void collectionAndArrayCollapseToFirstElement() {
+        assertEquals(7, converter.convert(Arrays.asList("7", "8"), Integer.class));
+        assertEquals(9, converter.convert(new String[] {"9", "10"}, Integer.class));
+        assertNull(converter.convert(Arrays.asList(), Integer.class));
+    }
+
+    // ---- fall-through: single-arg constructor -------------------------------
+
+    @Test
+    void singleArgConstructorFallback() {
+        Object sb = converter.convert("abc", StringBuilder.class);
+        assertEquals("abc", sb.toString());
+    }
+
+    // ---- Type (generic) based conversion path -------------------------------
+
+    @Test
+    void parameterizedListConversion() throws Exception {
+        Type listType = GeneralTypeConverterCharacterizationTest.class
+                .getField("intList")
+                .getGenericType();
+        Object result = converter.convert("1,2,3", listType);
+        assertEquals(Arrays.asList(1, 2, 3), result);
+    }
+
+    @Test
+    void nullTargetReturnsSourceUnchanged() {
+        Object src = new Object();
+        assertSame(src, converter.convert(src, (Class<?>) null));
+        assertFalse(converter.convert("x", (Class<?>) null) instanceof Integer);
+    }
+}
