rn shrimps.\n    47\t     * @param atDayTime true if current step is daytime false otherwise.\n    48\t     * @param oxygenLevel The inital level of dissolved oxygen in the water.\n    49\t     * @param disease The disease may happened during simulation.  \n    50\t     * @param step current step.\n    51\t     * \n    52\t     * @return the oxygen level the species produced or consumed after action.\n    53\t     */\n    54\t    public double act(List<Creature> newSeaweeds, boolean atDayTime, double oxygenLevel, Disease disease,  int step)\n    55\t    {\n    56\t        incrementAge();\n    57\t        if(oxygenLevel < PLANT_OXYGEN_REQUIRED) {\n    58\t            setDead();\n    59\t            return 0;\n    60\t        }\n    61\t\n    62\t        if(isAlive() && age >= MATURE_AGE) {\n    63\t            giveBirth(newSeaweeds);\n    64\t        }\n    65\t\n    66\t        if(atDayTime) {\n    67\t            return OXYGEN_GENERATED;\n    68\t        }\n    69\t        else {\n    70\t            return -PLANT_OXYGEN_REQUIRED;\n    71\t        }\n    72\t    }\n    73\t    \n    74\t    /**\n    75\t     * Increase the age.\n    76\t     * This could result in the shrimp's death.\n    77\t     */\n    78\t    private void incrementAge()\n    79\t    {\n    80\t        age++;\n    81\t        if(age > MAX_AGE) {\n    82\t            setDead();\n    83\t        }\n    84\t    }\n    85\t    \n    86\t    /**\n    87\t     * Check whether or not this shrimp is to give birth at this step.\n    88\t     * New births will be made into free adjacent locations.\n    89\t     * @param newSeaweeds A list to return newly propagated seaweed.\n    90\t     */\n    91\t    private void giveBirth(List<Creature> newSeaweeds)\n    92\t    {\n    93\t        // New seaweed are created into adjacent locations.\n    94\t        // Get a list of adjacent free locations.\n    95\t        Field field = getField();\n    96\t        List<Location> free = field.getFreeAdjacentLocations(