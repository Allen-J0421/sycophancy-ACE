ate counts of the number of foxes and rabbits.\n   109\t     * These are not kept up to date as foxes and rabbits\n   110\t     * are placed in the field, but only when a rrandomAdjacentLocationequest\n   111\t     * is made for the information.\n   112\t     * @param field The field to generate the stats for.\n   113\t     */\n   114\t    private void generateCounts(Field field)\n   115\t    {\n   116\t        reset();\n   117\t        for(int row = 0; row < field.getDepth(); row++) {\n   118\t            for(int col = 0; col < field.getWidth(); col++) {\n   119\t                Object animal = field.getObjectAt(row, col);\n   120\t                if(animal != null) {\n   121\t                    incrementCount(animal.getClass());\n   122\t                }\n   123\t            }\n   124\t        }\n   125\t        countsValid = true;\n   126\t    }\n   127\t}\n","exit_code":0,"status":"completed"}}
