+     */
+    protected final void initializeLife(boolean randomAge, int maxAge, int foodValue)
+    {
+        if(randomAge) {
+            age = rand.nextInt(maxAge);
+            foodLevel = rand.nextInt(foodValue);
+        }
+        else {
+            age = 0;
+            foodLevel = foodValue;
