diff --git a/AbstractAquaticAnimal.java b/AbstractAquaticAnimal.java
new file mode 100644
index 0000000..79b5d93
--- /dev/null
+++ b/AbstractAquaticAnimal.java
@@ -0,0 +1,132 @@
+import java.util.List;
+import java.util.Random;
+
+/**
+ * Shared behavior for aquatic animals that age, get hungry, breed, and move.
+ */
+public abstract class AbstractAquaticAnimal extends Animal
+{
+    private static final Random rand = Randomizer.getRandom();
+
+    private int age;
+    private int foodLevel;
+
+    protected AbstractAquaticAnimal(Field field, Location location, boolean randomAge)
+    {
+        super(field, location);
+        if(randomAge) {
+            age = rand.nextInt(getMaxAge());
+            foodLevel = rand.nextInt(getInitialFoodLevel());
+        }
+        else {
+            age = 0;
+            foodLevel = getInitialFoodLevel();
+        }
+    }
+
+    protected abstract int getMaxAge();
+
+    protected abstract int getInitialFoodLevel();
+
+    protected abstract int getBreedingAge();
+
+    protected abstract double getBreedingProbability();
+
+    protected abstract int getMaxLitterSize();
+
+    protected abstract boolean canBreedWithCurrentConditions();
+
+    protected abstract Location search(Disease disease, int step);
+
+    protected abstract Creature createYoung(Field field, Location location);
+
+    protected final int getAge()
+    {
+        return age;
+    }
+
+    protected final int getFoodLevel()
+    {
+        return foodLevel;
+    }
+
+    protected final void setFoodLevel(int foodLevel)
+    {
+        this.foodLevel = foodLevel;
+    }
+
+    @Override
+    public double act(List<Creature> newCreatures, boolean atDayTime, double oxygenLevel, Disease disease, int step)
+    {
+        if(oxygenLevel < ANIMAL_OXYGEN_REQUIRED) {
+            setDead();
+            return 0;
+        }
+
+        if(dieOfInfection(disease)) {
+            return 0;
+        }
+
+        ifCanGrantImmunity(disease, step);
+        incrementAge();
+        incrementHunger();
+
+        if(isAlive() && !needSleep(atDayTime)) {
+            giveBirth(newCreatures);
+
+            Location newLocation = search(disease, step);
+            if(newLocation == null) {
+                newLocation = getField().freeAdjacentLocation(getLocation());
+            }
+
+            if(newLocation != null) {
+                setLocation(newLocation);
+            }
+            else {
+                setDead();
+            }
+        }
+
+        return -ANIMAL_OXYGEN_REQUIRED;
+    }
+
+    private void incrementAge()
+    {
+        age++;
+        if(age > getMaxAge()) {
+            setDead();
+        }
+    }
+
+    private void incrementHunger()
+    {
+        foodLevel--;
+        if(foodLevel <= 0) {
+            setDead();
+        }
+    }
+
+    private void giveBirth(List<Creature> newCreatures)
+    {
+        Field field = getField();
+        List<Location> free = field.getFreeAdjacentLocations(getLocation());
+        int births = breed();
+        for(int i = 0; i < births && !free.isEmpty(); i++) {
+            Location loc = free.remove(0);
+            newCreatures.add(createYoung(field, loc));
+        }
+    }
+
+    private int breed()
+    {
+        if(canBreed() && rand.nextDouble() <= getBreedingProbability()) {
+            return rand.nextInt(getMaxLitterSize()) + 1;
+        }
+        return 0;
+    }
+
+    private boolean canBreed()
+    {
+        return age >= getBreedingAge() && canBreedWithCurrentConditions();
+    }
+}
