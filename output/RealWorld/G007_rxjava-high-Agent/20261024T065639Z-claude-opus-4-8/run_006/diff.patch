+    @Test
+    public void finishDisposesUpstream() {
+        var cs = MaybeSubject.create();
+
+        var cd = new CompositeDisposable();
+        var ts = cs.toStreamable().stream(cd);
+
+        assertTrue(cs.hasObservers(), "has no observers?");
+
+        ts.finish().toCompletableFuture().join();
+
+        assertFalse(cs.hasObservers(), "finish() did not dispose the upstream subscription");
+    }
 }
