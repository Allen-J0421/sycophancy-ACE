+
+    @Test
+    public void finishForwardedToUpstream() {
+        var finishCalls = new AtomicInteger();
+        Streamable<Integer> source = new Streamable<Integer>() {
+            @Override
+            public Streamer<Integer> stream(StreamerCancellation cancellation) {
+                return new Streamer<Integer>() {
+                    int count;
+
+                    @Override
+                    public CompletionStage<Boolean> next() {
+                        return count++ == 0 ? Streamer.NEXT_TRUE : Streamer.NEXT_FALSE;
+                    }
+
+                    @Override
+                    public Integer current() {
+                        return 1;
+                    }
+
+                    @Override
+                    public CompletionStage<Void> finish() {
+                        finishCalls.incrementAndGet();
+                        return Streamer.FINISHED;
+                    }
+                };
+            }
+        };
+
+        var streamer = source.delay(1, TimeUnit.MILLISECONDS, Schedulers.single())
+                .stream(new CompositeDisposable());
+
+        streamer.finish().toCompletableFuture().join();
+
+        assertEquals(1, finishCalls.get(), "Delay.finish() did not forward to upstream.finish()");
+    }
 }
