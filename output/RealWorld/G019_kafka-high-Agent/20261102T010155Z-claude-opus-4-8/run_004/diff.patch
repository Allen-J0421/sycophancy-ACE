+package org.apache.kafka.image.node;
+
+import org.apache.kafka.image.ClusterImage;
+
+import java.util.Collection;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/**
+ * A base node for an integer-keyed map of cluster registrations (brokers or controllers).
+ * Each registration is exposed as a child named by its node id and rendered as a leaf node
+ * using its string representation.
+ *
+ * @param <R> the registration type.
+ */
+abstract class ClusterImageRegistrationsNode<R> implements MetadataNode {
+    private final ClusterImage image;
+
+    ClusterImageRegistrationsNode(ClusterImage image) {
+        this.image = image;
+    }
+
+    /**
+     * @return the registrations keyed by node id.
+     */
+    protected abstract Map<Integer, R> registrations(ClusterImage image);
+
+    @Override
+    public Collection<String> childNames() {
+        return registrations(image).keySet().stream()
+            .map(Object::toString)
+            .collect(Collectors.toList());
+    }
+
+    @Override
+    public MetadataNode child(String name) {
+        try {
+            Integer nodeId = Integer.valueOf(name);
+            R registration = registrations(image).get(nodeId);
+            if (registration == null) return null;
+            return new MetadataLeafNode(registration.toString());
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+}
