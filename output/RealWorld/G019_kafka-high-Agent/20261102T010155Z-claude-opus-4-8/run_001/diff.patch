+ * limitations under the License.
+ */
+package org.apache.kafka.tools.consumer;
+
+import org.apache.kafka.common.protocol.ApiMessage;
+import org.apache.kafka.coordinator.group.GroupCoordinatorRecordSerde;
+import org.apache.kafka.coordinator.group.generated.CoordinatorRecordJsonConverters;
+
+import com.fasterxml.jackson.databind.JsonNode;
+
+import java.util.Set;
+
+/**
+ * Base formatter for records written by the group coordinator to the {@code __consumer_offsets} topic.
+ * Subclasses only need to declare which record types they format; key and value JSON rendering is
+ * shared via the group coordinator's generated converters.
+ */
+public abstract class GroupCoordinatorRecordMessageFormatter extends CoordinatorRecordMessageFormatter {
+    private final Set<Short> allowedRecords;
+
+    protected GroupCoordinatorRecordMessageFormatter(Set<Short> allowedRecords) {
+        super(new GroupCoordinatorRecordSerde());
+        this.allowedRecords = allowedRecords;
+    }
+
+    @Override
+    protected boolean isRecordTypeAllowed(short recordType) {
+        return allowedRecords.contains(recordType);
+    }
+
+    @Override
+    protected JsonNode keyAsJson(ApiMessage message) {
+        return CoordinatorRecordJsonConverters.writeRecordKeyAsJson(message);
+    }
+
+    @Override
+    protected JsonNode valueAsJson(ApiMessage message, short version) {
+        return CoordinatorRecordJsonConverters.writeRecordValueAsJson(message, version);
+    }
+}
