+  @Override
+  public @Nullable Entry<K, V2> firstEntry() {
+    return transformEntry(fromMap().firstEntry());
+  }
+
+  @Override
+  public @Nullable Entry<K, V2> floorEntry(@ParametricNullness K key) {
+    return transformEntry(fromMap().floorEntry(key));
