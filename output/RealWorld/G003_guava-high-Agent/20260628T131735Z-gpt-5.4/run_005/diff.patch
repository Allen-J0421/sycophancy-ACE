+package com.google.common.primitives;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import junit.framework.TestCase;
+
+public final class PrimitiveImmutableArrayBuilderCapacityTest extends TestCase {
+  public void testExpandedCapacityGrowsByHalfPlusOne() {
+    assertThat(PrimitiveImmutableArrayBuilderCapacity.expandedCapacity(10, 11)).isEqualTo(16);
+  }
+
+  public void testExpandedCapacityHonorsMinimumWhenGrowthFallsShort() {
+    assertThat(PrimitiveImmutableArrayBuilderCapacity.expandedCapacity(1, 8)).isEqualTo(8);
+  }
+
+  public void testExpandedCapacitySaturatesAtMaxValue() {
+    assertThat(
+            PrimitiveImmutableArrayBuilderCapacity.expandedCapacity(
+                Integer.MAX_VALUE - 2, Integer.MAX_VALUE))
+        .isEqualTo(Integer.MAX_VALUE);
+  }
+
+  public void testExpandedCapacityRejectsOverflowedMinimum() {
+    AssertionError error =
+        assertThrows(
+            AssertionError.class,
+            () -> PrimitiveImmutableArrayBuilderCapacity.expandedCapacity(10, -1));
+
+    assertThat(error).hasMessageThat().contains("cannot store more than MAX_VALUE elements");
+  }
+}
