+    return buildFromDelegate();
+  }
+
+  abstract void addNodeToDelegate(N node);
+
+  abstract ImmutableT buildFromDelegate();
+
+  @SuppressWarnings("unchecked")
+  private B self() {
+    return (B) this;
+  }
+}
