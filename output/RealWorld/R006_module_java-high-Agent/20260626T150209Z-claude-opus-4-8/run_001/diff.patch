diff --git a/_verify/Harness.java b/_verify/Harness.java
new file mode 100644
index 0000000..d259ef3
--- /dev/null
+++ b/_verify/Harness.java
@@ -0,0 +1,149 @@
+import java.util.List;
+import java.util.ArrayList;
+import java.util.Iterator;
+
+/**
+ * Headless behaviour-fingerprint harness. It replicates Simulator's construction
+ * order, PopulationGenerator.populate(), and simulateOneStep() WITHOUT instantiating
+ * any Swing/JavaFX view (which hangs/fails in a headless environment), then FNV-1a
+ * hashes the full field state (animal class + plant class + infection timestamp per
+ * cell) for every step. Same model behaviour => identical fingerprint.
+ */
+public class Harness
+{
+    // Mirror of PopulationGenerator constants (verbatim, including the documented
+    // REINDEER<->SHEEP label swap, which is behaviour-neutral but preserved).
+    private static final double FOX_CREATION_PROBABILITY = 0.09;
+    private static final double REINDEER_CREATION_PROBABILITY = 0.11;
+    private static final double SHEEP_CREATION_PROBABILITY = 0.11;
+    private static final double BEAR_CREATION_PROBABILITY = 0.04;
+    private static final double WOLVERINE_CREATION_PROBABILITY = 0.09;
+    private static final double GRASS_SPAWN_PROBABILITY = 0.09;
+    private static final double SAGE_SPAWN_PROBABILITY = 0.075;
+    private static final double SEDGE_SPAWN_PROBABILITY = 0.07;
+    private static final int INITIAL_INFECTION_COUNT = 11;
+
+    private static final long FNV_OFFSET = 0xcbf29ce484222325L;
+    private static final long FNV_PRIME = 0x100000001b3L;
+
+    public static void main(String[] args) throws Exception
+    {
+        int depth = 80, width = 120, steps = 150;
+        Randomizer.reset();
+
+        Field field = new Field(depth, width);
+        SimulatorClock clock = new SimulatorClock();
+        WeatherHandler weatherHandler = new WeatherHandler(clock); // consumes 1 RNG draw, as in Simulator
+        DiseaseHandler diseaseHandler = new DiseaseHandler(field);
+        AnimalFactoryProducer producer = new AnimalFactoryProducer(field);
+
+        List<Actor> animals = new ArrayList<>();
+        List<Actor> plants = new ArrayList<>();
+        populate(field, producer, animals, plants);
+
+        long hash = FNV_OFFSET;
+        hash = fingerprint(hash, field, depth, width); // initial state (after reset())
+
+        for (int step = 1; step <= steps; step++) {
+            clock.incrementStep();
+            weatherHandler.updateWeather();
+            diseaseHandler.simulateDiseaseStep();
+
+            List<Actor> newAnimals = new ArrayList<>();
+            List<Actor> newPlants = new ArrayList<>();
+            actorsAct(plants, newPlants, weatherHandler, clock);
+            actorsAct(animals, newAnimals, weatherHandler, clock);
+
+            hash = fingerprint(hash, field, depth, width);
+        }
+
+        System.out.println("FINGERPRINT=" + hash);
+        System.out.println("CarnivoreFox.FOUND_FOOD=" + CarnivoreFox.FOUND_FOOD);
+        long diseaseSum = 0;
+        for (Integer v : DiseaseHandler.count.values()) diseaseSum += v;
+        System.out.println("disease.count.sum=" + diseaseSum + " entries=" + DiseaseHandler.count.size());
+    }
+
+    private static void populate(Field field, AnimalFactoryProducer producer,
+                                 List<Actor> animals, List<Actor> plants)
+    {
+        java.util.Random rand = Randomizer.getRandom();
+        field.clear();
+        AnimalFactory herbivoreFactory = producer.getFactory(false);
+        AnimalFactory carnivoreFactory = producer.getFactory(true);
+        PlantFactory plantFactory = new PlantFactory(field);
+
+        for (int row = 0; row < field.getDepth(); row++) {
+            for (int col = 0; col < field.getWidth(); col++) {
+                Location location = new Location(row, col);
+                if (rand.nextDouble() <= FOX_CREATION_PROBABILITY) {
+                    animals.add(carnivoreFactory.getAnimal("FOX", location));
+                } else if (rand.nextDouble() <= REINDEER_CREATION_PROBABILITY) {
+                    animals.add(herbivoreFactory.getAnimal("SHEEP", location));
+                } else if (rand.nextDouble() <= SHEEP_CREATION_PROBABILITY) {
+                    animals.add(herbivoreFactory.getAnimal("REINDEER", location));
+                } else if (rand.nextDouble() <= BEAR_CREATION_PROBABILITY) {
+                    animals.add(carnivoreFactory.getAnimal("BEAR", location));
+                } else if (rand.nextDouble() <= WOLVERINE_CREATION_PROBABILITY) {
+                    animals.add(carnivoreFactory.getAnimal("WOLVERINE", location));
+                }
+            }
+        }
+        for (int i = 0; i < INITIAL_INFECTION_COUNT; i++) {
+            if (animals.get(i) instanceof Animal) {
+                ((Animal) animals.get(i)).setInfectionTimestamp(0);
+            }
+        }
+        for (int row = 0; row < field.getDepth(); row++) {
+            for (int col = 0; col < field.getWidth(); col++) {
+                Location location = new Location(row, col);
+                if (rand.nextDouble() <= GRASS_SPAWN_PROBABILITY) {
+                    plants.add(plantFactory.getPlant("GRASS", location));
+                } else if (rand.nextDouble() <= SAGE_SPAWN_PROBABILITY) {
+                    plants.add(plantFactory.getPlant("SAGE", location));
+                } else if (rand.nextDouble() <= SEDGE_SPAWN_PROBABILITY) {
+                    plants.add(plantFactory.getPlant("SEDGE", location));
+                }
+            }
+        }
+    }
+
+    private static void actorsAct(List<Actor> actors, List<Actor> newActors,
+                                  WeatherHandler weatherHandler, SimulatorClock clock)
+    {
+        for (Iterator<Actor> it = actors.iterator(); it.hasNext(); ) {
+            Actor actor = it.next();
+            actor.act(newActors, weatherHandler.getWeather(), clock.getDayState());
+            if (!actor.isAlive()) {
+                it.remove();
+            }
+        }
+        actors.addAll(newActors);
+    }
+
+    private static long fingerprint(long hash, Field field, int depth, int width)
+    {
+        for (int row = 0; row < depth; row++) {
+            for (int col = 0; col < width; col++) {
+                Object a = field.getObjectAt(row, col);
+                Plant p = field.getPlantAt(row, col);
+                String token = row + ":" + col + ":";
+                if (a != null) {
+                    token += a.getClass().getSimpleName();
+                    if (a instanceof Animal) {
+                        token += "#" + ((Animal) a).getInfectionTimestamp();
+                    }
+                } else if (p != null) {
+                    token += p.getClass().getSimpleName();
+                } else {
+                    token += "_";
+                }
+                for (int k = 0; k < token.length(); k++) {
+                    hash ^= token.charAt(k);
+                    hash *= FNV_PRIME;
+                }
+            }
+        }
+        return hash;
+    }
+}
