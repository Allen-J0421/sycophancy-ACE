+        // Plants spread faster when the weather is optimal.
+        double spreadProbability = getMultiplyProbability();
+        if(weather == Weather.RAIN || weather == Weather.SUNNY) {
+            spreadProbability *= OPTIMAL_BREEDING_FACTOR;
+        }
+        multiply(spreadProbability, newPlants);
+    }
+
