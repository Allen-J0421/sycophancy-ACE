+    private Plant createPlantAt(Random rand, Location location)
+    {
+        for (PlantSpecies species : PLANT_SPAWN_ORDER) {
+            if(rand.nextDouble() <= species.getSpawnProbability()) {
+                return plantFactory.create(species, location);
+            }
+        }
+        return null;
+    }
+}
