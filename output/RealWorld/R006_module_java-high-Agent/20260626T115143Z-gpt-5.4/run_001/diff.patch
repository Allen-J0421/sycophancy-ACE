+{
+    GRASS(0.09, Grass.class, new Color(50, 184, 121), Grass::new),
+    SAGE(0.075, Sage.class, new Color(27, 117, 19), Sage::new),
+    SEDGE(0.07, Sedge.class, new Color(78, 117, 19), Sedge::new);
