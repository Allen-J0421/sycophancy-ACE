diff --git a/AnimalTraits.java b/AnimalTraits.java
new file mode 100644
index 0000000..fe853a3
--- /dev/null
+++ b/AnimalTraits.java
@@ -0,0 +1,36 @@
+import java.util.Map;
+import java.util.Random;
+
+/**
+ * Immutable bundle of the per-species characteristics shared by all instances
+ * of a given kind of animal. Each concrete animal supplies a single static
+ * instance of this to the {@link Animal} super-constructor, which removes the
+ * constructor/breeding/getter duplication that used to be copied across every
+ * species class.
+ *
+ * @param rand                 The species' shared random generator.
+ * @param name                 The species' name.
+ * @param nocturnal            Whether the species is active at night.
+ * @param canGoLand            Whether the species can live on land.
+ * @param canGoWater           Whether the species can live in water.
+ * @param maxAge               The age to which the species can live.
+ * @param maxFood              The maximum food level the species can hold.
+ * @param breedingAge          The age at which the species can start to breed.
+ * @param breedingProbability  The likelihood of breeding in a given step.
+ * @param maxLitterSize        The maximum number of births at once.
+ * @param preyFoodValues       The species' prey names mapped to food value.
+ */
+public record AnimalTraits(
+    Random rand,
+    String name,
+    boolean nocturnal,
+    boolean canGoLand,
+    boolean canGoWater,
+    int maxAge,
+    int maxFood,
+    int breedingAge,
+    double breedingProbability,
+    int maxLitterSize,
+    Map<String, Integer> preyFoodValues)
+{
+}
