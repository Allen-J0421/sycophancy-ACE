@@ -0,0 +1,29 @@
+import java.util.Random;
+
+/**
+ * Immutable bundle of the per-species characteristics shared by all instances
+ * of a given kind of plant. Each concrete plant supplies a single static
+ * instance of this to the {@link Plant} super-constructor, which removes the
+ * constructor/breeding/getter duplication that used to be copied across every
+ * plant class.
+ *
+ * @param rand                 The species' shared random generator.
+ * @param name                 The species' name.
+ * @param canGoLand            Whether the species can live on land.
+ * @param canGoWater           Whether the species can live in water.
+ * @param maxAge               The age to which the species can live.
+ * @param breedingAge          The age at which the species can start to breed.
+ * @param breedingProbability  The likelihood of breeding in a given step.
+ * @param maxLitterSize        The maximum number of births at once.
+ */
+public record PlantTraits(
+    Random rand,
+    String name,
+    boolean canGoLand,
+    boolean canGoWater,
+    int maxAge,
+    int breedingAge,
+    double breedingProbability,
+    int maxLitterSize)
+{
+}
