+    /**
+     * Respond to rain. Physical entities gain water/volume; other actors
+     * (weather, disease) ignore it.
+     */
+    default void onRain() { }
+
+    /**
+     * Respond to fog. Physical entities react in their own way; other
+     * actors ignore it.
+     */
+    default void onFog() { }
+
