diff --git a/shared/src/commonMain/kotlin/net/newpipe/app/viewmodel/settings/SettingsBackedViewModel.kt b/shared/src/commonMain/kotlin/net/newpipe/app/viewmodel/settings/SettingsBackedViewModel.kt
