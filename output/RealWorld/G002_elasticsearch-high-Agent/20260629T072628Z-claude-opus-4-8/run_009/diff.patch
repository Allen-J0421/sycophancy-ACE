+    /**
+     * Heron's formula for the area of a triangle from its three side lengths. It is guarded against the tiny
+     * negative products that floating-point rounding produces for near-degenerate (flat) triangles, which would
+     * otherwise yield a NaN area; such triangles are treated as having zero area.
+     */
+    private static double heronArea(double a, double b, double c) {
+        double s = 0.5 * (a + b + c); // semi-perimeter
+        double da = s - a;
+        double db = s - b;
+        double dc = s - c;
+        if (da >= 0 && db >= 0 && dc >= 0) {
+            return Math.sqrt(s * da * db * dc);
+        }
+        return 0.0;
+    }
