+    /**
+     * Decodes the top-right corner point of a geohash cell from its deinterleaved latitude/longitude bits.
+     * The bits are re-interleaved into the geohash long format, converted to a morton-encoded value and then
+     * decoded back to a lon/lat {@link Point}. Shared by the two {@link #toBoundingBox(String)} branches, which
+     * differ only in the latitude bits supplied (the northern-edge branch clamps the latitude separately).
+     */
+    private static Point topRightCorner(long latBits, long lonBits, int len, int shift) {
+        long ghLong = BitUtil.interleave((int) latBits, (int) lonBits) << 4 | len;
+        final long mortonHash = BitUtil.flipFlop((ghLong >>> 4) << shift);
+        return new Point(decodeLongitude(mortonHash), decodeLatitude(mortonHash));
+    }
