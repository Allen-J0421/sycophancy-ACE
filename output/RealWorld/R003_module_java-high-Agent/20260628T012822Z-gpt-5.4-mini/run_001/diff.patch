+    /**
+     * Create a random actor for a given location, or return null if the
+     * location should remain empty.
+     *
+     * @param rand The shared random generator for spawn decisions.
+     * @param location The location to populate.
+     * @return A newly created actor or null.
+     */
+    private Actor createRandomActor(Random rand, Location location)
+    {
+        if (rand.nextDouble() <= GRASSHOPPER_CREATION_PROBABILITY)
+        {
+            return new Grasshopper(true, field, location);
+        }
+        else if (rand.nextDouble() <= HARVESTER_ANT_CREATION_PROBABILITY)
+        {
+            return new HarvesterAnt(true, field, location);
+        }
+        else if (rand.nextDouble() <= TERMITE_CREATION_PROBABILITY)
+        {
+            return new Termite(true, field, location);
+        }
+        else if (rand.nextDouble() <= IMPALA_CREATION_PROBABILITY)
+        {
+            return new Impala(true, field, location);
+        }
+        else if (rand.nextDouble() <= PANGOLIN_CREATION_PROBABILITY)
+        {
+            return new Pangolin(true, field, location);
+        }
+        else if (rand.nextDouble() <= AARDVARK_CREATION_PROBABILITY)
+        {
+            return new Aardvark(true, field, location);
+        }
+        else if (rand.nextDouble() <= MONGOOSE_CREATION_PROBABILITY)
+        {
+            return new Mongoose(true, field, location);
+        }
+        else if (rand.nextDouble() <= STAR_GRASS_CREATION_PROBABILITY)
+        {
+            return new StarGrass(field, location);
+        }
+        else if (rand.nextDouble() <= RED_OAT_GRASS_CREATION_PROBABILITY)
+        {
+            return new RedOatGrass(field, location);
+        }
+        else if (rand.nextDouble() <= ACACIA_CREATION_PROBABILITY)
+        {
+            return new Acacia(field, location);
+        }
+
+        // Else leave the location empty.
+        return null;
+    }
     
