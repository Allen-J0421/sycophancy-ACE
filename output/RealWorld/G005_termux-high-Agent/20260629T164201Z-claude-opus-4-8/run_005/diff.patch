+    /**
+     * Apply an extended-color SGR introducer (38 = foreground, 48 = background, 58 = underline). The introducer is
+     * followed by either "2;$R;$G;$B" for a 24-bit color or "5;$INDEX" for an indexed color, read from {@link #mArgs}
+     * starting just after {@code argIndex}.
+     *
+     * @param code     the introducer code, one of 38, 48 or 58.
+     * @param argIndex index in {@link #mArgs} of the introducer code itself.
+     * @return the index of the last argument consumed, so the caller's loop resumes after the color sub-arguments.
+     */
+    private int applyExtendedColorSgr(int code, int argIndex) {
+        if (argIndex + 2 > mArgIndex) return argIndex;
+        int firstArg = mArgs[argIndex + 1];
+        if (firstArg == 2) {
+            if (argIndex + 4 > mArgIndex) {
+                Logger.logWarn(mClient, LOG_TAG, "Too few CSI" + code + ";2 RGB arguments");
+            } else {
+                int red = getArg(argIndex + 2, 0, false);
+                int green = getArg(argIndex + 3, 0, false);
+                int blue = getArg(argIndex + 4, 0, false);
+
+                if (red < 0 || green < 0 || blue < 0 || red > 255 || green > 255 || blue > 255) {
+                    finishSequenceAndLogError("Invalid RGB: " + red + "," + green + "," + blue);
+                } else {
+                    int argbColor = 0xff_00_00_00 | (red << 16) | (green << 8) | blue;
+                    setSgrColor(code, argbColor);
+                }
+                argIndex += 4; // "2;P_r;P_g;P_r"
+            }
+        } else if (firstArg == 5) {
+            int color = getArg(argIndex + 2, 0, false);
+            argIndex += 2; // "5;P_s"
+            if (color >= 0 && color < TextStyle.NUM_INDEXED_COLORS) {
+                setSgrColor(code, color);
+            } else {
+                if (LOG_ESCAPE_SEQUENCES) Logger.logWarn(mClient, LOG_TAG, "Invalid color index: " + color);
+            }
+        } else {
+            finishSequenceAndLogError("Invalid ISO-8613-3 SGR first argument: " + firstArg);
+        }
+        return argIndex;
+    }
+
+    /** Store a parsed SGR color into the foreground (38), background (48) or underline (58) slot. */
+    private void setSgrColor(int code, int color) {
+        switch (code) {
+            case 38: mForeColor = color; break;
+            case 48: mBackColor = color; break;
+            case 58: mUnderlineColor = color; break;
+        }
+    }
