+            } else if (parsingPairStart < 0 && (b >= '0' && b <= '9')) {
+                colorIndex = ((colorIndex < 0) ? 0 : colorIndex * 10) + (b - '0');
+            } else {
+                unknownSequence(b);
+                return false;
+            }
+            if (endOfInput) break;
+        }
+        return true;
