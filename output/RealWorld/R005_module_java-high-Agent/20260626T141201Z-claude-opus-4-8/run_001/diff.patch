diff --git a/AnimalTraits.java b/AnimalTraits.java
new file mode 100644
index 0000000..9a261a1
--- /dev/null
+++ b/AnimalTraits.java
@@ -0,0 +1,87 @@
+/**
+ * An immutable value object holding the intrinsic characteristics specific to
+ * animals, on top of the base traits defined in {@link SpeciesTraits}.
+ *
+ * Like its parent, these traits are fixed for a given species and shared by all
+ * of its individuals. Bundling them lets {@link Animal} be created (and reproduce)
+ * with a single traits argument rather than a long parameter list.
+ *
+ * @version 2022.02.28
+ */
+public class AnimalTraits extends SpeciesTraits
+{
+    // The age at which the animal can start to breed.
+    private final int breedingAge;
+    // The age to which the animal can live.
+    private final int maxAge;
+    // The maximum number of births at once.
+    private final int maxLitterSize;
+    // true if the animal hibernates during cold temperatures.
+    private final boolean hibernates;
+    // true if the animal is active at night.
+    private final boolean isNocturnal;
+
+    /**
+     * Create an immutable set of animal traits.
+     *
+     * @param name (String) The name of the species.
+     * @param maximumTemperature (int) The maximum temperature the animal can withstand.
+     * @param minimumTemperature (int) The minimum temperature the animal can withstand.
+     * @param nutritionalValue (int) The nutritional value given to whatever eats this animal.
+     * @param reproductionProbability (double) The probability that this animal reproduces.
+     * @param maxAge (int) The animal's life expectancy.
+     * @param breedingAge (int) The age at which the animal can start to reproduce.
+     * @param maxLitterSize (int) The maximum number of children the animal can have in one reproduction.
+     * @param hibernates (boolean) Whether the animal is able to hibernate.
+     * @param isNocturnal (boolean) Whether the animal is more active at night.
+     */
+    public AnimalTraits(String name, int maximumTemperature, int minimumTemperature, int nutritionalValue, double reproductionProbability, int maxAge, int breedingAge, int maxLitterSize, boolean hibernates, boolean isNocturnal)
+    {
+        super(name, maximumTemperature, minimumTemperature, nutritionalValue, reproductionProbability);
+        this.maxAge = maxAge;
+        this.breedingAge = breedingAge;
+        this.maxLitterSize = maxLitterSize;
+        this.hibernates = hibernates;
+        this.isNocturnal = isNocturnal;
+    }
+
+    /**
+     * @return (int) The maximum age to which the animal can live.
+     */
+    public int getMaxAge()
+    {
+        return maxAge;
+    }
+
+    /**
+     * @return (int) The age at which the animal can start to breed.
+     */
+    public int getBreedingAge()
+    {
+        return breedingAge;
+    }
+
+    /**
+     * @return (int) The maximum number of births at once.
+     */
+    public int getMaxLitterSize()
+    {
+        return maxLitterSize;
+    }
+
+    /**
+     * @return (boolean) true if the animal hibernates.
+     */
+    public boolean getHibernates()
+    {
+        return hibernates;
+    }
+
+    /**
+     * @return (boolean) true if the animal is active at night.
+     */
+    public boolean getIsNocturnal()
+    {
+        return isNocturnal;
+    }
+}
