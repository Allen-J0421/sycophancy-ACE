diff --git a/SpeciesTraits.java b/SpeciesTraits.java
new file mode 100644
index 0000000..062b09c
--- /dev/null
+++ b/SpeciesTraits.java
@@ -0,0 +1,83 @@
+/**
+ * An immutable value object holding the intrinsic, unchanging characteristics
+ * shared by every species in the simulation. These traits are fixed for a given
+ * species (they come from the configuration files) and are shared by all of its
+ * individuals, including the ones born through reproduction.
+ *
+ * Grouping these values together keeps the {@link Species} constructor (and those
+ * of its subclasses) small and readable, and gives reproduction a single object
+ * to pass on to offspring instead of a long list of arguments.
+ *
+ * @version 2022.02.28
+ */
+public class SpeciesTraits
+{
+    // The species' name.
+    private final String name;
+    // The maximum temperature at which the species can survive.
+    private final int maximumTemperature;
+    // The minimum temperature at which the species can survive.
+    private final int minimumTemperature;
+    // The food value the species provides when eaten.
+    private final int nutritionalValue;
+    // The likelihood of the species to reproduce.
+    private final double reproductionProbability;
+
+    /**
+     * Create an immutable set of base species traits.
+     *
+     * @param name (String) The name of the species.
+     * @param maximumTemperature (int) The maximum temperature the species can withstand.
+     * @param minimumTemperature (int) The minimum temperature the species can withstand.
+     * @param nutritionalValue (int) The nutritional value given to whatever eats this species.
+     * @param reproductionProbability (double) The probability that this species reproduces.
+     */
+    public SpeciesTraits(String name, int maximumTemperature, int minimumTemperature, int nutritionalValue, double reproductionProbability)
+    {
+        this.name = name;
+        this.maximumTemperature = maximumTemperature;
+        this.minimumTemperature = minimumTemperature;
+        this.nutritionalValue = nutritionalValue;
+        this.reproductionProbability = reproductionProbability;
+    }
+
+    /**
+     * @return (String) The species' name.
+     */
+    public String getName()
+    {
+        return name;
+    }
+
+    /**
+     * @return (int) The maximum temperature the species can survive to.
+     */
+    public int getMaximumTemperature()
+    {
+        return maximumTemperature;
+    }
+
+    /**
+     * @return (int) The minimum temperature the species can survive to.
+     */
+    public int getMinimumTemperature()
+    {
+        return minimumTemperature;
+    }
+
+    /**
+     * @return (int) The species' nutritional value.
+     */
+    public int getNutritionalValue()
+    {
+        return nutritionalValue;
+    }
+
+    /**
+     * @return (double) The species' reproduction probability.
+     */
+    public double getReproductionProbability()
+    {
+        return reproductionProbability;
+    }
+}
