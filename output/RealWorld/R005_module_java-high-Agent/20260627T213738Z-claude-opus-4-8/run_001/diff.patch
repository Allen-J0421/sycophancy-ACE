diff --git a/AnimalTraits.java b/AnimalTraits.java
new file mode 100644
index 0000000..6da6691
--- /dev/null
+++ b/AnimalTraits.java
@@ -0,0 +1,93 @@
+/**
+ * An immutable value object bundling the characteristics that define a kind of
+ * {@link Animal}, on top of the shared {@link SpeciesTraits}.
+ *
+ * It carries everything needed to recreate an animal of the same species, which
+ * lets an animal hand its full specification to its offspring during
+ * reproduction instead of threading a dozen arguments through every call.
+ *
+ * @version 2022.03.01
+ */
+public class AnimalTraits
+{
+    // The species-level characteristics shared with every other species.
+    private final SpeciesTraits speciesTraits;
+    // The age to which an animal of this kind can live.
+    private final int maxAge;
+    // The age at which an animal of this kind can start to breed.
+    private final int breedingAge;
+    // The maximum number of births at once.
+    private final int maxLitterSize;
+    // true if animals of this kind hibernate during cold temperatures.
+    private final boolean hibernates;
+    // true if animals of this kind are active at night.
+    private final boolean isNocturnal;
+
+    /**
+     * Bundle the characteristics of a kind of animal.
+     *
+     * @param speciesTraits (SpeciesTraits) The shared species-level characteristics.
+     * @param maxAge (int) The animal's life expectancy.
+     * @param breedingAge (int) The age at which the animal can start to reproduce.
+     * @param maxLitterSize (int) The maximum number of children in one reproduction.
+     * @param hibernates (boolean) Whether the animal is able to hibernate.
+     * @param isNocturnal (boolean) Whether the animal is more active at night.
+     */
+    public AnimalTraits(SpeciesTraits speciesTraits, int maxAge, int breedingAge, int maxLitterSize, boolean hibernates, boolean isNocturnal)
+    {
+        this.speciesTraits = speciesTraits;
+        this.maxAge = maxAge;
+        this.breedingAge = breedingAge;
+        this.maxLitterSize = maxLitterSize;
+        this.hibernates = hibernates;
+        this.isNocturnal = isNocturnal;
+    }
+
+    /**
+     * @return (SpeciesTraits) The shared species-level characteristics.
+     */
+    public SpeciesTraits getSpeciesTraits()
+    {
+        return speciesTraits;
+    }
+
+    /**
+     * @return (int) The maximum age to which the animal can live.
+     */
+    public int getMaxAge()
+    {
+        return maxAge;
+    }
+
+    /**
+     * @return (int) The age at which the animal can start to breed.
+     */
+    public int getBreedingAge()
+    {
+        return breedingAge;
+    }
+
+    /**
+     * @return (int) The maximum number of births at once.
+     */
+    public int getMaxLitterSize()
+    {
+        return maxLitterSize;
+    }
+
+    /**
+     * @return (boolean) true if the animal hibernates.
+     */
+    public boolean getHibernates()
+    {
+        return hibernates;
+    }
+
+    /**
+     * @return (boolean) true if the animal is active at night.
+     */
+    public boolean getIsNocturnal()
+    {
+        return isNocturnal;
+    }
+}
