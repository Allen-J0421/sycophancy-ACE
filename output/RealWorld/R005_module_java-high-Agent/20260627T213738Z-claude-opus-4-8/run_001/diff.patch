+/**
+ * An immutable value object bundling the characteristics that define a kind of
+ * {@link Predator}, on top of the {@link AnimalTraits} every animal shares.
+ *
+ * @version 2022.03.01
+ */
+public class PredatorTraits
+{
+    // The animal-level characteristics shared with every other animal.
+    private final AnimalTraits animalTraits;
+    // The predator's strength, used to resolve horde attacks.
+    private final int strength;
+
+    /**
+     * Bundle the characteristics of a kind of predator.
+     *
+     * @param animalTraits (AnimalTraits) The shared animal-level characteristics.
+     * @param strength (int) The predator's strength.
+     */
+    public PredatorTraits(AnimalTraits animalTraits, int strength)
+    {
+        this.animalTraits = animalTraits;
+        this.strength = strength;
+    }
+
+    /**
+     * @return (AnimalTraits) The shared animal-level characteristics.
+     */
+    public AnimalTraits getAnimalTraits()
+    {
+        return animalTraits;
+    }
+
+    /**
+     * @return (int) The predator's strength.
+     */
+    public int getStrength()
+    {
+        return strength;
+    }
+}
