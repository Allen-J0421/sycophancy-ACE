+    /**
+     * A loaded animal template that can create one of the requested simulation species.
+     */
+    private static final class AnimalTemplate
+    {
+        private final String name;
+        private final int maximumTemperature;
+        private final int minimumTemperature;
+        private final int nutritionalValue;
+        private final double breedingProbability;
+        private final int maximumAge;
+        private final int breedingAge;
+        private final int maxLitterSize;
+        private final boolean hibernates;
+        private final boolean nocturnal;
+        private final boolean predator;
+        private final int strength;
+
+        private AnimalTemplate(String name, int maximumTemperature, int minimumTemperature, int nutritionalValue, double breedingProbability, int maximumAge, int breedingAge, int maxLitterSize, boolean hibernates, boolean nocturnal, boolean predator, int strength)
+        {
+            this.name = name;
+            this.maximumTemperature = maximumTemperature;
+            this.minimumTemperature = minimumTemperature;
+            this.nutritionalValue = nutritionalValue;
+            this.breedingProbability = breedingProbability;
+            this.maximumAge = maximumAge;
+            this.breedingAge = breedingAge;
+            this.maxLitterSize = maxLitterSize;
+            this.hibernates = hibernates;
+            this.nocturnal = nocturnal;
+            this.predator = predator;
+            this.strength = strength;
+        }
+
+        /**
+         * Load an animal template from the current reader state.
+         *
+         * @param reader the animal CSV reader.
+         * @return the created template.
+         */
+        private static AnimalTemplate from(AnimalCSVReader reader)
+        {
+            return new AnimalTemplate(reader.getName(), reader.getMaximumTemperature(), reader.getMinimumTemperature(), reader.getNutritionalValue(), reader.getBreedingProbability(), reader.getMaximumAge(), reader.getBreedingAge(), reader.getMaxLitterSize(), reader.canHibernate(), reader.isNocturnal(), reader.isPredator(), reader.getStrength());
+        }
+
+        /**
+         * Create a species instance from this template.
+         *
+         * @param field the simulation field.
+         * @param location the location where the species will be placed.
+         * @return the created species.
+         */
+        private Species createSpecies(Field field, Location location)
+        {
+            if (predator) {
+                return new Predator(strength, field, location, name, maximumTemperature, minimumTemperature, nutritionalValue, breedingProbability, maximumAge, breedingAge, maxLitterSize, RANDOM_ANIMAL_AGE, hibernates, nocturnal);
+            }
+            return new Animal(field, location, name, maximumTemperature, minimumTemperature, nutritionalValue, breedingProbability, maximumAge, breedingAge, maxLitterSize, RANDOM_ANIMAL_AGE, hibernates, nocturnal);
+        }
+
+        /**
+         * @return the species name.
+         */
+        private String getName()
+        {
+            return name;
+        }
     }
