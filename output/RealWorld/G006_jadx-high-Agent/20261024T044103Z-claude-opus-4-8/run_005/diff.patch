+	/**
+	 * Appends the qualifier suffix mapped to {@code key}, if the table contains one.
+	 * A missing key appends nothing, matching the original {@code switch} statements where
+	 * unmatched values simply fell through.
+	 */
+	private static void appendMapped(StringBuilder sb, Map<Integer, String> names, int key) {
+		String suffix = names.get(key);
+		if (suffix != null) {
+			sb.append(suffix);
+		}
+	}
+
+	/**
+	 * Builds a lookup table from alternating ({@code int} key, {@code String} value) pairs.
+	 * Keys may be any numeric constant (byte/short/int); they are normalized to {@link Integer}.
+	 */
+	private static Map<Integer, String> names(Object... keyValuePairs) {
+		Map<Integer, String> map = new HashMap<>(keyValuePairs.length);
+		for (int i = 0; i < keyValuePairs.length; i += 2) {
+			map.put(((Number) keyValuePairs[i]).intValue(), (String) keyValuePairs[i + 1]);
+		}
+		return map;
+	}
+
