diff --git a/jadx-core/src/test/java/jadx/core/xmlgen/XmlGenUtilsTest.java b/jadx-core/src/test/java/jadx/core/xmlgen/XmlGenUtilsTest.java
new file mode 100644
index 000000000..7e4b0838d
--- /dev/null
+++ b/jadx-core/src/test/java/jadx/core/xmlgen/XmlGenUtilsTest.java
@@ -0,0 +1,166 @@
+package jadx.core.xmlgen;
+
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Nested;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Characterization tests for the pure value-decoding helpers in {@link XmlGenUtils}.
+ * <p>
+ * They pin down the <b>current</b> output so the logic can be refactored for readability without
+ * changing behavior. Values that look like magic numbers are packed Android {@code TYPE_DIMENSION}/
+ * {@code TYPE_FRACTION} complex ints; the layout is:
+ *
+ * <pre>
+ *   bits 0-3  : unit type     (COMPLEX_UNIT_MASK)
+ *   bits 4-5  : radix         (COMPLEX_RADIX_SHIFT / COMPLEX_RADIX_MASK)
+ *   bits 8-31 : mantissa      (COMPLEX_MANTISSA_MASK &lt;&lt; COMPLEX_MANTISSA_SHIFT)
+ * </pre>
+ */
+class XmlGenUtilsTest {
+
+	@Nested
+	@DisplayName("decodeComplex - dimensions")
+	class DecodeDimension {
+		// mantissa 0x1000 (=4096) with radix 0 (mult 1/256) -> 16.0
+		@Test
+		void pixels() {
+			assertThat(XmlGenUtils.decodeComplex(0x1000, false)).isEqualTo("16px");
+		}
+
+		@Test
+		void dip() {
+			assertThat(XmlGenUtils.decodeComplex(0x1001, false)).isEqualTo("16dp");
+		}
+
+		@Test
+		void sp() {
+			assertThat(XmlGenUtils.decodeComplex(0x1002, false)).isEqualTo("16sp");
+		}
+
+		@Test
+		void points() {
+			assertThat(XmlGenUtils.decodeComplex(0x1003, false)).isEqualTo("16pt");
+		}
+
+		@Test
+		void inches() {
+			assertThat(XmlGenUtils.decodeComplex(0x1004, false)).isEqualTo("16in");
+		}
+
+		@Test
+		void millimeters() {
+			assertThat(XmlGenUtils.decodeComplex(0x1005, false)).isEqualTo("16mm");
+		}
+
+		@Test
+		void unknownDimensionUnit() {
+			assertThat(XmlGenUtils.decodeComplex(0x1007, false)).isEqualTo("16?d7");
+		}
+
+		// mantissa 0x8000 with radix 1 (mult 1/32768) -> 1.0
+		@Test
+		void radixOneGivesFractionalScale() {
+			assertThat(XmlGenUtils.decodeComplex(0x8011, false)).isEqualTo("1dp");
+		}
+
+		// mantissa 0xC000 (=49152) with radix 1 (mult 1/32768) -> 1.5
+		@Test
+		void nonIntegerDimension() {
+			assertThat(XmlGenUtils.decodeComplex(0xC011, false)).isEqualTo("1.5dp");
+		}
+	}
+
+	@Nested
+	@DisplayName("decodeComplex - fractions")
+	class DecodeFraction {
+		// mantissa 0x4000 with radix 1 (mult 1/32768) -> 0.5, *100 -> 50
+		@Test
+		void fraction() {
+			assertThat(XmlGenUtils.decodeComplex(0x4010, true)).isEqualTo("50%");
+		}
+
+		@Test
+		void fractionParent() {
+			assertThat(XmlGenUtils.decodeComplex(0x4011, true)).isEqualTo("50%p");
+		}
+
+		@Test
+		void unknownFractionUnit() {
+			assertThat(XmlGenUtils.decodeComplex(0x4015, true)).isEqualTo("50?f5");
+		}
+	}
+
+	@Nested
+	@DisplayName("doubleToString / floatToString")
+	class NumberFormatting {
+		@Test
+		void integerValueHasNoDecimals() {
+			assertThat(XmlGenUtils.doubleToString(16.0)).isEqualTo("16");
+		}
+
+		@Test
+		void zero() {
+			assertThat(XmlGenUtils.doubleToString(0.0)).isEqualTo("0");
+		}
+
+		@Test
+		void simpleFraction() {
+			assertThat(XmlGenUtils.doubleToString(1.5)).isEqualTo("1.5");
+		}
+
+		@Test
+		void roundsToFourFractionDigits() {
+			assertThat(XmlGenUtils.doubleToString(1.23456)).isEqualTo("1.2346");
+		}
+
+		@Test
+		void largeFractionalValueIsGrouped() {
+			assertThat(XmlGenUtils.doubleToString(1234.5)).isEqualTo("1,234.5");
+		}
+
+		@Test
+		void floatDelegatesToDouble() {
+			assertThat(XmlGenUtils.floatToString(1.5f)).isEqualTo("1.5");
+		}
+	}
+
+	@Nested
+	@DisplayName("getAttrTypeAsString")
+	class AttrType {
+		// ATTR_TYPE flags: reference=1, string=2, integer=4, boolean=8,
+		// color=16, float=32, dimension=64, fraction=128
+		@Test
+		void noFlagsReturnsNull() {
+			assertThat(XmlGenUtils.getAttrTypeAsString(0)).isNull();
+		}
+
+		@Test
+		void unrelatedHighBitsReturnNull() {
+			assertThat(XmlGenUtils.getAttrTypeAsString(0x100)).isNull();
+		}
+
+		@Test
+		void singleFlag() {
+			assertThat(XmlGenUtils.getAttrTypeAsString(1)).isEqualTo("reference");
+		}
+
+		@Test
+		void twoFlagsKeepDeclaredOrder() {
+			assertThat(XmlGenUtils.getAttrTypeAsString(1 | 2)).isEqualTo("reference|string");
+		}
+
+		@Test
+		void colorAndFloat() {
+			assertThat(XmlGenUtils.getAttrTypeAsString(16 | 32)).isEqualTo("color|float");
+		}
+
+		@Test
+		void allFlags() {
+			assertThat(XmlGenUtils.getAttrTypeAsString(0xFFFF))
+					.isEqualTo("reference|string|integer|boolean|color|float|dimension|fraction");
+		}
+	}
+}
