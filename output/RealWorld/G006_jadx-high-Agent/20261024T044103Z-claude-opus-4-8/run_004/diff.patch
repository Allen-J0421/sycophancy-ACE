+package jadx.core.xmlgen.entry;
+
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Nested;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Characterization tests for {@link EntryConfig#getQualifiers()}.
+ * <p>
+ * These tests pin down the <b>current</b> output of the resource qualifier generation so that it
+ * can
+ * be refactored safely later. They document behavior as-is (including quirks), not necessarily the
+ * behavior that would be ideal; if a refactor intentionally changes output, update the expectation
+ * here deliberately.
+ */
+class EntryConfigTest {
+
+	/**
+	 * Builder for {@link EntryConfig} seeded with "no qualifier" defaults (a modern, 56-byte config
+	 * with no locale). Mirrors how {@code ResTableBinaryParser} constructs configs: empty locale is
+	 * a 2-char array of NUL, and script/variant are {@code null}.
+	 */
+	private static final class Cfg {
+		private short mcc = 0;
+		private short mnc = 0;
+		private char[] language = { '\00', '\00' };
+		private char[] region = { '\00', '\00' };
+		private byte orientation = 0;
+		private byte touchscreen = 0;
+		private int density = 0;
+		private byte keyboard = 0;
+		private byte navigation = 0;
+		private byte inputFlags = 0;
+		private byte grammaticalInflection = 0;
+		private short screenWidth = 0;
+		private short screenHeight = 0;
+		private short sdkVersion = 0;
+		private byte screenLayout = 0;
+		private byte uiMode = 0;
+		private short smallestScreenWidthDp = 0;
+		private short screenWidthDp = 0;
+		private short screenHeightDp = 0;
+		private char[] localeScript = null;
+		private char[] localeVariant = null;
+		private byte screenLayout2 = 0;
+		private byte colorMode = 0;
+		private boolean isInvalid = false;
+		private int size = 56;
+
+		Cfg mcc(int v) {
+			this.mcc = (short) v;
+			return this;
+		}
+
+		Cfg mnc(int v) {
+			this.mnc = (short) v;
+			return this;
+		}
+
+		Cfg language(String v) {
+			this.language = v.toCharArray();
+			return this;
+		}
+
+		Cfg region(String v) {
+			this.region = v.toCharArray();
+			return this;
+		}
+
+		Cfg orientation(byte v) {
+			this.orientation = v;
+			return this;
+		}
+
+		Cfg touchscreen(byte v) {
+			this.touchscreen = v;
+			return this;
+		}
+
+		Cfg density(int v) {
+			this.density = v;
+			return this;
+		}
+
+		Cfg keyboard(byte v) {
+			this.keyboard = v;
+			return this;
+		}
+
+		Cfg navigation(byte v) {
+			this.navigation = v;
+			return this;
+		}
+
+		Cfg inputFlags(byte v) {
+			this.inputFlags = v;
+			return this;
+		}
+
+		Cfg grammaticalInflection(byte v) {
+			this.grammaticalInflection = v;
+			return this;
+		}
+
+		Cfg screenSize(int w, int h) {
+			this.screenWidth = (short) w;
+			this.screenHeight = (short) h;
+			return this;
+		}
+
+		Cfg sdkVersion(int v) {
+			this.sdkVersion = (short) v;
+			return this;
+		}
+
+		Cfg screenLayout(int v) {
+			this.screenLayout = (byte) v;
+			return this;
+		}
+
+		Cfg uiMode(int v) {
+			this.uiMode = (byte) v;
+			return this;
+		}
+
+		Cfg smallestScreenWidthDp(int v) {
+			this.smallestScreenWidthDp = (short) v;
+			return this;
+		}
+
+		Cfg screenWidthDp(int v) {
+			this.screenWidthDp = (short) v;
+			return this;
+		}
+
+		Cfg screenHeightDp(int v) {
+			this.screenHeightDp = (short) v;
+			return this;
+		}
+
+		Cfg screenLayout2(int v) {
+			this.screenLayout2 = (byte) v;
+			return this;
+		}
+
+		Cfg colorMode(int v) {
+			this.colorMode = (byte) v;
+			return this;
+		}
+
+		Cfg invalidOrientation(int v) {
+			// out-of-range value: triggers the isInvalid path inside the constructor
+			this.orientation = (byte) v;
+			return this;
+		}
+
+		Cfg size(int v) {
+			this.size = v;
+			return this;
+		}
+
+		EntryConfig build() {
+			return new EntryConfig(mcc, mnc, language, region, orientation, touchscreen, density,
+					keyboard, navigation, inputFlags, grammaticalInflection, screenWidth, screenHeight,
+					sdkVersion, screenLayout, uiMode, smallestScreenWidthDp, screenWidthDp, screenHeightDp,
+					localeScript, localeVariant, screenLayout2, colorMode, isInvalid, size);
+		}
+
+		String qualifiers() {
+			return build().getQualifiers();
+		}
+	}
+
+	private static Cfg cfg() {
+		return new Cfg();
+	}
+
+	@Test
+	@DisplayName("Empty config produces no qualifiers")
+	void emptyConfig() {
+		EntryConfig config = cfg().build();
+		assertThat(config.getQualifiers()).isEmpty();
+		assertThat(config.toString()).isEqualTo("[DEFAULT]");
+	}
+
+	@Nested
+	@DisplayName("mcc / mnc")
+	class MccMnc {
+		@Test
+		void mccOnly() {
+			assertThat(cfg().mcc(310).qualifiers()).isEqualTo("-mcc310");
+		}
+
+		@Test
+		void mccIsZeroPadded() {
+			assertThat(cfg().mcc(1).qualifiers()).isEqualTo("-mcc001");
+		}
+
+		@Test
+		void mccAndMncModernSize() {
+			// size > 32: mnc is appended verbatim
+			assertThat(cfg().mcc(310).mnc(4).size(56).qualifiers()).isEqualTo("-mcc310-mnc4");
+		}
+
+		@Test
+		void mccAndMncLegacySizeSmallValueIsTwoDigits() {
+			// size <= 32 and 0 < mnc < 10: two-digit padding
+			assertThat(cfg().mcc(310).mnc(4).size(32).qualifiers()).isEqualTo("-mcc310-mnc04");
+		}
+
+		@Test
+		void mccAndMncLegacySizeLargeValueIsThreeDigits() {
+			// size <= 32 and mnc >= 10: three-digit padding
+			assertThat(cfg().mcc(310).mnc(26).size(32).qualifiers()).isEqualTo("-mcc310-mnc026");
+		}
+
+		@Test
+		void mccWithMncZeroSentinel() {
+			// the MNC_ZERO sentinel (-1) means "MNC is explicitly zero" and emits the literal "-mnc00"
+			assertThat(cfg().mcc(310).mnc(EntryConfig.MNC_ZERO).qualifiers()).isEqualTo("-mcc310-mnc00");
+		}
+
+		@Test
+		void mccWithExplicitZeroMnc() {
+			// mnc == 0 means "unset" and emits no mnc segment at all
+			assertThat(cfg().mcc(310).mnc(0).qualifiers()).isEqualTo("-mcc310");
+		}
+
+		@Test
+		void mncWithoutMcc() {
+			assertThat(cfg().mcc(0).mnc(4).qualifiers()).isEqualTo("-mnc4");
+		}
+	}
+
+	@Nested
+	@DisplayName("locale")
+	class Locale {
+		@Test
+		void languageOnly() {
+			assertThat(cfg().language("en").qualifiers()).isEqualTo("-en");
+		}
+
+		@Test
+		void languageAndRegion() {
+			assertThat(cfg().language("en").region("US").qualifiers()).isEqualTo("-en-rUS");
+		}
+
+		@Test
+		void regionWithoutLanguage() {
+			// Quirk: with an empty (NUL-filled) language array the old-style branch still appends the
+			// two NUL language chars before the region. Pinned as-is; a future fix may drop them.
+			assertThat(cfg().region("US").qualifiers()).isEqualTo("-\u0000\u0000-rUS");
+		}
+	}
+
+	@Nested
+	@DisplayName("screen layout / size")
+	class ScreenLayout {
+		@Test
+		void layoutDirectionRtl() {
+			assertThat(cfg().screenLayout(EntryConfig.SCREENLAYOUT_LAYOUTDIR_RTL).qualifiers()).isEqualTo("-ldrtl");
+		}
+
+		@Test
+		void screenSizeNormal() {
+			assertThat(cfg().screenLayout(EntryConfig.SCREENSIZE_NORMAL).qualifiers()).isEqualTo("-normal");
+		}
+
+		@Test
+		void layoutDirectionAndSizeCombine() {
+			int layout = EntryConfig.SCREENLAYOUT_LAYOUTDIR_RTL | EntryConfig.SCREENSIZE_NORMAL;
+			assertThat(cfg().screenLayout(layout).qualifiers()).isEqualTo("-ldrtl-normal");
+		}
+
+		@Test
+		void screenLong() {
+			assertThat(cfg().screenLayout(EntryConfig.SCREENLONG_YES).qualifiers()).isEqualTo("-long");
+		}
+
+		@Test
+		void roundFromScreenLayout2() {
+			assertThat(cfg().screenLayout2(EntryConfig.SCREENLAYOUT_ROUND_YES).qualifiers()).isEqualTo("-round");
+		}
+	}
+
+	@Nested
+	@DisplayName("dp dimensions")
+	class DpDimensions {
+		@Test
+		void smallestWidth() {
+			assertThat(cfg().smallestScreenWidthDp(600).qualifiers()).isEqualTo("-sw600dp");
+		}
+
+		@Test
+		void availableWidthAndHeight() {
+			assertThat(cfg().screenWidthDp(720).screenHeightDp(1024).qualifiers()).isEqualTo("-w720dp-h1024dp");
+		}
+	}
+
+	@Nested
+	@DisplayName("color mode")
+	class ColorMode {
+		@Test
+		void hdrAndWideGamut() {
+			int mode = EntryConfig.COLOR_HDR_YES | EntryConfig.COLOR_WIDE_YES;
+			assertThat(cfg().colorMode(mode).qualifiers()).isEqualTo("-highdr-widecg");
+		}
+	}
+
+	@Nested
+	@DisplayName("orientation / ui mode")
+	class OrientationUiMode {
+		@Test
+		void portrait() {
+			assertThat(cfg().orientation(EntryConfig.ORIENTATION_PORT).qualifiers()).isEqualTo("-port");
+		}
+
+		@Test
+		void uiModeWatchNight() {
+			int mode = EntryConfig.UI_MODE_TYPE_WATCH | EntryConfig.UI_MODE_NIGHT_YES;
+			assertThat(cfg().uiMode(mode).qualifiers()).isEqualTo("-watch-night");
+		}
+
+		@Test
+		void grammaticalGenderFeminine() {
+			assertThat(cfg().grammaticalInflection(EntryConfig.GRAMMATICAL_GENDER_FEMININE).qualifiers())
+					.isEqualTo("-feminine");
+		}
+	}
+
+	@Nested
+	@DisplayName("density")
+	class Density {
+		@Test
+		void defaultDensityEmitsNothing() {
+			assertThat(cfg().density(EntryConfig.DENSITY_DEFAULT).qualifiers()).isEmpty();
+		}
+
+		@Test
+		void highDensity() {
+			assertThat(cfg().density(EntryConfig.DENSITY_HIGH).qualifiers()).isEqualTo("-hdpi");
+		}
+
+		@Test
+		void xxxHighDensity() {
+			assertThat(cfg().density(EntryConfig.DENSITY_XXXHIGH).qualifiers()).isEqualTo("-xxxhdpi");
+		}
+
+		@Test
+		void unknownDensityUsesDpiSuffix() {
+			assertThat(cfg().density(200).qualifiers()).isEqualTo("-200dpi");
+		}
+
+		@Test
+		void anyDensityWithoutSdkVersionHasNoVersionSuffix() {
+			// DENSITY_ANY requires SDK 21, but version suffix is only added when sdkVersion is set
+			assertThat(cfg().density(EntryConfig.DENSITY_ANY).qualifiers()).isEqualTo("-anydpi");
+		}
+
+		@Test
+		void anyDensityWithSufficientSdkVersionAddsVersionSuffix() {
+			assertThat(cfg().density(EntryConfig.DENSITY_ANY).sdkVersion(21).qualifiers()).isEqualTo("-anydpi-v21");
+		}
+	}
+
+	@Nested
+	@DisplayName("input: touchscreen / keyboard / navigation")
+	class Input {
+		@Test
+		void touchscreenFinger() {
+			assertThat(cfg().touchscreen(EntryConfig.TOUCHSCREEN_FINGER).qualifiers()).isEqualTo("-finger");
+		}
+
+		@Test
+		void keyboardQwerty() {
+			assertThat(cfg().keyboard(EntryConfig.KEYBOARD_QWERTY).qualifiers()).isEqualTo("-qwerty");
+		}
+
+		@Test
+		void keysHiddenFlag() {
+			assertThat(cfg().inputFlags(EntryConfig.KEYSHIDDEN_YES).qualifiers()).isEqualTo("-keyshidden");
+		}
+
+		@Test
+		void navHiddenFlag() {
+			assertThat(cfg().inputFlags(EntryConfig.NAVHIDDEN_YES).qualifiers()).isEqualTo("-navhidden");
+		}
+
+		@Test
+		void navigationDpad() {
+			assertThat(cfg().navigation(EntryConfig.NAVIGATION_DPAD).qualifiers()).isEqualTo("-dpad");
+		}
+	}
+
+	@Nested
+	@DisplayName("screen dimensions / sdk version")
+	class DimensionsAndSdk {
+		@Test
+		void screenDimensionsAlwaysLargerFirst() {
+			assertThat(cfg().screenSize(480, 800).qualifiers()).isEqualTo("-800x480");
+			assertThat(cfg().screenSize(800, 480).qualifiers()).isEqualTo("-800x480");
+		}
+
+		@Test
+		void sdkVersionOnly() {
+			assertThat(cfg().sdkVersion(21).qualifiers()).isEqualTo("-v21");
+		}
+	}
+
+	@Nested
+	@DisplayName("ordering and invalid values")
+	class OrderingAndInvalid {
+		@Test
+		@DisplayName("multiple qualifiers are emitted in a fixed order")
+		void combinedOrdering() {
+			String qualifiers = cfg()
+					.mcc(310).mnc(4).size(56)
+					.language("en").region("US")
+					.orientation(EntryConfig.ORIENTATION_PORT)
+					.density(EntryConfig.DENSITY_HIGH)
+					.sdkVersion(21)
+					.qualifiers();
+			assertThat(qualifiers).isEqualTo("-mcc310-mnc4-en-rUS-port-hdpi-v21");
+		}
+
+		@Test
+		@DisplayName("out-of-range values mark the config invalid and append an -ERR suffix")
+		void invalidValueAppendsErrSuffix() {
+			EntryConfig config = cfg().invalidOrientation(5).build();
+			assertThat(config.isInvalid).isTrue();
+			assertThat(config.getQualifiers()).matches(".*-ERR\\d+");
+		}
+	}
+
+	@Nested
+	@DisplayName("equals / hashCode / toString")
+	class ObjectContract {
+		@Test
+		void equalWhenQualifiersMatch() {
+			EntryConfig a = cfg().density(EntryConfig.DENSITY_HIGH).build();
+			EntryConfig b = cfg().density(EntryConfig.DENSITY_HIGH).build();
+			assertThat(a).isEqualTo(b);
+			assertThat(a).hasSameHashCodeAs(b);
+		}
+
+		@Test
+		void notEqualWhenQualifiersDiffer() {
+			EntryConfig a = cfg().density(EntryConfig.DENSITY_HIGH).build();
+			EntryConfig b = cfg().density(EntryConfig.DENSITY_LOW).build();
+			assertThat(a).isNotEqualTo(b);
+		}
+
+		@Test
+		void toStringShowsQualifiers() {
+			assertThat(cfg().density(EntryConfig.DENSITY_HIGH).build().toString()).isEqualTo("-hdpi");
+		}
+	}
+}
