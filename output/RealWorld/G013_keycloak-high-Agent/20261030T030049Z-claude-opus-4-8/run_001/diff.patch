+    /**
+     * Sleeps for {@code intervalMillis} between fixed-interval retries, doing nothing if the interval
+     * is not positive. If the thread is interrupted while sleeping, the interrupt flag is restored and
+     * a {@link RuntimeException} wrapping the {@link InterruptedException} is thrown, with
+     * {@code pendingFailure} (the failure that triggered this retry) attached as a suppressed throwable.
+     */
+    private static void sleepBetweenAttempts(long intervalMillis, Throwable pendingFailure) {
+        if (intervalMillis <= 0) {
+            return;
+        }
+        try {
+            Thread.sleep(intervalMillis);
+        } catch (InterruptedException ie) {
+            Thread.currentThread().interrupt();
+            ie.addSuppressed(pendingFailure);
+            throw new RuntimeException(ie);
+        }
+    }
