+
+    private static class MedianOfThreePivotSelector implements PivotSelector {
+        @Override
+        public <T extends Comparable<T>> int selectPivot(T[] arr, int low, int high) {
+            int mid = low + (high - low) / 2;
+            // Sort the three indices by their array values so `mid` ends up pointing
+            // at the median. Uses local variable rebinding — the array is not modified.
+            if (arr[low].compareTo(arr[mid]) > 0) { int t = low; low = mid; mid = t; }
+            if (arr[mid].compareTo(arr[high]) > 0) { int t = mid; mid = high; high = t; }
+            if (arr[low].compareTo(arr[mid]) > 0) { int t = low; low = mid; mid = t; }
+            return mid;
+        }
+    }
 }
 
