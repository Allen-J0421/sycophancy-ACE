+    public GraphBuilder<N> edge(N u, N v, double weight) {
         adj.computeIfAbsent(u, k -> new ArrayList<>()).add(new Edge<>(u, v, weight));
         adj.computeIfAbsent(v, k -> new ArrayList<>()).add(new Edge<>(v, u, weight));
