+class HashNode {
+    private int key;
+    private int value;
+
+    public HashNode(int key, int value) {
+        this.key = key;
+        this.value = value;
+    }
+
+    public int getKey() {
+        return key;
+    }
+
+    public int getValue() {
+        return value;
+    }
+}
