ights[i - 1]] + problem.values[i - 1]);\n            }\n        }\n        return dp[problem.capacity];\n    }\n}\n\nclass Knapsack {\n    private final KnapsackStrategy strategy;\n\n    Knapsack(KnapsackStrategy strategy) {\n        this.strategy = strategy;\n    }\n\n    int solve(KnapsackProblem problem) {\n        return strategy.solve(problem);\n    }\n\n    public static void main(String[] args) {\n        KnapsackProblem problem = new KnapsackProblem(4, new int[]{1, 2, 3}, new int[]{4, 5, 1});\n\n        Knapsack knapsack = new Knapsack(new DPKnapsackStrategy());\n        System.out.println(knapsack.solve(problem));\n    }\n}\n","structuredPatch":[{"oldStart":4,"oldLines":6,"newStart":4,"newLines":10,"lines":["     final int[] weights;"," ","     KnapsackProblem(int capacity, int[] values, int[] weights) {","+        if (capacity < 0)","+            throw new IllegalArgumentException(\"Capacity must be non-negative\");","+        if (values.length != weights.length)","+            throw new IllegalArgumentException(\"Values and weights arrays must have equal length\");","         this.capacity = capacity;","         this.values = values;","         this.weights = weights;"]}],"userModified":false,"replaceAll":false}}
