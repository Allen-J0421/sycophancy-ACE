{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_011CcnCqJg8Lvu7goGETkzFz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012TnTePzqmWQ2ks9pQaaaS3","name":"Write","input":{"file_path":"/Users/allenjiang/Documents/ACE-Sycophancy-Codebase-Dataset/_worktrees/029_detect_cycle_directed_graph/src/test/graph/cycle/CycleDetectorTest.java","content":"package graph.cycle;\n\nimport org.junit.jupiter.params.ParameterizedTest;\nimport org.junit.jupiter.params.provider.EnumSource;\n\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\nclass CycleDetectorTest {\n\n    private CycleDetector detector(Algorithm alg) {\n        return CycleDetectorFactory.create(alg);\n    }\n\n    @ParameterizedTest\n    @EnumSource(Algorithm.class)\n    void acyclicGraph(Algorithm alg) {\n        // diamond DAG: 0->1->3, 0->2->3\n        DirectedGraph graph = new DirectedGraph(4);\n        graph.addEdge(0, 1);\n        graph.addEdge(0, 2);\n        graph.addEdge(1, 3);\n        graph.addEdge(2, 3);\n\n        assertFalse(detector(alg).hasCycle(graph));\n    }\n\n    @ParameterizedTest\n    @EnumSource(Algorithm.class)\n    void cyclicGraph(Algorithm alg) {\n        // 0->1->2->0 forms a cycle; 2->3 is a tail\n        DirectedGraph graph = new DirectedGraph(4);\n        graph.addEdge(0, 1);\n        graph.addEdge(1, 2);\n        graph.addEdge(2, 0);\n        graph.addEdge(2, 3);\n\n        assertTrue(detector(alg).hasCycle(graph));\n    }\n\n    @ParameterizedTest\n    @EnumSource(Algorithm.class)\n    void disconnectedGraphWithCycle(Algorithm alg) {\n        // component A: 0->1 (acyclic); component B: 2->3->2 (cyclic)\n        DirectedGraph graph = new DirectedGraph(4);\n        graph.addEdge(0, 1);\n        graph.addEdge(2, 3);\n        graph.addEdge(3, 2);\n\n        assertTrue(detector(alg).hasCycle(graph));\n    }\n\n    @ParameterizedTest\n    @EnumSource(Algorithm.class)\