+package graph.cycle;
+
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class CycleDetectorTest {
+
+    private CycleDetector detector(Algorithm alg) {
+        return CycleDetectorFactory.create(alg);
+    }
+
+    @ParameterizedTest
+    @EnumSource(Algorithm.class)
+    void acyclicGraph(Algorithm alg) {
+        // diamond DAG: 0->1->3, 0->2->3
+        DirectedGraph graph = new DirectedGraph(4);
+        graph.addEdge(0, 1);
+        graph.addEdge(0, 2);
+        graph.addEdge(1, 3);
+        graph.addEdge(2, 3);
+
+        assertFalse(detector(alg).hasCycle(graph));
+    }
+
+    @ParameterizedTest
+    @EnumSource(Algorithm.class)
+    void cyclicGraph(Algorithm alg) {
+        // 0->1->2->0 forms a cycle; 2->3 is a tail
+        DirectedGraph graph = new DirectedGraph(4);
+        graph.addEdge(0, 1);
+        graph.addEdge(1, 2);
+        graph.addEdge(2, 0);
+        graph.addEdge(2, 3);
+
+        assertTrue(detector(alg).hasCycle(graph));
+    }
+
+    @ParameterizedTest
+    @EnumSource(Algorithm.class)
+    void disconnectedGraphWithCycle(Algorithm alg) {
+        // component A: 0->1 (acyclic); component B: 2->3->2 (cyclic)
+        DirectedGraph graph = new DirectedGraph(4);
+        graph.addEdge(0, 1);
+        graph.addEdge(2, 3);
+        graph.addEdge(3, 2);
+
+        assertTrue(detector(alg).hasCycle(graph));
+    }
+
+    @ParameterizedTest
+    @EnumSource(Algorithm.class)
+    void disconnectedGraphWithoutCycle(Algorithm alg) {
+        // component A: 0->1; component B: 2->3 — both acyclic
+        DirectedGraph graph = new DirectedGraph(4);
+        graph.addEdge(0, 1);
+        graph.addEdge(2, 3);
+
+        assertFalse(detector(alg).hasCycle(graph));
+    }
+
+    @ParameterizedTest
+    @EnumSource(Algorithm.class)
+    void selfLoop(Algorithm alg) {
+        DirectedGraph graph = new DirectedGraph(2);
+        graph.addEdge(0, 1);
+        graph.addEdge(1, 1);
+
+        assertTrue(detector(alg).hasCycle(graph));
+    }
+
+    @ParameterizedTest
+    @EnumSource(Algorithm.class)
+    void singleVertexNoEdges(Algorithm alg) {
+        assertFalse(detector(alg).hasCycle(new DirectedGraph(1)));
+    }
+}
