       while (current != null) {\n            int cmp = key.compareTo(current.data);\n            if (cmp == 0) return true;\n            current = cmp > 0 ? current.right : current.left;\n        }\n        return false;\n    }\n\n    @Override\n    public String toString() {\n        StringBuilder sb = new StringBuilder();\n        buildString(root, sb, 0);\n        return sb.toString().stripTrailing();\n    }\n\n    private void buildString(Node<T> node, StringBuilder sb, int depth) {\n        if (node == null) return;\n        buildString(node.right, sb, depth + 1);\n        sb.append(\"    \".repeat(depth)).append(node.data).append(\"\\n\");\n        buildString(node.left, sb, depth + 1);\n    }\n\n    public static void main(String[] args) {\n        BinarySearchTree<Integer> bst = new BinarySearchTree<>();\n        bst.insert(6);\n        bst.insert(2);\n        bst.insert(8);\n        bst.insert(7);\n        bst.insert(9);\n\n        System.out.println(bst.search(7));\n        System.out.println(bst);\n    }\n}\n","structuredPatch":[{"oldStart":27,"oldLines":18,"newStart":27,"newLines":9,"lines":[" ","     @Override","     public String toString() {","-        StringBuilder sb = new StringBuilder();","-        buildString(root, sb, 0);","-        return sb.toString().stripTrailing();","+        return new TreeTraverser<>(root).toVisualString();","     }"," ","-    private void buildString(Node<T> node, StringBuilder sb, int depth) {","-        if (node == null) return;","-        buildString(node.right, sb, depth + 1);","-        sb.append(\"    \".repeat(depth)).append(node.data).append(\"\\n\");","-        buildString(node.left, sb, depth + 1);","-    }","-","     public static void main(String[] args) {","         BinarySearchTree<Integer> bst = new BinarySearchTree<>();","         bst.insert(6);"]}],"userModified":false,"replaceAll":false}}
