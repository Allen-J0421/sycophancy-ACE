pected \" + c.expected() + \" but got \" + actual);\n            }\n            passed++;\n        }\n\n        for (ThrowsCase c : THROWS_CASES) {\n            assertThrows(c.label(), FN, c.base(), c.exp(), c.mod());\n            passed++;\n        }\n\n        System.out.println(\"All \" + passed + \" tests passed.\");\n    }\n\n    private static void assertThrows(String label, PowModFunction fn,\n                                     int base, int exp, int mod) {\n        try {\n            fn.apply(base, exp, mod);\n            throw new AssertionError(\n                label + \": powMod(\" + base + \", \" + exp + \", \" + mod + \")\"\n                + \" expected IllegalArgumentException but no exception was thrown\");\n        } catch (IllegalArgumentException e) {\n            // expected\n        }\n    }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2505,"cache_read_input_tokens":39347,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2505},"output_tokens":34,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6b1c7dfd-707b-47a6-91cd-fb24a00576cb","uuid":"85dbab85-045b-4297-92af-aa447ccb0e8d","request_id":"req_011CcmQZ5zpvKz8xbtGLx5VB"}
