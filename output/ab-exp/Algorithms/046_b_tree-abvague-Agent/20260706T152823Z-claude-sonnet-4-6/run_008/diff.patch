+    },
+    BINARY {
+        public int findFirstGE(BTree.KeyManager storage, int key) {
+            int lo = 0, hi = storage.size();
+            while (lo < hi) {
+                int mid = (lo + hi) >>> 1;
+                if (storage.getKey(mid) < key) lo = mid + 1;
+                else hi = mid;
+            }
+            return lo;
+        }
+    }
