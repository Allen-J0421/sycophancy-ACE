ra(Graph graph, int src) {\n        int V = graph.size();\n\n        PriorityQueue<Node> pq = new PriorityQueue<>(Comparator.comparingInt(Node::dist));\n\n        int[] dist = new int[V];\n        Arrays.fill(dist, Integer.MAX_VALUE);\n\n        dist[src] = 0;\n        pq.offer(new Node(0, src));\n\n        while (!pq.isEmpty()) {\n            Node top = pq.poll();\n            int d = top.dist();\n            int u = top.vertex();\n\n            if (d > dist[u])\n                continue;\n\n            for (Edge edge : graph.neighbors(u)) {\n                int v = edge.to();\n                int w = edge.weight();\n\n                if (dist[u] + w < dist[v]) {\n                    dist[v] = dist[u] + w;\n                    pq.offer(new Node(dist[v], v));\n                }\n            }\n        }\n\n        return Arrays.stream(dist)\n                .boxed()\n                .toList();\n    }\n}\n","numLines":44,"startLine":1,"totalLines":44}}}
