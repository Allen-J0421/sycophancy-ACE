+        }
+        int[] dims = new int[matrices.size() + 1];
+        dims[0] = matrices.get(0).rows();
+        for (int i = 0; i < matrices.size(); i++) {
+            dims[i + 1] = matrices.get(i).cols();
+        }
+        return dims;
+    }
