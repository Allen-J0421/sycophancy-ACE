+    public static <T> void heapSort(T[] arr, int from, int to, Comparator<T> cmp) {
+        if (from < 0 || to > arr.length || from > to)
+            throw new IllegalArgumentException(
+                "Invalid range [" + from + ", " + to + ") for array of length " + arr.length);
