+
+  /** Receives a non-null map key and its converted non-null value from {@link #applyStringMap}. */
+  private interface MapEntryApplier {
+    void apply(String key, String value);
+  }
+
+  /**
+   * Iterates a non-null {@code Map<String, T>}, rejecting null keys, null values, and values that a
+   * {@link Converter} turns into null, then forwards each surviving key/value pair to {@code
+   * applier}. Shared by {@link QueryMap} and {@link FieldMap}; {@code mapName} (e.g. {@code
+   * "Query"}) only shapes the error messages so they stay identical to each caller's wording.
+   */
+  private static <T> void applyStringMap(
+      Method method,
+      int p,
+      Map<String, T> value,
+      String mapName,
+      Converter<T, String> valueConverter,
+      MapEntryApplier applier)
+      throws IOException {
+    for (Map.Entry<String, T> entry : value.entrySet()) {
+      String entryKey = entry.getKey();
+      if (entryKey == null) {
+        throw Utils.parameterError(method, p, mapName + " map contained null key.");
+      }
+      T entryValue = entry.getValue();
+      if (entryValue == null) {
+        throw Utils.parameterError(
+            method, p, mapName + " map contained null value for key '" + entryKey + "'.");
+      }
+
+      String convertedEntryValue = valueConverter.convert(entryValue);
+      if (convertedEntryValue == null) {
+        throw Utils.parameterError(
+            method,
+            p,
+            mapName
+                + " map value '"
+                + entryValue
+                + "' converted to null by "
+                + valueConverter.getClass().getName()
+                + " for key '"
+                + entryKey
+                + "'.");
+      }
+
+      applier.apply(entryKey, convertedEntryValue);
+    }
+  }
 }
