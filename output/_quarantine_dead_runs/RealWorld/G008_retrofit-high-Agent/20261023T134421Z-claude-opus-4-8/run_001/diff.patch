+    /**
+     * Builds a {@link ParameterHandler} for a parameter whose values are serialized through a
+     * {@linkplain Retrofit#stringConverter string converter}, transparently handling {@link
+     * Iterable} and array parameter types in addition to scalar ones. The {@code factory} is
+     * responsible only for constructing the scalar handler from the resolved converter; the
+     * {@code .iterable()}/{@code .array()} wrapping is applied here.
+     */
+    private ParameterHandler<?> parseStringParameter(
+        int p, Type type, Annotation[] annotations, StringParameterHandlerFactory factory) {
+      Class<?> rawParameterType = Utils.getRawType(type);
+      if (Iterable.class.isAssignableFrom(rawParameterType)) {
+        if (!(type instanceof ParameterizedType)) {
+          throw parameterError(
+              method,
+              p,
+              rawParameterType.getSimpleName()
+                  + " must include generic type (e.g., "
+                  + rawParameterType.getSimpleName()
+                  + "<String>)");
+        }
+        ParameterizedType parameterizedType = (ParameterizedType) type;
+        Type iterableType = Utils.getParameterUpperBound(0, parameterizedType);
+        Converter<?, String> converter = retrofit.stringConverter(iterableType, annotations);
+        return factory.create(converter).iterable();
+      } else if (rawParameterType.isArray()) {
+        Class<?> arrayComponentType = boxIfPrimitive(rawParameterType.getComponentType());
+        Converter<?, String> converter = retrofit.stringConverter(arrayComponentType, annotations);
+        return factory.create(converter).array();
+      } else {
+        Converter<?, String> converter = retrofit.stringConverter(type, annotations);
+        return factory.create(converter);
+      }
+    }
+
+    /** Creates the scalar {@link ParameterHandler} for a {@link #parseStringParameter} call. */
+    private interface StringParameterHandlerFactory {
+      ParameterHandler<?> create(Converter<?, String> converter);
+    }
+
     private static Class<?> boxIfPrimitive(Class<?> type) {
       if (boolean.class == type) return Boolean.class;
       if (byte.class == type) return Byte.class;
