+package org.apache.dubbo.common.threadpool.support;
+
+import org.apache.dubbo.common.URL;
+import org.apache.dubbo.common.threadpool.MemorySafeLinkedBlockingQueue;
+import org.apache.dubbo.common.threadpool.ThreadPool;
+
+import java.util.concurrent.BlockingQueue;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.SynchronousQueue;
+
+import static org.apache.dubbo.common.constants.CommonConstants.DEFAULT_THREAD_NAME;
+import static org.apache.dubbo.common.constants.CommonConstants.THREAD_NAME_KEY;
+
+/**
+ * Base class for the standard {@link ThreadPool} implementations, capturing the thread-name resolution
+ * and work-queue selection that would otherwise be copy-pasted across each pool.
+ */
+public abstract class AbstractThreadPool implements ThreadPool {
+
+    /**
+     * Resolve the thread name from the URL, falling back to its attribute and then {@link #DEFAULT_THREAD_NAME}.
+     */
+    protected String getThreadName(URL url) {
+        return url.getParameter(THREAD_NAME_KEY, (String) url.getAttribute(THREAD_NAME_KEY, DEFAULT_THREAD_NAME));
+    }
+
+    /**
+     * Create the work queue backing a pool according to the configured {@code queues} size:
+     * <ul>
+     *     <li>{@code 0} &rarr; a {@link SynchronousQueue} (direct hand-off)</li>
+     *     <li>{@code < 0} &rarr; an unbounded, memory-safe queue</li>
+     *     <li>{@code > 0} &rarr; a bounded {@link LinkedBlockingQueue} of that capacity</li>
+     * </ul>
+     */
+    protected BlockingQueue<Runnable> createBlockingQueue(int queues) {
+        if (queues == 0) {
+            return new SynchronousQueue<>();
+        } else if (queues < 0) {
+            return new MemorySafeLinkedBlockingQueue<>();
+        }
+        return new LinkedBlockingQueue<>(queues);
+    }
+}
