+package org.apache.dubbo.rpc.cluster.merger;
+
+import java.lang.reflect.Array;
+import java.util.function.IntFunction;
+
+/**
+ * Shared helpers for the primitive-array {@link org.apache.dubbo.rpc.cluster.Merger} implementations.
+ *
+ * <p>Java provides no primitive stream for {@code short}, {@code byte}, {@code float}, {@code boolean}
+ * and {@code char}, so those mergers all concatenate their inputs with the same manual length-count /
+ * {@link System#arraycopy} loop. This class captures that loop once.
+ */
+final class ArrayMergers {
+
+    private ArrayMergers() {}
+
+    /**
+     * Concatenate the non-null arrays in {@code items} into a single array allocated by {@code newArray}.
+     *
+     * @param items    the arrays to merge; {@code null} elements are skipped
+     * @param newArray factory that allocates a target array of the given length
+     * @param <A>      the primitive array type (e.g. {@code byte[]})
+     * @return a new array holding the concatenation of all non-null inputs
+     */
+    static <A> A concat(A[] items, IntFunction<A> newArray) {
+        int total = 0;
+        for (A array : items) {
+            if (array != null) {
+                total += Array.getLength(array);
+            }
+        }
+        A result = newArray.apply(total);
+        int index = 0;
+        for (A array : items) {
+            if (array != null) {
+                int length = Array.getLength(array);
+                System.arraycopy(array, 0, result, index, length);
+                index += length;
+            }
+        }
+        return result;
+    }
+}
