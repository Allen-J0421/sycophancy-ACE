+package org.apache.dubbo.remoting.transport.netty4;
+
+import org.apache.dubbo.common.URL;
+import org.apache.dubbo.common.logger.ErrorTypeAwareLogger;
+import org.apache.dubbo.common.logger.LoggerFactory;
+import org.apache.dubbo.remoting.ChannelHandler;
+
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelDuplexHandler;
+import io.netty.channel.ChannelHandlerContext;
+
+import static org.apache.dubbo.common.constants.LoggerCodeConstants.TRANSPORT_UNEXPECTED_EXCEPTION;
+
+/**
+ * Shared base for {@link NettyClientHandler} and {@link NettyServerHandler}.
+ * Holds the common {@code url}/{@code handler} fields, their null-guard constructor,
+ * and the {@link #exceptionCaught} implementation.  Subclasses supply the address-key
+ * ordering used in log messages via {@link #firstAddressKey}/{@link #secondAddressKey}.
+ */
+abstract class AbstractNettyChannelHandler extends ChannelDuplexHandler {
+
+    protected final ErrorTypeAwareLogger logger = LoggerFactory.getErrorTypeAwareLogger(getClass());
+
+    protected final URL url;
+    protected final ChannelHandler handler;
+
+    protected AbstractNettyChannelHandler(URL url, ChannelHandler handler) {
+        if (url == null) {
+            throw new IllegalArgumentException("url == null");
+        }
+        if (handler == null) {
+            throw new IllegalArgumentException("handler == null");
+        }
+        this.url = url;
+        this.handler = handler;
+    }
+
+    /** Returns the left-hand address label used in "connection X of A -> B" log messages. */
+    protected abstract String firstAddressKey(NettyChannel channel);
+
+    /** Returns the right-hand address label used in "connection X of A -> B" log messages. */
+    protected abstract String secondAddressKey(NettyChannel channel);
+
+    @Override
+    public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws Exception {
+        Channel ch = ctx.channel();
+        NettyChannel channel = NettyChannel.getOrAddChannel(ch, url, handler);
+        try {
+            handler.caught(channel, cause);
+        } finally {
+            NettyChannel.removeChannelIfDisconnected(ch);
+        }
+
+        if (logger.isWarnEnabled()) {
+            logger.warn(
+                    TRANSPORT_UNEXPECTED_EXCEPTION,
+                    "",
+                    "",
+                    channel == null
+                            ? String.format("The connection %s has exception.", ch)
+                            : String.format(
+                                    "The connection %s of %s -> %s has exception.",
+                                    ch, firstAddressKey(channel), secondAddressKey(channel)),
+                    cause);
+        }
+    }
+}
