+package org.apache.dubbo.rpc.cluster.router.state;
+
+import org.apache.dubbo.common.URL;
+import org.apache.dubbo.common.config.configcenter.ConfigChangedEvent;
+import org.apache.dubbo.common.config.configcenter.ConfigurationListener;
+import org.apache.dubbo.common.config.configcenter.DynamicConfiguration;
+import org.apache.dubbo.common.utils.StringUtils;
+
+/**
+ * Base class for state routers that listen to dynamic configuration changes.
+ */
+public abstract class AbstractListenableStateRouter<T> extends AbstractStateRouter<T>
+        implements ConfigurationListener {
+
+    private final String ruleKey;
+
+    protected AbstractListenableStateRouter(URL url, String ruleKey) {
+        super(url);
+        this.setForce(false);
+        this.init(ruleKey);
+        this.ruleKey = ruleKey;
+    }
+
+    /** Returns the config-key suffix identifying this router's rule type (e.g. {@code ".condition-router"}). */
+    protected abstract String getRuleSuffix();
+
+    private synchronized void init(String ruleKey) {
+        if (StringUtils.isEmpty(ruleKey)) {
+            return;
+        }
+        String routerKey = ruleKey + getRuleSuffix();
+        this.getRuleRepository().addListener(routerKey, this);
+        String rule = this.getRuleRepository().getRule(routerKey, DynamicConfiguration.DEFAULT_GROUP);
+        if (StringUtils.isNotEmpty(rule)) {
+            this.process(new ConfigChangedEvent(routerKey, DynamicConfiguration.DEFAULT_GROUP, rule));
+        }
+    }
+
+    @Override
+    public void stop() {
+        this.getRuleRepository().removeListener(ruleKey + getRuleSuffix(), this);
+    }
+}
