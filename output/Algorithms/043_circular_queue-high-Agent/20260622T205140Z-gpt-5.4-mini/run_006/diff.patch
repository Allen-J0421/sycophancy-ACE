+@Deprecated
+class myQueue {
+
+    private final CircularQueue<Integer> queue;
+
+    public myQueue(int cap) {
+        this.queue = new CircularQueue<>(cap);
+    }
+
+    public void enqueue(int value) {
+        queue.offer(value);
+    }
+
+    public int dequeue() {
+        Integer value = queue.poll();
+        return value == null ? -1 : value;
+    }
+
+    public int getFront() {
+        return queue.isEmpty() ? -1 : queue.peekFront();
+    }
+
+    public int getRear() {
+        return queue.isEmpty() ? -1 : queue.peekRear();
+    }
+}
