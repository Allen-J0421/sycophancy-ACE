+        private static final class Run {
+            private final int[] source;
+            private final int end;
+            private int index;
+
+            private Run(int[] source, int start, int end) {
+                this.source = source;
+                this.index = start;
+                this.end = end;
+            }
+
+            private boolean hasRemaining() {
+                return index < end;
+            }
+
+            private int peek() {
+                return source[index];
+            }
+
+            private int take() {
+                return source[index++];
+            }
+
+            private int remainingLength() {
+                return end - index;
+            }
+        }
