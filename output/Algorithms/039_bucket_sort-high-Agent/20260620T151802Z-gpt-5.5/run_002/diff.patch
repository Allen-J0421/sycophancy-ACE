+    private static void insertionSort(List<Float> bucket) {
+        for (int i = 1; i < bucket.size(); ++i) {
+            float valueToInsert = bucket.get(i);
+            int insertionIndex = i - 1;
+            while (insertionIndex >= 0 && bucket.get(insertionIndex) > valueToInsert) {
+                bucket.set(insertionIndex + 1, bucket.get(insertionIndex));
+                insertionIndex--;
+            }
+            bucket.set(insertionIndex + 1, valueToInsert);
+        }
+    }
