+     * @param <T>          the element type
+     * @return a new sorted array, or {@code null} if {@code array} is
+     *         {@code null}
+     */
+    public static <T> T[] sorted(T[] array, ToIntFunction<? super T> keyExtractor) {
+        if (array == null) {
