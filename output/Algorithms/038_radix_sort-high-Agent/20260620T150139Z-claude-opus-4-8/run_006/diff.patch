+    /** Stable insertion sort of {@code array} (and parallel {@code keys}) by key. */
+    private static <T> void insertionSortByKey(T[] array, int[] keys, int n) {
+        for (int i = 1; i < n; i++) {
+            T item = array[i];
+            int key = keys[i];
+            int j = i - 1;
+            while (j >= 0 && keys[j] > key) {
+                array[j + 1] = array[j];
+                keys[j + 1] = keys[j];
+                j--;
+            }
+            array[j + 1] = item;
+            keys[j + 1] = key;
+        }
+    }
