+    /** Ascending in-place insertion sort over the first {@code n} elements. */
+    private static void insertionSort(int[] a, int n) {
+        for (int i = 1; i < n; i++) {
+            int key = a[i];
+            int j = i - 1;
+            while (j >= 0 && a[j] > key) {
+                a[j + 1] = a[j];
+                j--;
+            }
+            a[j + 1] = key;
+        }
+    }
