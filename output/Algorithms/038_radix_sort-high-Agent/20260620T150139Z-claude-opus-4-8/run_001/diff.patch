+import java.util.Arrays;
+
+/**
+ * Least-significant-digit (LSD) radix sort for {@code int} arrays.
+ *
+ * <p>This is a stable, non-comparison sort that runs in O(d &middot; n) time,
+ * where {@code n} is the number of elements and {@code d} is the number of
+ * base-10 digits in the value range. It sorts in place.
+ *
+ * <p>Unlike the textbook version, this implementation correctly handles
+ * negative values (including {@link Integer#MIN_VALUE}) and empty arrays.
+ * Negatives are supported by biasing every value into a non-negative
+ * {@code long} range before sorting, then mapping back, which keeps the
+ * digit extraction valid and avoids overflow.
+ *
+ * <p>This class is a stateless utility and cannot be instantiated.
+ */
+public final class RadixSort {
+
+    /** Base for digit extraction. Base 10 keeps the algorithm easy to follow. */
+    private static final int RADIX = 10;
+
+    private RadixSort() {
+        // Utility class: prevent instantiation.
+    }
+
+    /**
+     * Sorts the given array in ascending order, in place.
+     *
+     * @param arr the array to sort; {@code null} and arrays of length &lt; 2
+     *            are left unchanged
+     */
+    public static void sort(int[] arr) {
+        if (arr == null || arr.length < 2) {
+            return;
+        }
+
+        int min = arr[0];
+        int max = arr[0];
+        for (int value : arr) {
+            if (value < min) {
+                min = value;
+            }
+            if (value > max) {
+                max = value;
+            }
+        }
+
+        // All elements equal: already sorted, and the loop below would not run.
+        if (min == max) {
+            return;
+        }
+
+        // Bias values into [0, range] using long arithmetic so that negatives
+        // and the full int range (including Integer.MIN_VALUE) are handled
+        // without overflow. range >= 1 here because min != max.
+        long range = (long) max - (long) min;
+        long[] buffer = new long[arr.length];
+        for (int i = 0; i < arr.length; i++) {
+            buffer[i] = (long) arr[i] - min;
+        }
+
+        long[] output = new long[arr.length];
+        int[] count = new int[RADIX];
+
+        for (long exp = 1; range / exp > 0; exp *= RADIX) {
+            countingSortByDigit(buffer, output, count, exp);
+            // Reuse the arrays by swapping roles instead of copying back.
+            long[] swap = buffer;
+            buffer = output;
+            output = swap;
+        }
+
+        // Map the biased values back to their original int domain.
+        for (int i = 0; i < arr.length; i++) {
+            arr[i] = (int) (buffer[i] + min);
+        }
+    }
+
+    /**
+     * Stable counting sort of {@code buffer} into {@code output} keyed on the
+     * base-10 digit selected by {@code exp} (1, 10, 100, ...).
+     *
+     * @param buffer the values to sort (read from)
+     * @param output destination array, same length as {@code buffer}
+     * @param count  scratch array of size {@link #RADIX}; cleared on entry
+     * @param exp    place value selecting the digit to sort on
+     */
+    private static void countingSortByDigit(long[] buffer, long[] output, int[] count, long exp) {
+        Arrays.fill(count, 0);
+
+        for (long value : buffer) {
+            count[digit(value, exp)]++;
+        }
+
+        // Turn counts into ending positions (prefix sums).
+        for (int d = 1; d < RADIX; d++) {
+            count[d] += count[d - 1];
+        }
+
+        // Walk right-to-left so equal keys keep their relative order (stable).
+        for (int i = buffer.length - 1; i >= 0; i--) {
+            output[--count[digit(buffer[i], exp)]] = buffer[i];
+        }
+    }
+
+    /** Extracts the base-10 digit of {@code value} at place value {@code exp}. */
+    private static int digit(long value, long exp) {
+        return (int) ((value / exp) % RADIX);
+    }
+
+    /**
+     * Returns a sorted copy of {@code arr}, leaving the original untouched.
+     *
+     * @param arr the array to copy and sort; may be {@code null}
+     * @return a new sorted array, or {@code null} if {@code arr} is {@code null}
+     */
+    public static int[] sorted(int[] arr) {
+        if (arr == null) {
+            return null;
+        }
+        int[] copy = Arrays.copyOf(arr, arr.length);
+        sort(copy);
+        return copy;
+    }
+
+    /** Small demonstration. */
+    public static void main(String[] args) {
+        int[] arr = { 170, 45, 75, 90, 802, 24, 2, 66 };
+        System.out.println("before: " + Arrays.toString(arr));
+        sort(arr);
+        System.out.println("after:  " + Arrays.toString(arr));
+
+        int[] withNegatives = { 4, -1, 0, -802, 75, -75, Integer.MIN_VALUE, Integer.MAX_VALUE };
+        System.out.println("mixed:  " + Arrays.toString(RadixSort.sorted(withNegatives)));
+    }
+}
