+        private static void validateAdjacencyMatrix(int[][] graph) {
+            if (graph == null) {
+                throw new IllegalArgumentException("Graph must not be null.");
+            }
+
+            if (graph.length == 0) {
+                throw new IllegalArgumentException("Graph must contain at least one vertex.");
+            }
+
+            for (int rowIndex = 0; rowIndex < graph.length; rowIndex++) {
+                int[] row = graph[rowIndex];
+                if (row == null) {
+                    throw new IllegalArgumentException("Graph rows must not be null.");
+                }
+
+                if (row.length != graph.length) {
+                    throw new IllegalArgumentException("Graph must be a square adjacency matrix.");
+                }
+
+                for (int columnIndex = rowIndex + 1; columnIndex < graph.length; columnIndex++) {
+                    if (row[columnIndex] != graph[columnIndex][rowIndex]) {
+                        throw new IllegalArgumentException(
+                            "Graph must represent an undirected adjacency matrix."
+                        );
+                    }
+                }
+            }
+        }
+    }
+
+    private static final class PrimAlgorithm {
+        private final Graph graph;
+        private final PrimState state;
+
+        PrimAlgorithm(Graph graph) {
+            this.graph = graph;
+            this.state = new PrimState(graph.vertexCount());
+        }
+
+        Result compute() {
+            for (int count = 0; count < graph.vertexCount() - 1; count++) {
+                int currentVertex = state.selectNextVertex();
+
+                if (currentVertex == -1) {
+                    throw new IllegalStateException("Graph must be connected.");
+                }
+
+                includeAndRelax(currentVertex);
+            }
+
+            return state.toResult(graph);
+        }
+
+        private void includeAndRelax(int currentVertex) {
+            state.include(currentVertex);
+            graph.forEachNeighbor(currentVertex,
+                (neighbor, edgeWeight) -> state.updateConnection(neighbor, currentVertex, edgeWeight));
+        }
     }
 
