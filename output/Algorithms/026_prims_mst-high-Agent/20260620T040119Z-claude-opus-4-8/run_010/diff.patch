+    /** A custom edge provider: a triangle 0-1-2 with weights 1, 2, 3 (MST weight 3). */
+    private static PrimsMst.GraphBuilder triangleBuilder() {
+        return new PrimsMst.GraphBuilder() {
+            @Override public int vertexCount() {
+                return 3;
+            }
+            @Override public void provideEdges(EdgeSink sink) {
+                sink.accept(0, 1, 1);
+                sink.accept(1, 2, 2);
+                sink.accept(0, 2, 3);
+            }
+        };
+    }
+
+    private static void graphFromCustomBuilder() {
+        PrimsMst.Graph g = PrimsMst.Graph.from(triangleBuilder());
+        check("Graph.from(custom builder) yields MST weight 3", PrimsMst.compute(g).totalWeight() == 3);
+    }
+
+    private static void computeAcceptsGraphBuilder() {
