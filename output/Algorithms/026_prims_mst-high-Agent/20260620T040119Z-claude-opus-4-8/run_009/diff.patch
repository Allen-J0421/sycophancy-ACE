+        /**
+         * Reads a graph from an edge-list file. See {@link #fromEdgeList(Iterable)} for the
+         * accepted format.
+         *
+         * @throws IOException if the file cannot be read
+         * @throws IllegalArgumentException if {@code path} is null or the content is malformed
+         */
+        static Graph fromEdgeListFile(Path path) throws IOException {
+            if (path == null) {
+                throw new IllegalArgumentException("Path must not be null.");
+            }
+            return fromEdgeList(Files.readAllLines(path));
+        }
+
+        /**
+         * Builds a graph from an edge list given as a sequence of text lines.
+         *
+         * <p>The format is line-oriented:
+         * <ul>
+         *   <li>{@code from to weight} — an undirected edge between two vertex indices with a
+         *       positive integer weight (tokens separated by any whitespace).</li>
+         *   <li>{@code vertices N} — an optional directive fixing the vertex count to {@code N},
+         *       which is how isolated vertices (those in no edge) are represented. It must be at
+         *       least one greater than the largest vertex index referenced.</li>
+         *   <li>A {@code #} starts a comment that runs to the end of the line; blank lines are
+         *       ignored.</li>
+         * </ul>
+         * When no {@code vertices} directive is given, the vertex count is inferred as the
+         * largest referenced index plus one.
+         *
+         * @throws IllegalArgumentException if {@code lines} is null or any line is malformed
+         *                                  (with the offending line number in the message)
+         */
+        static Graph fromEdgeList(Iterable<String> lines) {
+            if (lines == null) {
+                throw new IllegalArgumentException("Edge list must not be null.");
+            }
+            List<int[]> edges = new ArrayList<>();
+            int maxVertex = -1;
+            int declaredCount = -1;
+            int lineNumber = 0;
+            for (String rawLine : lines) {
+                lineNumber++;
+                String line = stripComment(rawLine).strip();
+                if (line.isEmpty()) {
+                    continue;
+                }
+                String[] tokens = line.split("\\s+");
+                if (tokens[0].equalsIgnoreCase("vertices")) {
+                    if (tokens.length != 2) {
+                        throw malformed(lineNumber, "expected 'vertices <count>'");
+                    }
+                    declaredCount = parseIndex(tokens[1], lineNumber, "vertex count");
+                    continue;
+                }
+                if (tokens.length != 3) {
+                    throw malformed(lineNumber, "expected 'from to weight'");
+                }
+                int from = parseIndex(tokens[0], lineNumber, "vertex");
+                int to = parseIndex(tokens[1], lineNumber, "vertex");
+                int weight = parseIndex(tokens[2], lineNumber, "weight");
+                if (weight <= 0) {
+                    throw malformed(lineNumber, "weight must be positive: " + weight);
+                }
+                edges.add(new int[] {from, to, weight});
+                maxVertex = Math.max(maxVertex, Math.max(from, to));
+            }
+
+            int vertexCount = maxVertex + 1;
+            if (declaredCount >= 0) {
+                if (declaredCount < vertexCount) {
+                    throw new IllegalArgumentException("Declared vertex count " + declaredCount
+                        + " is smaller than the highest referenced vertex index " + maxVertex + ".");
+                }
+                vertexCount = declaredCount;
+            }
+
+            Graph graph = new Graph(vertexCount);
+            for (int[] edge : edges) {
+                graph.addEdge(edge[0], edge[1], edge[2]);
+            }
+            return graph;
+        }
+
+        /** Returns {@code line} with any {@code #}-comment removed. */
+        private static String stripComment(String line) {
+            int hash = line.indexOf('#');
+            return hash < 0 ? line : line.substring(0, hash);
+        }
+
+        private static int parseIndex(String token, int lineNumber, String what) {
+            try {
+                int value = Integer.parseInt(token);
+                if (value < 0) {
+                    throw malformed(lineNumber, what + " must not be negative: " + token);
+                }
+                return value;
+            } catch (NumberFormatException e) {
+                throw malformed(lineNumber, "invalid " + what + ": '" + token + "'");
+            }
+        }
+
+        private static IllegalArgumentException malformed(int lineNumber, String detail) {
+            return new IllegalArgumentException("Edge list line " + lineNumber + ": " + detail);
+        }
