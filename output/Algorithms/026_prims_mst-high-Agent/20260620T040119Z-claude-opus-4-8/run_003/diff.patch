+/**
+ * Standalone, dependency-free tests for {@link PrimsMst}.
+ *
+ * <p>This repository compiles each algorithm as a plain {@code .java} file with no build
+ * system, so these tests use a tiny built-in assertion harness rather than JUnit. Run:
+ * <pre>{@code javac prims_mst.java PrimsMstTest.java && java PrimsMstTest}</pre>
+ * The process exits with status 1 if any check fails, so it is usable from CI.
+ */
+public final class PrimsMstTest {
+
+    private static int passed = 0;
+    private static int failed = 0;
+
+    public static void main(String[] args) {
+        knownMatrixMstHasExpectedWeightAndEdges();
+        listBuildMatchesMatrixBuild();
+        resultIsAValidSpanningTree();
+        edgesAreReturnedInNonDecreasingWeightOrder();
+        disconnectedGraphThrows();
+        emptyGraphYieldsNoEdges();
+        singleVertexYieldsNoEdges();
+        nullGraphThrows();
+        nonPositiveWeightThrows();
+        nonSquareMatrixThrows();
+        vertexOutOfRangeThrows();
+
+        System.out.printf("%n%d passed, %d failed%n", passed, failed);
+        if (failed > 0) {
+            System.exit(1);
+        }
+    }
+
+    // --- The sample graph used across several tests; known MST weight is 16. ---
+
+    private static int[][] sampleMatrix() {
+        return new int[][] {
+            { 0, 2, 0, 6, 0 },
+            { 2, 0, 3, 8, 5 },
+            { 0, 3, 0, 0, 7 },
+            { 6, 8, 0, 0, 9 },
+            { 0, 5, 7, 9, 0 },
+        };
+    }
+
+    // --- Tests ---
+
+    private static void knownMatrixMstHasExpectedWeightAndEdges() {
+        PrimsMst.MstResult result = PrimsMst.compute(PrimsMst.Graph.fromAdjacencyMatrix(sampleMatrix()));
+        check("known MST total weight is 16", result.totalWeight() == 16);
+        // The MST of the sample graph is unique: {0-1:2, 1-2:3, 1-4:5, 0-3:6}.
+        check("known MST has 4 edges", result.edges().size() == 4);
+        check("known MST contains edge 0-1 (w=2)", hasEdge(result, 0, 1, 2));
+        check("known MST contains edge 1-2 (w=3)", hasEdge(result, 1, 2, 3));
+        check("known MST contains edge 1-4 (w=5)", hasEdge(result, 1, 4, 5));
+        check("known MST contains edge 0-3 (w=6)", hasEdge(result, 0, 3, 6));
+    }
+
+    private static void listBuildMatchesMatrixBuild() {
+        PrimsMst.Graph g = new PrimsMst.Graph(5);
+        g.addEdge(0, 1, 2);
+        g.addEdge(0, 3, 6);
+        g.addEdge(1, 2, 3);
+        g.addEdge(1, 3, 8);
+        g.addEdge(1, 4, 5);
+        g.addEdge(2, 4, 7);
+        g.addEdge(3, 4, 9);
+        long matrixWeight = PrimsMst.compute(PrimsMst.Graph.fromAdjacencyMatrix(sampleMatrix())).totalWeight();
+        check("adjacency-list build matches matrix build", PrimsMst.compute(g).totalWeight() == matrixWeight);
+    }
+
+    private static void resultIsAValidSpanningTree() {
+        PrimsMst.MstResult result = PrimsMst.compute(PrimsMst.Graph.fromAdjacencyMatrix(sampleMatrix()));
+        int vertexCount = 5;
+        check("spanning tree has V-1 edges", result.edges().size() == vertexCount - 1);
+
+        // A spanning tree must connect every vertex and contain no cycle. With exactly
+        // V-1 edges, "connects all vertices" already implies acyclicity, which we verify
+        // via union-find: every union must merge two previously-distinct components.
+        int[] parent = new int[vertexCount];
+        for (int i = 0; i < vertexCount; i++) {
+            parent[i] = i;
+        }
+        boolean acyclic = true;
+        for (PrimsMst.Edge e : result.edges()) {
+            if (!union(parent, e.from(), e.to())) {
+                acyclic = false;
+            }
+        }
+        check("spanning tree is acyclic", acyclic);
+
+        int root = find(parent, 0);
+        boolean connected = true;
+        for (int v = 1; v < vertexCount; v++) {
+            connected &= find(parent, v) == root;
+        }
+        check("spanning tree connects all vertices", connected);
+    }
+
+    private static void edgesAreReturnedInNonDecreasingWeightOrder() {
+        // Prim's pulls crossing edges from a min-heap, so emitted weights never decrease.
+        PrimsMst.MstResult result = PrimsMst.compute(PrimsMst.Graph.fromAdjacencyMatrix(sampleMatrix()));
+        boolean ordered = true;
+        int previous = Integer.MIN_VALUE;
+        for (PrimsMst.Edge e : result.edges()) {
+            ordered &= e.weight() >= previous;
+            previous = e.weight();
+        }
+        check("MST edges are emitted in non-decreasing weight order", ordered);
+    }
+
+    private static void disconnectedGraphThrows() {
+        PrimsMst.Graph g = new PrimsMst.Graph(3);
+        g.addEdge(0, 1, 1); // vertex 2 is isolated
+        expectThrows("disconnected graph throws", IllegalArgumentException.class,
+            () -> PrimsMst.compute(g));
+    }
+
+    private static void emptyGraphYieldsNoEdges() {
+        PrimsMst.MstResult result = PrimsMst.compute(new PrimsMst.Graph(0));
+        check("empty graph has no edges", result.edges().isEmpty());
+        check("empty graph has zero weight", result.totalWeight() == 0L);
+    }
+
+    private static void singleVertexYieldsNoEdges() {
+        PrimsMst.MstResult result = PrimsMst.compute(new PrimsMst.Graph(1));
+        check("single-vertex graph has no edges", result.edges().isEmpty());
+        check("single-vertex graph has zero weight", result.totalWeight() == 0L);
+    }
+
+    private static void nullGraphThrows() {
+        expectThrows("null graph throws", IllegalArgumentException.class,
+            () -> PrimsMst.compute(null));
+    }
+
+    private static void nonPositiveWeightThrows() {
+        expectThrows("zero/negative edge weight throws", IllegalArgumentException.class,
+            () -> new PrimsMst.Graph(2).addEdge(0, 1, 0));
+    }
+
+    private static void nonSquareMatrixThrows() {
+        int[][] ragged = { { 0, 1 }, { 1 } };
+        expectThrows("non-square matrix throws", IllegalArgumentException.class,
+            () -> PrimsMst.Graph.fromAdjacencyMatrix(ragged));
+    }
+
+    private static void vertexOutOfRangeThrows() {
+        expectThrows("out-of-range vertex throws", IndexOutOfBoundsException.class,
+            () -> new PrimsMst.Graph(2).addEdge(0, 5, 1));
+    }
+
+    // --- Assertion harness ---
+
+    private static void check(String name, boolean condition) {
+        if (condition) {
+            passed++;
+            System.out.println("  PASS: " + name);
+        } else {
+            failed++;
+            System.out.println("  FAIL: " + name);
+        }
+    }
+
+    private static void expectThrows(String name, Class<? extends Throwable> expected, Runnable action) {
+        try {
+            action.run();
+            failed++;
+            System.out.println("  FAIL: " + name + " (no exception thrown)");
+        } catch (Throwable thrown) {
+            boolean ok = expected.isInstance(thrown);
+            check(name + (ok ? "" : " (got " + thrown.getClass().getSimpleName() + ")"), ok);
+        }
+    }
+
+    // --- Helpers ---
+
+    private static boolean hasEdge(PrimsMst.MstResult result, int a, int b, int weight) {
+        for (PrimsMst.Edge e : result.edges()) {
+            boolean sameEndpoints = (e.from() == a && e.to() == b) || (e.from() == b && e.to() == a);
+            if (sameEndpoints && e.weight() == weight) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static int find(int[] parent, int x) {
+        while (parent[x] != x) {
+            parent[x] = parent[parent[x]];
+            x = parent[x];
+        }
+        return x;
+    }
+
+    /** Unions the sets of {@code a} and {@code b}; returns false if they were already joined. */
+    private static boolean union(int[] parent, int a, int b) {
+        int ra = find(parent, a);
+        int rb = find(parent, b);
+        if (ra == rb) {
+            return false;
+        }
+        parent[ra] = rb;
+        return true;
+    }
+
+    private PrimsMstTest() {
+        // Test entry point only.
+    }
+}
