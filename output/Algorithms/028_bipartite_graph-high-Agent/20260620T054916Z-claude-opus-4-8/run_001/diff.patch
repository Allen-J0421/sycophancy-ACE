new file mode 100644
index 0000000..d710f00
--- /dev/null
+++ b/bipartite/GraphInputValidator.java
@@ -0,0 +1,39 @@
+package bipartite;
+
+import java.util.List;
+
+/**
+ * Validates the inputs used to build an {@link UndirectedGraph}, failing fast
+ * with descriptive messages instead of surfacing low-level errors (such as
+ * array index exceptions) deep inside graph construction.
+ */
+final class GraphInputValidator {
+
+    private GraphInputValidator() {
+    }
+
+    /**
+     * @param order the number of vertices; vertices are {@code [0, order)}
+     * @param edges the edges to be added to the graph
+     * @throws IllegalArgumentException if the order is negative, the edge list
+     *                                  is null, or any edge references a vertex
+     *                                  outside {@code [0, order)}
+     */
+    static void validate(int order, List<Edge> edges) {
+        if (order < 0) {
+            throw new IllegalArgumentException("Vertex count must be non-negative, got " + order);
+        }
+        if (edges == null) {
+            throw new IllegalArgumentException("Edge list must not be null");
+        }
+        for (Edge edge : edges) {
+            if (edge == null) {
+                throw new IllegalArgumentException("Edge list must not contain null edges");
+            }
+            if (edge.u() >= order || edge.v() >= order) {
+                throw new IllegalArgumentException(
+                        "Edge " + edge + " references a vertex outside the range [0, " + order + ")");
+            }
+        }
+    }
+}
