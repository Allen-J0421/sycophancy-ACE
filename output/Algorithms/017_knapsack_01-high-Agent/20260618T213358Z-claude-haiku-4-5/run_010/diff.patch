+class SolverRecommendation {
+    enum Criterion { SPEED, VALUE, BALANCED }
+
+    private final List<Solution> solutions;
+    private final ProblemClassifier classifier;
+
+    SolverRecommendation(List<Solution> solutions, Problem problem) {
+        this.solutions = solutions;
+        this.classifier = new ProblemClassifier(problem);
+    }
+
+    String getRecommendation() {
+        Criterion criterion = selectCriterion();
+        return findBest(criterion);
+    }
+
+    private Criterion selectCriterion() {
+        return switch (classifier.classify()) {
+            case TRIVIAL, EASY -> Criterion.SPEED;
+            case MEDIUM -> Criterion.BALANCED;
+            case HARD, VERY_HARD -> Criterion.VALUE;
+        };
+    }
+
+    private String findBest(Criterion criterion) {
+        return switch (criterion) {
+            case SPEED -> solutions.stream()
+                .min(Comparator.comparingLong(s -> s.executionTimeNanos))
+                .map(s -> s.solverName).orElse("Unknown");
+            case VALUE -> solutions.stream()
+                .max(Comparator.comparingInt(s -> s.maxValue))
+                .map(s -> s.solverName).orElse("Unknown");
+            case BALANCED -> {
+                PerformanceMetrics best = solutions.stream()
+                    .map(PerformanceMetrics::new)
+                    .max(Comparator.comparingDouble(PerformanceMetrics::getEfficiency))
+                    .orElse(null);
+                yield best != null ? best.solverName : "Unknown";
+            }
+        };
+    }
+
+    void report() {
+        Criterion criterion = selectCriterion();
+        String recommended = findBest(criterion);
+        System.out.printf("\n=== Recommendation ===");
+        System.out.printf("\nProblem Difficulty: %s%n", classifier.classify());
+        System.out.printf("Selection Criterion: %s%n", criterion);
+        System.out.printf("Recommended Solver: %s%n", recommended);
+    }
+}
