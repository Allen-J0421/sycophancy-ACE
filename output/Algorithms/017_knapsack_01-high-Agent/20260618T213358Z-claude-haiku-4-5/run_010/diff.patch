+class ResultArchive {
+    static class ArchiveEntry {
+        final long timestamp;
+        final Problem problem;
+        final List<Solution> solutions;
+        final ProblemDifficulty difficulty;
+
+        ArchiveEntry(Problem problem, List<Solution> solutions, ProblemDifficulty difficulty) {
+            this.timestamp = System.currentTimeMillis();
+            this.problem = problem;
+            this.solutions = new ArrayList<>(solutions);
+            this.difficulty = difficulty;
+        }
+
+        void summarize() {
+            int maxValue = solutions.stream().mapToInt(s -> s.maxValue).max().orElse(0);
+            long minTime = solutions.stream().mapToLong(s -> s.executionTimeNanos).min().orElse(0);
+            System.out.printf("[%d] Problem(%d items, cap=%d): value=%d, fastest=%.2fμs%n",
+                timestamp, problem.items.size(), problem.capacity, maxValue, minTime / 1000.0);
+        }
+    }
+
+    private static final List<ArchiveEntry> archive = new ArrayList<>();
+
+    static void archive(Problem problem, List<Solution> solutions, ProblemDifficulty difficulty) {
+        archive.add(new ArchiveEntry(problem, solutions, difficulty));
+    }
+
+    static void printArchive() {
+        System.out.println("\n=== Result Archive ===");
+        if (archive.isEmpty()) {
+            System.out.println("No results archived");
+            return;
+        }
+        archive.forEach(ArchiveEntry::summarize);
+    }
+
+    static int getArchiveSize() {
+        return archive.size();
+    }
+}
