+class PerformanceProfile {
+    private final Map<String, List<Long>> solverTimes = new HashMap<>();
+    private final Map<String, Integer> solverValues = new HashMap<>();
+
+    void record(Solution solution) {
+        solverTimes.computeIfAbsent(solution.solverName, k -> new ArrayList<>())
+            .add(solution.executionTimeNanos);
+        solverValues.put(solution.solverName, solution.maxValue);
+    }
+
+    double getAverageTime(String solverName) {
+        List<Long> times = solverTimes.get(solverName);
+        if (times == null || times.isEmpty()) return 0;
+        return times.stream().mapToLong(Long::longValue).average().orElse(0) / 1000.0;
+    }
+
+    String getFastest() {
+        return solverTimes.entrySet().stream()
+            .min(Comparator.comparingDouble(e -> e.getValue().stream().mapToLong(Long::longValue).average().orElse(0)))
+            .map(Map.Entry::getKey)
+            .orElse("Unknown");
+    }
+
+    void report() {
+        System.out.println("\n=== Performance Profile ===");
+        solverTimes.forEach((name, times) ->
+            System.out.printf("%s: runs=%d, avg=%.2fμs, value=%d%n",
+                name, times.size(), times.stream().mapToLong(Long::longValue).average().orElse(0) / 1000.0,
+                solverValues.get(name)));
+    }
+}
