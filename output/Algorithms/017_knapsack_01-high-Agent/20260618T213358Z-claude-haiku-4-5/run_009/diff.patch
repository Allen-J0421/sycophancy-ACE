+class SolverCommandQueue {
+    private final List<SolverCommand> commands = new ArrayList<>();
+
+    void enqueue(SolverCommand command) {
+        commands.add(command);
+    }
+
+    List<Solution> executeAll(String... solverNames) {
+        List<Solution> results = new ArrayList<>();
+        for (String name : solverNames) {
+            KnapsackSolver solver = SolverRegistry.create(name);
+            for (SolverCommand cmd : commands) {
+                if (cmd instanceof SolverInvocation inv) {
+                    results.add(inv.execute());
+                }
+            }
+        }
+        return results;
+    }
