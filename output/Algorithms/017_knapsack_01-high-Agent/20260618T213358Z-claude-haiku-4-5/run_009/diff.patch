+class AdaptiveSolver extends BaseSolver {
+    private final SolverSelector chain;
+
+    AdaptiveSolver() {
+        TrivialSelector trivial = new TrivialSelector();
+        LargeScaleSelector large = new LargeScaleSelector();
+        DefaultSelector def = new DefaultSelector();
+
+        trivial.setNext(large);
+        large.setNext(def);
+        this.chain = trivial;
+    }
+
+    @Override
+    public String getName() { return "Adaptive"; }
+
+    @Override
+    public Solution solve(Problem problem) {
+        return executeSafely(problem, p -> {
+            ProblemClassifier classifier = new ProblemClassifier(p);
+            KnapsackSolver chosen = chain.select(classifier);
