+    private static void test(String name, TestCase testCase) {
+        testsRun++;
+        try {
+            testCase.run();
+            System.out.println("✓ " + name);
+            testsPassed++;
+        } catch (AssertionError e) {
+            System.out.println("✗ " + name + ": " + e.getMessage());
+        } catch (Exception e) {
+            System.out.println("✗ " + name + ": " + e.getClass().getSimpleName());
+        }
+    }
