diff --git a/BinarySearch.java b/BinarySearch.java
new file mode 100644
index 0000000..b606e83
--- /dev/null
+++ b/BinarySearch.java
@@ -0,0 +1,18 @@
+class BinarySearch {
+    public static int search(int[] arr, int target) {
+        int low = 0, high = arr.length - 1;
+        while (low <= high) {
+            int mid = low + (high - low) / 2;
+
+            if (arr[mid] == target)
+                return mid;
+
+            if (arr[mid] < target)
+                low = mid + 1;
+            else
+                high = mid - 1;
+        }
+
+        return -1;
+    }
+}
diff --git a/BinarySearchDemo.java b/BinarySearchDemo.java
new file mode 100644
index 0000000..9121e67
--- /dev/null
+++ b/BinarySearchDemo.java
@@ -0,0 +1,11 @@
+class BinarySearchDemo {
+    public static void main(String[] args) {
+        int[] arr = { 2, 3, 4, 10, 40 };
+        int target = 10;
+        int result = BinarySearch.search(arr, target);
+        if (result == -1)
+            System.out.println("Element is not present in array");
+        else
+            System.out.println("Element is present at index " + result);
+    }
+}
