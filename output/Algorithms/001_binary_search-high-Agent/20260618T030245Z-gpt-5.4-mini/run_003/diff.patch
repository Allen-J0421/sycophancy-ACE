+    private static <T> int binarySearch(T[] array, T target, Comparator<? super T> comparator, int left, int right) {
+        while (left <= right) {
+            int mid = left + (right - left) / 2;
+            T value = array[mid];
+            int comparison = comparator.compare(value, target);
+
+            if (comparison == 0) {
+                return mid;
+            }
+
+            if (comparison < 0) {
+                left = mid + 1;
+            } else {
+                right = mid - 1;
+            }
+        }
