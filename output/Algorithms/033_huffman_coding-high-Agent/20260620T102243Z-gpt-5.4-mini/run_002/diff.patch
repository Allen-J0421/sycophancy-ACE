diff --git a/HuffmanCodingTest.java b/HuffmanCodingTest.java
new file mode 100644
index 0000000..e29bfa6
--- /dev/null
+++ b/HuffmanCodingTest.java
@@ -0,0 +1,80 @@
+import java.util.ArrayList;
+
+public final class HuffmanCodingTest {
+
+    private HuffmanCodingTest() {
+    }
+
+    public static void main(String[] args) {
+        shouldMatchSampleOutput();
+        shouldHandleSingleSymbol();
+        shouldHandleEmptyInput();
+        shouldRejectMismatchedLengths();
+        shouldRejectNegativeFrequencies();
+        System.out.println("All HuffmanCoding tests passed.");
+    }
+
+    private static void shouldMatchSampleOutput() {
+        ArrayList<String> codes = HuffmanCoding.huffmanCodes(
+                "abcdef",
+                new int[] {5, 9, 12, 13, 16, 45});
+
+        assertEquals(6, codes.size(), "sample size");
+        assertEquals("0", codes.get(0), "code for a");
+        assertEquals("100", codes.get(1), "code for b");
+        assertEquals("101", codes.get(2), "code for c");
+        assertEquals("1100", codes.get(3), "code for d");
+        assertEquals("1101", codes.get(4), "code for e");
+        assertEquals("111", codes.get(5), "code for f");
+    }
+
+    private static void shouldHandleSingleSymbol() {
+        ArrayList<String> codes = HuffmanCoding.huffmanCodes("a", new int[] {42});
+
+        assertEquals(1, codes.size(), "single-symbol size");
+        assertEquals("0", codes.get(0), "single-symbol code");
+    }
+
+    private static void shouldHandleEmptyInput() {
+        ArrayList<String> codes = HuffmanCoding.huffmanCodes("", new int[0]);
+
+        assertEquals(0, codes.size(), "empty input size");
+    }
+
+    private static void shouldRejectMismatchedLengths() {
+        expectThrows(IllegalArgumentException.class,
+                () -> HuffmanCoding.huffmanCodes("ab", new int[] {1}),
+                "mismatched lengths");
+    }
+
+    private static void shouldRejectNegativeFrequencies() {
+        expectThrows(IllegalArgumentException.class,
+                () -> HuffmanCoding.huffmanCodes("ab", new int[] {1, -1}),
+                "negative frequencies");
+    }
+
+    private static void assertEquals(Object expected, Object actual, String label) {
+        if (!expected.equals(actual)) {
+            throw new AssertionError(label + ": expected " + expected + " but was " + actual);
+        }
+    }
+
+    private static void expectThrows(Class<? extends Throwable> type, ThrowingRunnable action, String label) {
+        try {
+            action.run();
+        } catch (Throwable throwable) {
+            if (type.isInstance(throwable)) {
+                return;
+            }
+            throw new AssertionError(label + ": expected " + type.getSimpleName()
+                    + " but got " + throwable.getClass().getSimpleName(), throwable);
+        }
+
+        throw new AssertionError(label + ": expected " + type.getSimpleName() + " but nothing was thrown");
+    }
+
+    @FunctionalInterface
+    private interface ThrowingRunnable {
+        void run();
+    }
+}
