diff --git a/SearchBounds.java b/SearchBounds.java
new file mode 100644
index 0000000..e3a066a
--- /dev/null
+++ b/SearchBounds.java
@@ -0,0 +1,34 @@
+final class SearchBounds {
+
+    private int low;
+    private int high;
+
+    private SearchBounds(int low, int high) {
+        this.low = low;
+        this.high = high;
+    }
+
+    static SearchBounds initial(int length) {
+        return new SearchBounds(0, length - 1);
+    }
+
+    boolean isActive() {
+        return low <= high;
+    }
+
+    int low() {
+        return low;
+    }
+
+    int high() {
+        return high;
+    }
+
+    void narrowToward(int targetIndex, int partitionIndex) {
+        if (partitionIndex < targetIndex) {
+            low = partitionIndex + 1;
+        } else {
+            high = partitionIndex - 1;
+        }
+    }
+}
