diff --git a/Edge.java b/Edge.java
index 80d1c0d..660cb03 100644
--- a/Edge.java
+++ b/Edge.java
@@ -1,2 +1,16 @@
 record Edge(int from, int to, int weight) {
+    boolean isWithinVertexRange(int vertexCount) {
+        return from >= 0
+            && from < vertexCount
+            && to >= 0
+            && to < vertexCount;
+    }
+
+    void validateForVertexCount(int vertexCount) {
+        if (!isWithinVertexRange(vertexCount)) {
+            throw new IllegalArgumentException(
+                "Edge contains vertex out of bounds: (" + from + ", " + to + ")"
+            );
+        }
+    }
 }
diff --git a/Graph.java b/Graph.java
index a435b8a..3ce33a2 100644
--- a/Graph.java
+++ b/Graph.java
@@ -13,6 +13,7 @@ record Graph(int vertexCount, List<Edge> edges) {
         }
 
         edges = List.copyOf(edges);
+        validateEdges(edges, vertexCount);
     }
 
     int requiredEdgeCount() {
@@ -40,4 +41,14 @@ record Graph(int vertexCount, List<Edge> edges) {
             throw new IllegalArgumentException("Vertex count cannot be negative.");
         }
     }
+
+    private static void validateEdges(List<Edge> edges, int vertexCount) {
+        for (Edge edge : edges) {
+            if (edge == null) {
+                throw new IllegalArgumentException("Edges cannot contain null values.");
+            }
+
+            edge.validateForVertexCount(vertexCount);
+        }
+    }
 }
