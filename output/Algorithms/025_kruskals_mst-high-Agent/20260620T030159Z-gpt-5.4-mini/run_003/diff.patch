index 0000000..8b5505b
--- /dev/null
+++ b/KruskalMST.java
@@ -0,0 +1,90 @@
+import java.util.Arrays;
+import java.util.Comparator;
+
+final class KruskalMST {
+    private KruskalMST() {
+    }
+
+    public static int kruskalsMST(int vertexCount, int[][] rawEdges) {
+        return kruskalsMST(vertexCount, toEdges(rawEdges));
+    }
+
+    public static int kruskalsMST(int vertexCount, Edge[] edges) {
+        validateVertexCount(vertexCount);
+        validateEdges(edges, vertexCount);
+
+        Edge[] sortedEdges = Arrays.copyOf(edges, edges.length);
+        Arrays.sort(sortedEdges, Comparator.comparingInt(Edge::weight));
+
+        DisjointSet disjointSet = new DisjointSet(vertexCount);
+        int totalWeight = 0;
+        int edgesUsed = 0;
+
+        for (Edge edge : sortedEdges) {
+            if (disjointSet.union(edge.from(), edge.to())) {
+                totalWeight += edge.weight();
+                if (++edgesUsed == vertexCount - 1) {
+                    break;
+                }
+            }
+        }
+        return totalWeight;
+    }
+
+    public static void main(String[] args) {
+        Edge[] edges = {
+            new Edge(0, 1, 10),
+            new Edge(1, 3, 15),
+            new Edge(2, 3, 4),
+            new Edge(2, 0, 6),
+            new Edge(0, 3, 5)
+        };
+
+        System.out.println(kruskalsMST(4, edges));
+    }
+
+    private static void validateVertexCount(int vertexCount) {
+        if (vertexCount < 0) {
+            throw new IllegalArgumentException("vertexCount must be non-negative");
+        }
+    }
+
+    private static void validateEdges(Edge[] edges, int vertexCount) {
+        if (edges == null) {
+            throw new IllegalArgumentException("edges must not be null");
+        }
+
+        for (int i = 0; i < edges.length; i++) {
+            Edge edge = edges[i];
+            if (edge == null) {
+                throw new IllegalArgumentException("edge " + i + " must not be null");
+            }
+            validateVertexId(edge.from(), vertexCount);
+            validateVertexId(edge.to(), vertexCount);
+        }
+    }
+
+    private static void validateVertexId(int vertexId, int vertexCount) {
+        if (vertexId < 0 || vertexId >= vertexCount) {
+            throw new IllegalArgumentException(
+                "vertex id " + vertexId + " is outside the valid range [0, " + (vertexCount - 1) + "]"
+            );
+        }
+    }
+
+    private static Edge[] toEdges(int[][] rawEdges) {
+        if (rawEdges == null) {
+            throw new IllegalArgumentException("edges must not be null");
+        }
+
+        Edge[] converted = new Edge[rawEdges.length];
+        for (int i = 0; i < rawEdges.length; i++) {
+            int[] edge = rawEdges[i];
+            if (edge == null || edge.length != 3) {
+                throw new IllegalArgumentException("edge " + i + " must contain exactly three integers");
+            }
+            converted[i] = new Edge(edge[0], edge[1], edge[2]);
+        }
+        return converted;
+    }
+}
