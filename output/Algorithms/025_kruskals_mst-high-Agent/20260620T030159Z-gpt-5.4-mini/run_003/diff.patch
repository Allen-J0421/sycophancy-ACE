@@ -0,0 +1,74 @@
+final class KruskalMSTTest {
+    private KruskalMSTTest() {
+    }
+
+    public static void main(String[] args) {
+        shouldComputeSampleMst();
+        shouldHandleSingleVertexGraph();
+        shouldRejectMalformedEdges();
+        shouldRejectOutOfRangeVertices();
+        System.out.println("All KruskalMST checks passed.");
+    }
+
+    private static void shouldComputeSampleMst() {
+        Edge[] edges = {
+            new Edge(0, 1, 10),
+            new Edge(1, 3, 15),
+            new Edge(2, 3, 4),
+            new Edge(2, 0, 6),
+            new Edge(0, 3, 5)
+        };
+
+        assertEquals(19, KruskalMST.kruskalsMST(4, edges), "sample graph");
+        assertEquals(19, KruskalMST.kruskalsMST(4, new int[][] {
+            {0, 1, 10}, {1, 3, 15}, {2, 3, 4}, {2, 0, 6}, {0, 3, 5}
+        }), "sample graph via raw arrays");
+    }
+
+    private static void shouldHandleSingleVertexGraph() {
+        assertEquals(0, KruskalMST.kruskalsMST(1, new Edge[0]), "single-vertex graph");
+    }
+
+    private static void shouldRejectMalformedEdges() {
+        expectIllegalArgument("malformed raw edge", new Runnable() {
+            @Override
+            public void run() {
+                KruskalMST.kruskalsMST(4, new int[][] {{0, 1}});
+            }
+        });
+
+        expectIllegalArgument("null edge", new Runnable() {
+            @Override
+            public void run() {
+                KruskalMST.kruskalsMST(4, new Edge[] {null});
+            }
+        });
+    }
+
+    private static void shouldRejectOutOfRangeVertices() {
+        expectIllegalArgument("out-of-range vertex", new Runnable() {
+            @Override
+            public void run() {
+                KruskalMST.kruskalsMST(3, new Edge[] {new Edge(0, 3, 1)});
+            }
+        });
+    }
+
+    private static void assertEquals(int expected, int actual, String scenario) {
+        if (expected != actual) {
+            throw new AssertionError(
+                scenario + ": expected " + expected + " but got " + actual
+            );
+        }
+    }
+
+    private static void expectIllegalArgument(String scenario, Runnable action) {
+        try {
+            action.run();
+        } catch (IllegalArgumentException expected) {
+            return;
+        }
+
+        throw new AssertionError(scenario + ": expected IllegalArgumentException");
+    }
+}
