+record MstResult(int totalWeight, Edge[] edges, boolean spanningTree) {
+    MstResult {
+        edges = edges == null ? new Edge[0] : edges.clone();
+    }
+
+    public boolean isSpanningTree() {
+        return spanningTree;
+    }
+
+    public Edge[] edges() {
+        return edges.clone();
+    }
+}
