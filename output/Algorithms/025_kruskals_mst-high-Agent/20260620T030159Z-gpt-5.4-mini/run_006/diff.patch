diff --git a/WeightedGraph.java b/WeightedGraph.java
new file mode 100644
index 0000000..cff7e91
--- /dev/null
+++ b/WeightedGraph.java
@@ -0,0 +1,67 @@
+import java.util.Arrays;
+
+record WeightedGraph(int vertexCount, Edge[] edges) {
+    WeightedGraph {
+        validateVertexCount(vertexCount);
+        edges = validateAndCopyEdges(edges, vertexCount);
+    }
+
+    static WeightedGraph of(int vertexCount, int[][] rawEdges) {
+        return new WeightedGraph(vertexCount, toEdges(rawEdges));
+    }
+
+    static WeightedGraph of(int vertexCount, Edge[] edges) {
+        return new WeightedGraph(vertexCount, edges);
+    }
+
+    private static void validateVertexCount(int vertexCount) {
+        if (vertexCount < 0) {
+            throw new IllegalArgumentException("vertexCount must be non-negative");
+        }
+    }
+
+    private static Edge[] validateAndCopyEdges(Edge[] edges, int vertexCount) {
+        if (edges == null) {
+            throw new IllegalArgumentException("edges must not be null");
+        }
+
+        Edge[] copied = Arrays.copyOf(edges, edges.length);
+        for (int i = 0; i < copied.length; i++) {
+            Edge edge = copied[i];
+            if (edge == null) {
+                throw new IllegalArgumentException("edge " + i + " must not be null");
+            }
+            validateVertexId(edge.from(), vertexCount);
+            validateVertexId(edge.to(), vertexCount);
+        }
+        return copied;
+    }
+
+    private static void validateVertexId(int vertexId, int vertexCount) {
+        if (vertexId < 0 || vertexId >= vertexCount) {
+            throw new IllegalArgumentException(
+                "vertex id " + vertexId + " is outside the valid range [0, " + (vertexCount - 1) + "]"
+            );
+        }
+    }
+
+    private static Edge[] toEdges(int[][] rawEdges) {
+        if (rawEdges == null) {
+            throw new IllegalArgumentException("edges must not be null");
+        }
+
+        Edge[] converted = new Edge[rawEdges.length];
+        for (int i = 0; i < rawEdges.length; i++) {
+            int[] edge = rawEdges[i];
+            if (edge == null || edge.length != 3) {
+                throw new IllegalArgumentException("edge " + i + " must contain exactly three integers");
+            }
+            converted[i] = new Edge(edge[0], edge[1], edge[2]);
+        }
+        return converted;
+    }
+
+    public Edge[] edges() {
+        return edges.clone();
+    }
+}
