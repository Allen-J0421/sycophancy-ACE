diff --git a/GraphConstraints.java b/GraphConstraints.java
new file mode 100644
index 0000000..90701c2
--- /dev/null
+++ b/GraphConstraints.java
@@ -0,0 +1,23 @@
+public final class GraphConstraints {
+    private GraphConstraints() {
+    }
+
+    public static void validateVertexCount(int vertexCount) {
+        if (vertexCount < 0) {
+            throw new IllegalArgumentException("Vertex count cannot be negative.");
+        }
+    }
+
+    public static void validateVertexIndex(int vertex, int vertexCount) {
+        validateVertexCount(vertexCount);
+
+        if (vertex < 0 || vertex >= vertexCount) {
+            throw new IllegalArgumentException("Vertex index is outside the valid range.");
+        }
+    }
+
+    public static int requiredEdgeCount(int vertexCount) {
+        validateVertexCount(vertexCount);
+        return vertexCount == 0 ? 0 : vertexCount - 1;
+    }
+}
