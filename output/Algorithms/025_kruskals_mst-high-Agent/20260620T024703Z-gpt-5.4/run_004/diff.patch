diff --git a/KruskalMinimumSpanningTree.java b/KruskalMinimumSpanningTree.java
new file mode 100644
index 0000000..f3abc2e
--- /dev/null
+++ b/KruskalMinimumSpanningTree.java
@@ -0,0 +1,47 @@
+import java.util.ArrayList;
+import java.util.List;
+
+public final class KruskalMinimumSpanningTree implements MinimumSpanningTreeAlgorithm {
+    @Override
+    public MstResult find(WeightedGraph graph) {
+        SelectionTracker tracker = new SelectionTracker(graph.requiredEdgeCount());
+        DisjointSet disjointSet = new DisjointSet(graph.vertexCount());
+
+        for (Edge edge : graph.edgesSortedByWeight()) {
+            if (!disjointSet.unionIfSeparate(edge.from(), edge.to())) {
+                continue;
+            }
+
+            tracker.include(edge);
+            if (tracker.isComplete()) {
+                break;
+            }
+        }
+
+        return tracker.toResult();
+    }
+
+    private static final class SelectionTracker {
+        private final int targetEdgeCount;
+        private final List<Edge> selectedEdges;
+        private int totalWeight;
+
+        private SelectionTracker(int targetEdgeCount) {
+            this.targetEdgeCount = targetEdgeCount;
+            selectedEdges = new ArrayList<>(targetEdgeCount);
+        }
+
+        private void include(Edge edge) {
+            selectedEdges.add(edge);
+            totalWeight += edge.weight();
+        }
+
+        private boolean isComplete() {
+            return selectedEdges.size() == targetEdgeCount;
+        }
+
+        private MstResult toResult() {
+            return new MstResult(totalWeight, selectedEdges, isComplete());
+        }
+    }
+}
