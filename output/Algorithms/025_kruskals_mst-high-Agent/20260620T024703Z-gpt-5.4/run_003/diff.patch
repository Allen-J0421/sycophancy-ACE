diff --git a/WeightedGraph.java b/WeightedGraph.java
new file mode 100644
index 0000000..577012e
--- /dev/null
+++ b/WeightedGraph.java
@@ -0,0 +1,69 @@
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+public record WeightedGraph(int vertexCount, List<Edge> edges) {
+    public WeightedGraph {
+        validateVertexCount(vertexCount);
+        edges = normalizeEdges(vertexCount, edges);
+    }
+
+    public static WeightedGraph from(int vertexCount, int[][] edgeRows) {
+        if (edgeRows == null) {
+            throw new IllegalArgumentException("Edge rows cannot be null.");
+        }
+
+        List<Edge> edges = new ArrayList<>(edgeRows.length);
+
+        for (int[] edgeRow : edgeRows) {
+            if (edgeRow == null || edgeRow.length != 3) {
+                throw new IllegalArgumentException("Each edge must contain exactly 3 values: from, to, weight.");
+            }
+
+            edges.add(new Edge(edgeRow[0], edgeRow[1], edgeRow[2]));
+        }
+
+        return new WeightedGraph(vertexCount, edges);
+    }
+
+    public List<Edge> edgesSortedByWeight() {
+        List<Edge> sortedEdges = new ArrayList<>(edges);
+        sortedEdges.sort(Comparator.comparingInt(Edge::weight));
+        return sortedEdges;
+    }
+
+    public int requiredEdgeCount() {
+        return vertexCount == 0 ? 0 : vertexCount - 1;
+    }
+
+    private static List<Edge> normalizeEdges(int vertexCount, List<Edge> edges) {
+        if (edges == null) {
+            throw new IllegalArgumentException("Edge list cannot be null.");
+        }
+
+        List<Edge> normalizedEdges = new ArrayList<>(edges.size());
+
+        for (Edge edge : edges) {
+            if (edge == null) {
+                throw new IllegalArgumentException("Edge list cannot contain null values.");
+            }
+
+            validateEdge(edge, vertexCount);
+            normalizedEdges.add(edge);
+        }
+
+        return List.copyOf(normalizedEdges);
+    }
+
+    private static void validateVertexCount(int vertexCount) {
+        if (vertexCount < 0) {
+            throw new IllegalArgumentException("Vertex count cannot be negative.");
+        }
+    }
+
+    private static void validateEdge(Edge edge, int vertexCount) {
+        if (edge.from() < 0 || edge.from() >= vertexCount || edge.to() < 0 || edge.to() >= vertexCount) {
+            throw new IllegalArgumentException("Edge contains a vertex index outside the valid range.");
+        }
+    }
+}
