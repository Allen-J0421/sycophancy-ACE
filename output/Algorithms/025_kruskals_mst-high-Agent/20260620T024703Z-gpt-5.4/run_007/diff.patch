     }
 
+    public static WeightedGraph fromEdgeRows(int vertexCount, int[][] edgeRows) {
+        if (edgeRows == null) {
+            throw new IllegalArgumentException("Edge rows cannot be null.");
+        }
+
+        List<Edge> edges = new ArrayList<>(edgeRows.length);
+
+        for (int[] edgeRow : edgeRows) {
+            if (edgeRow == null || edgeRow.length != 3) {
+                throw new IllegalArgumentException("Each edge must contain exactly 3 values: from, to, weight.");
+            }
+
+            edges.add(new Edge(edgeRow[0], edgeRow[1], edgeRow[2]));
+        }
+
+        return new WeightedGraph(vertexCount, edges);
+    }
+
     public int vertexCount() {
         return vertexCount;
     }
