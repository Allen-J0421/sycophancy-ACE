+public class CoinChange {
+
+    static int count(int[] coins, int sum) {
+        validateInputs(coins, sum);
+
+        int[] waysBySum = new int[sum + 1];
+        waysBySum[0] = 1;
+
+        // Process each coin once so combinations are counted without regard to order.
+        for (int coin : coins) {
+            for (int currentSum = coin; currentSum <= sum; currentSum++) {
+                waysBySum[currentSum] += waysBySum[currentSum - coin];
+            }
+        }
+
+        return waysBySum[sum];
+    }
+
+    private static void validateInputs(int[] coins, int sum) {
+        if (coins == null) {
+            throw new IllegalArgumentException("coins must not be null");
+        }
+        if (sum < 0) {
+            throw new IllegalArgumentException("sum must not be negative");
+        }
+        for (int coin : coins) {
+            if (coin <= 0) {
+                throw new IllegalArgumentException("coin values must be positive");
+            }
+        }
+    }
+
+    public static void main(String[] args) {
+        int[] coins = {1, 2, 3};
+        int sum = 5;
+        System.out.println(count(coins, sum));
+    }
+}
