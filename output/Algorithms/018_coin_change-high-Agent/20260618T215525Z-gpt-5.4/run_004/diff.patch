+import java.util.Arrays;
+
 public final class CoinChange {
 
     private static final int[] SAMPLE_COINS = {1, 2, 3};
     private static final int SAMPLE_SUM = 5;
 
-    private CoinChange() {
-        // Utility class
+    private final int[] coins;
+
+    CoinChange(int[] coins) {
+        validateCoins(coins);
+        this.coins = Arrays.copyOf(coins, coins.length);
+    }
+
+    int countWays(int targetSum) {
+        validateTargetSum(targetSum);
+
+        int[] combinationsBySum = new int[targetSum + 1];
+        combinationsBySum[0] = 1;
+
+        for (int coin : coins) {
+            addCombinationsForCoin(combinationsBySum, coin, targetSum);
+        }
+
+        return combinationsBySum[targetSum];
+    }
+
+    // Process each coin once so combinations are counted without regard to order.
+    private static void addCombinationsForCoin(int[] combinationsBySum, int coin, int targetSum) {
+        for (int currentSum = coin; currentSum <= targetSum; currentSum++) {
+            combinationsBySum[currentSum] += combinationsBySum[currentSum - coin];
+        }
+    }
+
+    private static void validateCoins(int[] coins) {
+        if (coins == null) {
+            throw new IllegalArgumentException("coins must not be null");
+        }
+        for (int coin : coins) {
+            if (coin <= 0) {
+                throw new IllegalArgumentException("coin values must be positive");
+            }
+        }
     }
 
-    static int count(int[] coins, int sum) {
-        return CoinChangeSolver.countWays(coins, sum);
+    private static void validateTargetSum(int targetSum) {
+        if (targetSum < 0) {
+            throw new IllegalArgumentException("sum must not be negative");
+        }
     }
 
     public static void main(String[] args) {
-        System.out.println(count(SAMPLE_COINS, SAMPLE_SUM));
+        CoinChange solver = new CoinChange(SAMPLE_COINS);
+        System.out.println(solver.countWays(SAMPLE_SUM));
     }
 }
