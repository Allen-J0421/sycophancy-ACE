{\n        List<Integer> component = new ArrayList<>();\n        Deque<Integer> queue = new ArrayDeque<>();\n        visited[start] = true;\n        queue.add(start);\n\n        while (!queue.isEmpty()) {\n            int current = queue.poll();\n            component.add(current);\n\n            for (int neighbor : graph.neighborsOf(current)) {\n                if (!visited[neighbor]) {\n                    visited[neighbor] = true;\n                    queue.add(neighbor);\n                }\n            }\n        }\n        return component;\n    }\n\n}\n","structuredPatch":[{"oldStart":5,"oldLines":11,"newStart":5,"newLines":11,"lines":[" import java.util.List;"," import java.util.stream.Collectors;"," ","-class ConnectedComponents {","+public class ConnectedComponents {"," ","     private ConnectedComponents() {}"," ","-    static List<List<Integer>> find(Graph graph) {","+    public static List<List<Integer>> find(Graph graph) {","         if (graph == null) {","             throw new IllegalArgumentException(\"graph must not be null\");","         }"]}],"userModified":false,"replaceAll":false}}
