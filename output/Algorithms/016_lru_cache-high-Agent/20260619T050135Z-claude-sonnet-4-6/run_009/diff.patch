+class StatsCache<K, V> implements Cache<K, V> {
+
+    private final Cache<K, V> delegate;
+    private long hits;
+    private long misses;
+
+    private StatsCache(Cache<K, V> delegate) {
+        this.delegate = delegate;
+    }
+
+    static <K, V> StatsCache<K, V> wrap(Cache<K, V> delegate) {
+        Objects.requireNonNull(delegate, "delegate");
+        return new StatsCache<>(delegate);
+    }
+
+    long hits()   { return hits; }
+    long misses() { return misses; }
+
+    double hitRate() {
+        long total = hits + misses;
+        return total == 0 ? 0.0 : (double) hits / total;
+    }
+
+    @Override
+    public Optional<V> get(K key) {
+        Optional<V> result = delegate.get(key);
+        if (result.isPresent()) hits++; else misses++;
+        return result;
+    }
+
+    // Overridden so stats are counted once per logical lookup, not once per internal
+    // get() call. Uses delegate methods directly to bypass this.get()'s accounting.
+    @Override
+    public V computeIfAbsent(K key, Function<? super K, ? extends V> loader) {
+        if (delegate.containsKey(key)) {
+            hits++;
+        } else {
+            misses++;
+            delegate.put(key, loader.apply(key));
+        }
+        return delegate.get(key).orElse(null);
+    }
+
+    @Override public void put(K key, V value)        { delegate.put(key, value); }
+    @Override public boolean containsKey(K key)      { return delegate.containsKey(key); }
+    @Override public void invalidate(K key)          { delegate.invalidate(key); }
+    @Override public void clear()                    { delegate.clear(); }
+    @Override public int size()                      { return delegate.size(); }
+}
