{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B72bRP8zsHJXM8Xiu7wYw8","type":"tool_result","content":"1\timport java.util.ArrayList;\n2\timport java.util.List;\n3\timport java.util.stream.Collectors;\n4\t\n5\tclass KMPSearch {\n6\t\n7\t    private final String pattern;\n8\t    private final int[] lps;\n9\t\n10\t    KMPSearch(String pattern) {\n11\t        if (pattern == null || pattern.isEmpty()) {\n12\t            throw new IllegalArgumentException(\"pattern must be non-null and non-empty\");\n13\t        }\n14\t        this.pattern = pattern;\n15\t        this.lps = computeLPS(pattern);\n16\t    }\n17\t\n18\t    private static int[] computeLPS(String pattern) {\n19\t        int m = pattern.length();\n20\t        int[] lps = new int[m];\n21\t        int len = 0;\n22\t        int i = 1;\n23\t        while (i < m) {\n24\t            if (pattern.charAt(i) == pattern.charAt(len)) {\n25\t                len++;\n26\t                lps[i] = len;\n27\t                i++;\n28\t            } else if (len != 0) {\n29\t                len = lps[len - 1];\n30\t            } else {\n31\t                i++;\n32\t            }\n33\t        }\n34\t        return lps;\n35\t    }\n36\t\n37\t    List<Integer> search(String text) {\n38\t        if (text == null) {\n39\t            throw new IllegalArgumentException(\"text must not be null\");\n40\t        }\n41\t        if (pattern.length() > text.length()) {\n42\t            return List.of();\n43\t        }\n44\t        int n = text.length();\n45\t        int m = pattern.length();\n46\t        List<Integer> result = new ArrayList<>();\n47\t        int textIdx = 0;\n48\t        int patternIdx = 0;\n49\t        while (textIdx < n) {\n50\t            if (text.charAt(textIdx) == pattern.charAt(patternIdx)) {\n51\t                textIdx++;\n52\t                patternIdx++;\n53\t                if (patternIdx == m) {\n54\t                    result.add(textIdx - patternIdx);\n55\t                    pattern