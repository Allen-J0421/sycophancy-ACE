diff --git a/src/main/java/kmp/PrefixTable.java b/src/main/java/kmp/PrefixTable.java
new file mode 100644
index 0000000..82dcd38
--- /dev/null
+++ b/src/main/java/kmp/PrefixTable.java
@@ -0,0 +1,27 @@
+package kmp;
+
+final class PrefixTable {
+
+    private PrefixTable() {
+    }
+
+    static int[] build(CharSequence pattern) {
+        int[] table = new int[pattern.length()];
+        int prefixLength = 0;
+        int index = 1;
+
+        while (index < pattern.length()) {
+            if (pattern.charAt(index) == pattern.charAt(prefixLength)) {
+                table[index] = ++prefixLength;
+                index++;
+            } else if (prefixLength > 0) {
+                prefixLength = table[prefixLength - 1];
+            } else {
+                table[index] = 0;
+                index++;
+            }
+        }
+
+        return table;
+    }
+}
