+package floydwarshall.graph;
+
+import java.util.Objects;
+
+/**
+ * Factory helpers for building {@link WeightedGraph} instances, for clients who
+ * have their edges in adjacency-matrix form rather than as a list of edges.
+ *
+ * <p>In all factories {@code matrix[i][j]} is interpreted as the weight of the
+ * directed edge {@code i -> j}, including the diagonal: a present cell is
+ * transcribed faithfully into an edge, so a meaningful (e.g. negative) self-loop
+ * is preserved. Cells that denote "no edge" are skipped — represented by
+ * {@code null} in the generic factory and by an explicit sentinel in the
+ * {@code int} convenience factory.
+ */
+public final class Graphs {
+
+    private Graphs() {
+    }
+
+    /**
+     * Builds a graph from a square {@code W[][]} adjacency matrix in which a
+     * {@code null} cell means "no edge".
+     *
+     * @throws IllegalArgumentException if the matrix is not square
+     */
+    public static <W> WeightedGraph<W> fromMatrix(W[][] matrix) {
+        Objects.requireNonNull(matrix, "matrix");
+        int n = matrix.length;
+        WeightedGraph.Builder<W> builder = WeightedGraph.builder(n);
+        for (int i = 0; i < n; i++) {
+            W[] row = requireSquareRow(matrix[i], i, n);
+            for (int j = 0; j < n; j++) {
+                if (row[j] != null) {
+                    builder.addEdge(i, j, row[j]);
+                }
+            }
+        }
+        return builder.build();
+    }
+
+    /**
+     * Builds an {@code Integer}-weighted graph from a square {@code int[][]}
+     * adjacency matrix in which cells equal to {@code noEdge} mean "no edge".
+     * This mirrors the classic infinity-sentinel matrix style.
+     *
+     * @throws IllegalArgumentException if the matrix is not square
+     */
+    public static WeightedGraph<Integer> fromIntMatrix(int[][] matrix, int noEdge) {
+        Objects.requireNonNull(matrix, "matrix");
+        int n = matrix.length;
+        WeightedGraph.Builder<Integer> builder = WeightedGraph.builder(n);
+        for (int i = 0; i < n; i++) {
+            int[] row = matrix[i];
+            Objects.requireNonNull(row, "matrix row " + i);
+            if (row.length != n) {
+                throw notSquare(i, row.length, n);
+            }
+            for (int j = 0; j < n; j++) {
+                if (row[j] != noEdge) {
+                    builder.addEdge(i, j, row[j]);
+                }
+            }
+        }
+        return builder.build();
+    }
+
+    private static <W> W[] requireSquareRow(W[] row, int index, int expected) {
+        Objects.requireNonNull(row, "matrix row " + index);
+        if (row.length != expected) {
+            throw notSquare(index, row.length, expected);
+        }
+        return row;
+    }
+
+    private static IllegalArgumentException notSquare(int row, int actual, int expected) {
+        return new IllegalArgumentException(
+                "matrix is not square: row " + row + " has length " + actual
+                        + ", expected " + expected);
+    }
+}
