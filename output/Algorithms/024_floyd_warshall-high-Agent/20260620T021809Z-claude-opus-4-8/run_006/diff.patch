+package floydwarshall.weight;
+
+/**
+ * {@link WeightSystem} for {@code int} weights, reproducing the behaviour of the
+ * original integer-only implementation. Supports negative weights and negative
+ * cycles.
+ */
+public final class IntWeightSystem implements WeightSystem<Integer> {
+
+    @Override
+    public Integer zero() {
+        return 0;
+    }
+
+    @Override
+    public Integer sum(Integer a, Integer b) {
+        return a + b;
+    }
+
+    @Override
+    public int compare(Integer a, Integer b) {
+        return Integer.compare(a, b);
+    }
+}
