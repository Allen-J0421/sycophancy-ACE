diff --git a/src/main/java/floydwarshall/matrix/SquareMatrix.java b/src/main/java/floydwarshall/matrix/SquareMatrix.java
new file mode 100644
index 0000000..0b4ca5c
--- /dev/null
+++ b/src/main/java/floydwarshall/matrix/SquareMatrix.java
@@ -0,0 +1,83 @@
+package floydwarshall.matrix;
+
+import java.util.Arrays;
+import java.util.Optional;
+
+/**
+ * A mutable {@code size x size} matrix of weights of type {@code W} with
+ * bounds-checked access. An unset cell represents "no value" (for shortest
+ * paths: unreachable) and is surfaced as an empty {@link Optional} rather than
+ * any sentinel, so no magic value can leak to callers.
+ *
+ * @param <W> the element type
+ */
+public final class SquareMatrix<W> {
+
+    private final int size;
+    private final Object[][] cells;
+
+    private SquareMatrix(int size) {
+        this.size = size;
+        this.cells = new Object[size][size];
+    }
+
+    /** Creates a {@code size x size} matrix with every cell unset. */
+    public static <W> SquareMatrix<W> empty(int size) {
+        if (size < 0) {
+            throw new IllegalArgumentException("size must be non-negative, got " + size);
+        }
+        return new SquareMatrix<>(size);
+    }
+
+    public int size() {
+        return size;
+    }
+
+    /** @return the value at {@code (row, col)}, or empty if unset. */
+    public Optional<W> get(int row, int col) {
+        return Optional.ofNullable(getOrNull(row, col));
+    }
+
+    /** @return the value at {@code (row, col)}, or {@code null} if unset. */
+    @SuppressWarnings("unchecked")
+    public W getOrNull(int row, int col) {
+        checkIndex(row, col);
+        return (W) cells[row][col];
+    }
+
+    public boolean isSet(int row, int col) {
+        checkIndex(row, col);
+        return cells[row][col] != null;
+    }
+
+    public void set(int row, int col, W value) {
+        checkIndex(row, col);
+        cells[row][col] = value;
+    }
+
+    /** @return an independent copy with identical contents. */
+    public SquareMatrix<W> copy() {
+        SquareMatrix<W> clone = new SquareMatrix<>(size);
+        for (int i = 0; i < size; i++) {
+            System.arraycopy(cells[i], 0, clone.cells[i], 0, size);
+        }
+        return clone;
+    }
+
+    private void checkIndex(int row, int col) {
+        if (row < 0 || row >= size || col < 0 || col >= size) {
+            throw new IndexOutOfBoundsException(
+                    "(" + row + ", " + col + ") out of bounds for size " + size);
+        }
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        return o instanceof SquareMatrix<?> other && Arrays.deepEquals(cells, other.cells);
+    }
+
+    @Override
+    public int hashCode() {
+        return Arrays.deepHashCode(cells);
+    }
+}
diff --git a/src/main/java/floydwarshall/weight/DoubleWeightSystem.java b/src/main/java/floydwarshall/weight/DoubleWeightSystem.java
new file mode 100644
index 0000000..d6686b3
--- /dev/null
+++ b/src/main/java/floydwarshall/weight/DoubleWeightSystem.java
@@ -0,0 +1,29 @@
+package floydwarshall.weight;
+
+/**
+ * {@link WeightSystem} for {@code double} weights, e.g. distances, costs, or
+ * probabilities expressed as additive log-weights.
+ *
+ * <p>Ordering uses {@link Double#compare}, so {@code NaN} weights are rejected to
+ * avoid producing an inconsistent ordering.
+ */
+public final class DoubleWeightSystem implements WeightSystem<Double> {
+
+    @Override
+    public Double zero() {
+        return 0.0;
+    }
+
+    @Override
+    public Double sum(Double a, Double b) {
+        return a + b;
+    }
+
+    @Override
+    public int compare(Double a, Double b) {
+        if (Double.isNaN(a) || Double.isNaN(b)) {
+            throw new IllegalArgumentException("NaN weights are not comparable");
+        }
+        return Double.compare(a, b);
+    }
+}
