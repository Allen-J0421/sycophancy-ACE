diff --git a/src/main/java/floydwarshall/weight/WeightSystem.java b/src/main/java/floydwarshall/weight/WeightSystem.java
new file mode 100644
index 0000000..0cd6dd0
--- /dev/null
+++ b/src/main/java/floydwarshall/weight/WeightSystem.java
@@ -0,0 +1,34 @@
+package floydwarshall.weight;
+
+/**
+ * Defines the arithmetic Floyd-Warshall needs to operate over an arbitrary
+ * weight type {@code W}: how to combine two consecutive path segments, how to
+ * order path costs, and what the cost of a zero-length path is.
+ *
+ * <p>Together these form a min-plus-style structure. The algorithm never needs
+ * an explicit "infinity" value — unreachable pairs are modelled as the
+ * <em>absence</em> of a weight — so implementations only have to describe finite
+ * costs.
+ *
+ * <p>Implementations are expected to be stateless and thread-safe.
+ *
+ * @param <W> the weight type (e.g. {@code Integer}, {@code Long}, {@code Double})
+ */
+public interface WeightSystem<W> {
+
+    /**
+     * The cost of a path of length zero, i.e. the additive identity such that
+     * {@code sum(zero(), w).equals(w)}. Self-distances start from this value and
+     * negative cycles are detected by comparing a cycle's cost against it.
+     */
+    W zero();
+
+    /** Combines two consecutive path segments into a single cost. */
+    W sum(W a, W b);
+
+    /**
+     * Orders path costs the way {@link Comparable#compareTo} would: negative if
+     * {@code a} is cheaper than {@code b}, zero if equal, positive otherwise.
+     */
+    int compare(W a, W b);
+}
