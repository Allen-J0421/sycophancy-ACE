@@ -0,0 +1,40 @@
+package floydwarshall;
+
+import java.util.Objects;
+
+/**
+ * Minimal, dependency-free assertion helpers for the hand-rolled test runner.
+ * Each failed assertion throws {@link AssertionError}; a passing assertion is
+ * counted so the runner can report a total.
+ */
+public final class TestAssertions {
+
+    private int checks;
+
+    public int checks() {
+        return checks;
+    }
+
+    public void assertTrue(boolean condition, String message) {
+        checks++;
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    public void assertEquals(Object expected, Object actual, String message) {
+        checks++;
+        if (!Objects.equals(expected, actual)) {
+            throw new AssertionError(message + " — expected <" + expected + "> but was <" + actual + ">");
+        }
+    }
+
+    public void assertEquals(int expected, int actual, String message) {
+        assertEquals(Integer.valueOf(expected), Integer.valueOf(actual), message);
+    }
+
+    public void fail(String message) {
+        checks++;
+        throw new AssertionError(message);
+    }
+}
