index 0000000..5c3f454
--- /dev/null
+++ b/src/main/java/floydwarshall/algorithm/NextHopTable.java
@@ -0,0 +1,41 @@
+package floydwarshall.algorithm;
+
+/**
+ * Successor table used to reconstruct shortest paths produced by
+ * {@link FloydWarshallSolver}.
+ *
+ * <p>{@code next[i][j]} holds the vertex that immediately follows {@code i} on a
+ * shortest path from {@code i} to {@code j}, or {@link #NONE} when no path is
+ * known. Following the chain {@code i -> next[i][j] -> ... -> j} yields a full
+ * shortest path without storing every path explicitly.
+ */
+public final class NextHopTable {
+
+    /** Sentinel indicating that no next hop (hence no path) exists. */
+    public static final int NONE = -1;
+
+    private final int[][] next;
+
+    NextHopTable(int size) {
+        this.next = new int[size][size];
+        for (int[] row : next) {
+            java.util.Arrays.fill(row, NONE);
+        }
+    }
+
+    int size() {
+        return next.length;
+    }
+
+    int get(int from, int to) {
+        return next[from][to];
+    }
+
+    void set(int from, int to, int hop) {
+        next[from][to] = hop;
+    }
+
+    boolean hasPath(int from, int to) {
+        return next[from][to] != NONE;
+    }
+}
