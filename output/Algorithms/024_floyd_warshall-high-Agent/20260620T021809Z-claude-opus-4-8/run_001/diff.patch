@@ -0,0 +1,89 @@
+package floydwarshall.algorithm;
+
+import floydwarshall.graph.Edge;
+import floydwarshall.graph.WeightedGraph;
+import floydwarshall.matrix.IntSquareMatrix;
+
+/**
+ * Computes all-pairs shortest paths using the Floyd-Warshall algorithm.
+ *
+ * <p>The algorithm runs in {@code O(V^3)} time and {@code O(V^2)} space and
+ * supports negative edge weights. Negative-weight cycles are detected rather
+ * than silently producing meaningless distances. Neither the input
+ * {@link WeightedGraph} nor any supplied matrix is mutated; results are returned
+ * in a fresh {@link AllPairsShortestPaths}.
+ */
+public final class FloydWarshallSolver {
+
+    private static final int INF = AllPairsShortestPaths.INFINITY;
+
+    /** Solves all-pairs shortest paths for the given graph. */
+    public AllPairsShortestPaths solve(WeightedGraph graph) {
+        int n = graph.vertexCount();
+        IntSquareMatrix dist = IntSquareMatrix.filled(n, INF);
+        NextHopTable next = new NextHopTable(n);
+
+        for (int v = 0; v < n; v++) {
+            dist.set(v, v, 0);
+            next.set(v, v, v);
+        }
+        // Keep the cheapest weight when parallel edges share an ordered pair.
+        for (Edge e : graph.edges()) {
+            if (e.weight() < dist.get(e.from(), e.to())) {
+                dist.set(e.from(), e.to(), e.weight());
+                next.set(e.from(), e.to(), e.to());
+            }
+        }
+        return run(dist, next);
+    }
+
+    /**
+     * Solves all-pairs shortest paths for a pre-built distance matrix where
+     * {@code matrix[i][j]} is the direct cost from {@code i} to {@code j} and
+     * {@link AllPairsShortestPaths#INFINITY} marks the absence of an edge. The
+     * input array is copied and left unmodified.
+     */
+    public AllPairsShortestPaths solve(int[][] matrix) {
+        IntSquareMatrix dist = IntSquareMatrix.copyOf(matrix);
+        int n = dist.size();
+        NextHopTable next = new NextHopTable(n);
+        for (int i = 0; i < n; i++) {
+            for (int j = 0; j < n; j++) {
+                if (i == j || dist.get(i, j) < INF) {
+                    next.set(i, j, j);
+                }
+            }
+        }
+        return run(dist, next);
+    }
+
+    private AllPairsShortestPaths run(IntSquareMatrix dist, NextHopTable next) {
+        int n = dist.size();
+        for (int k = 0; k < n; k++) {
+            for (int i = 0; i < n; i++) {
+                // Nothing to relay through k if i cannot reach k.
+                if (dist.get(i, k) >= INF) {
+                    continue;
+                }
+                for (int j = 0; j < n; j++) {
+                    if (dist.get(k, j) >= INF) {
+                        continue;
+                    }
+                    int candidate = dist.get(i, k) + dist.get(k, j);
+                    if (candidate < dist.get(i, j)) {
+                        dist.set(i, j, candidate);
+                        next.set(i, j, next.get(i, k));
+                    }
+                }
+            }
+        }
+        boolean negativeCycle = false;
+        for (int i = 0; i < n; i++) {
+            if (dist.get(i, i) < 0) {
+                negativeCycle = true;
+                break;
+            }
+        }
+        return new AllPairsShortestPaths(dist, next, negativeCycle);
+    }
+}
