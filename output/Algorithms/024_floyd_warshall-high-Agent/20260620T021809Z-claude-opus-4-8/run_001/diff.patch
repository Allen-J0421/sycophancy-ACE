+package floydwarshall.demo;
+
+import floydwarshall.algorithm.AllPairsShortestPaths;
+import floydwarshall.algorithm.FloydWarshallSolver;
+import floydwarshall.format.DistanceMatrixFormatter;
+import floydwarshall.graph.WeightedGraph;
+
+/**
+ * Command-line entry point demonstrating the Floyd-Warshall library: it solves
+ * the canonical example graph, prints the shortest-distance matrix, and
+ * reconstructs a sample shortest path.
+ */
+public final class FloydWarshallDemo {
+
+    public static void main(String[] args) {
+        WeightedGraph graph = ExampleGraphs.classicFiveVertex();
+
+        AllPairsShortestPaths result = new FloydWarshallSolver().solve(graph);
+
+        System.out.print(new DistanceMatrixFormatter().format(result));
+
+        result.path(1, 0).ifPresent(path ->
+                System.out.println(System.lineSeparator() + "Shortest path 1 -> 0: " + path));
+    }
+}
