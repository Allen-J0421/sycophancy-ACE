@@ -0,0 +1,53 @@
+package floydwarshall.format;
+
+import floydwarshall.algorithm.AllPairsShortestPaths;
+
+/**
+ * Renders a {@link AllPairsShortestPaths} distance matrix as human-readable
+ * text. Unreachable pairs are shown with a configurable token (default
+ * {@code "INF"}) and columns are aligned for readability.
+ */
+public final class DistanceMatrixFormatter {
+
+    private final String unreachableToken;
+
+    public DistanceMatrixFormatter() {
+        this("INF");
+    }
+
+    public DistanceMatrixFormatter(String unreachableToken) {
+        this.unreachableToken = unreachableToken;
+    }
+
+    /** Formats the distance matrix with right-aligned, evenly spaced columns. */
+    public String format(AllPairsShortestPaths result) {
+        int n = result.vertexCount();
+        String[][] cells = new String[n][n];
+        int width = 0;
+        for (int i = 0; i < n; i++) {
+            for (int j = 0; j < n; j++) {
+                String text = result.distance(i, j)
+                        .stream().mapToObj(Integer::toString)
+                        .findFirst().orElse(unreachableToken);
+                cells[i][j] = text;
+                width = Math.max(width, text.length());
+            }
+        }
+
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < n; i++) {
+            for (int j = 0; j < n; j++) {
+                if (j > 0) {
+                    sb.append(' ');
+                }
+                sb.append(pad(cells[i][j], width));
+            }
+            sb.append(System.lineSeparator());
+        }
+        return sb.toString();
+    }
+
+    private static String pad(String text, int width) {
+        return " ".repeat(width - text.length()) + text;
+    }
+}
