+package floydwarshall.graph;
+
+/**
+ * An immutable directed, weighted edge between two vertices.
+ *
+ * <p>Vertices are identified by their zero-based index within a
+ * {@link WeightedGraph}. The {@code weight} may be negative; Floyd-Warshall
+ * supports negative edge weights (and can detect negative cycles).
+ *
+ * @param from   the source vertex index
+ * @param to     the destination vertex index
+ * @param weight the cost of traversing the edge
+ */
+public record Edge(int from, int to, int weight) {
+
+    public Edge {
+        if (from < 0) {
+            throw new IllegalArgumentException("from must be non-negative, got " + from);
+        }
+        if (to < 0) {
+            throw new IllegalArgumentException("to must be non-negative, got " + to);
+        }
+    }
+}
diff --git a/src/main/java/floydwarshall/graph/WeightedGraph.java b/src/main/java/floydwarshall/graph/WeightedGraph.java
new file mode 100644
index 0000000..0946ebd
--- /dev/null
+++ b/src/main/java/floydwarshall/graph/WeightedGraph.java
@@ -0,0 +1,99 @@
+package floydwarshall.graph;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.OptionalInt;
+
+/**
+ * An immutable directed graph with integer edge weights over a fixed set of
+ * vertices {@code 0 .. vertexCount()-1}.
+ *
+ * <p>Instances are created through the {@link Builder}, which guarantees that
+ * every edge references valid vertices. Parallel edges are permitted; when
+ * exporting to a distance matrix the cheapest weight between any ordered pair
+ * is retained.
+ */
+public final class WeightedGraph {
+
+    private final int vertexCount;
+    private final List<Edge> edges;
+
+    private WeightedGraph(int vertexCount, List<Edge> edges) {
+        this.vertexCount = vertexCount;
+        this.edges = List.copyOf(edges);
+    }
+
+    /** @return the number of vertices, indexed {@code 0 .. vertexCount()-1}. */
+    public int vertexCount() {
+        return vertexCount;
+    }
+
+    /** @return an unmodifiable view of every edge in the graph. */
+    public List<Edge> edges() {
+        return edges;
+    }
+
+    /**
+     * Returns the weight of the cheapest direct edge from {@code from} to
+     * {@code to}, or an empty result if no such edge exists. A self-loop is
+     * only reported if it was explicitly added.
+     */
+    public OptionalInt directWeight(int from, int to) {
+        checkVertex(from);
+        checkVertex(to);
+        OptionalInt best = OptionalInt.empty();
+        for (Edge e : edges) {
+            if (e.from() == from && e.to() == to) {
+                best = best.isEmpty() ? OptionalInt.of(e.weight())
+                                      : OptionalInt.of(Math.min(best.getAsInt(), e.weight()));
+            }
+        }
+        return best;
+    }
+
+    private void checkVertex(int v) {
+        if (v < 0 || v >= vertexCount) {
+            throw new IndexOutOfBoundsException(
+                    "vertex " + v + " out of range [0, " + vertexCount + ")");
+        }
+    }
+
+    /** Creates a builder for a graph with the given number of vertices. */
+    public static Builder builder(int vertexCount) {
+        return new Builder(vertexCount);
+    }
+
+    /** Fluent builder that validates edges as they are added. */
+    public static final class Builder {
+        private final int vertexCount;
+        private final List<Edge> edges = new ArrayList<>();
+
+        private Builder(int vertexCount) {
+            if (vertexCount < 0) {
+                throw new IllegalArgumentException(
+                        "vertexCount must be non-negative, got " + vertexCount);
+            }
+            this.vertexCount = vertexCount;
+        }
+
+        /** Adds a directed edge, validating that both endpoints exist. */
+        public Builder addEdge(int from, int to, int weight) {
+            requireInRange(from);
+            requireInRange(to);
+            edges.add(new Edge(from, to, weight));
+            return this;
+        }
+
+        private void requireInRange(int v) {
+            if (v < 0 || v >= vertexCount) {
+                throw new IndexOutOfBoundsException(
+                        "vertex " + v + " out of range [0, " + vertexCount + ")");
+            }
+        }
+
+        public WeightedGraph build() {
+            return new WeightedGraph(vertexCount, Collections.unmodifiableList(edges));
+        }
+    }
+}
