@@ -0,0 +1,36 @@
+package floydwarshall.algorithm;
+
+import java.util.List;
+import java.util.stream.Collectors;
+
+/**
+ * An ordered, immutable sequence of vertices forming a shortest path, together
+ * with the total cost of traversing it.
+ *
+ * @param vertices the vertices visited, in order from source to destination
+ * @param totalCost the sum of the edge weights along the path
+ */
+public record VertexPath(List<Integer> vertices, int totalCost) {
+
+    public VertexPath {
+        vertices = List.copyOf(vertices);
+    }
+
+    public int source() {
+        return vertices.get(0);
+    }
+
+    public int destination() {
+        return vertices.get(vertices.size() - 1);
+    }
+
+    public int length() {
+        return vertices.size();
+    }
+
+    @Override
+    public String toString() {
+        return vertices.stream().map(String::valueOf).collect(Collectors.joining(" -> "))
+                + " (cost " + totalCost + ")";
+    }
+}
