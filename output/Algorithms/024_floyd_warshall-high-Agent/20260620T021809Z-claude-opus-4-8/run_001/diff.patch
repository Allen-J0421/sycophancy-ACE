+++ b/src/main/java/floydwarshall/algorithm/AllPairsShortestPaths.java
@@ -0,0 +1,86 @@
+package floydwarshall.algorithm;
+
+import floydwarshall.matrix.IntSquareMatrix;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import java.util.OptionalInt;
+
+/**
+ * Immutable result of running {@link FloydWarshallSolver} over a graph: the
+ * matrix of shortest-path distances between every ordered pair of vertices,
+ * plus enough information to reconstruct an actual shortest path.
+ *
+ * <p>Unreachable pairs are represented internally by the {@link #INFINITY}
+ * sentinel but surfaced to callers as empty {@link OptionalInt}/{@link Optional}
+ * results, so client code never has to compare against a magic number.
+ */
+public final class AllPairsShortestPaths {
+
+    /**
+     * Sentinel distance for "no path". Chosen large enough to dominate any real
+     * path yet small enough that {@code INFINITY + INFINITY} cannot overflow an
+     * {@code int}, which lets the relaxation step add two distances safely.
+     */
+    public static final int INFINITY = (int) 1e8;
+
+    private final IntSquareMatrix distances;
+    private final NextHopTable nextHops;
+    private final boolean hasNegativeCycle;
+
+    AllPairsShortestPaths(IntSquareMatrix distances, NextHopTable nextHops, boolean hasNegativeCycle) {
+        this.distances = distances;
+        this.nextHops = nextHops;
+        this.hasNegativeCycle = hasNegativeCycle;
+    }
+
+    public int vertexCount() {
+        return distances.size();
+    }
+
+    /** True if the graph contains a reachable negative-weight cycle. */
+    public boolean hasNegativeCycle() {
+        return hasNegativeCycle;
+    }
+
+    /**
+     * @return the shortest-path distance from {@code from} to {@code to}, or an
+     *         empty result if {@code to} is unreachable from {@code from}.
+     */
+    public OptionalInt distance(int from, int to) {
+        int d = distances.get(from, to);
+        return d >= INFINITY ? OptionalInt.empty() : OptionalInt.of(d);
+    }
+
+    /** @return a defensive copy of the full distance matrix. */
+    public IntSquareMatrix distanceMatrix() {
+        return distances.copy();
+    }
+
+    /**
+     * Reconstructs a shortest path from {@code from} to {@code to}.
+     *
+     * @return the path, or empty if {@code to} is unreachable from {@code from}
+     * @throws IllegalStateException if the path traverses a negative cycle, in
+     *         which case no finite shortest path is well defined
+     */
+    public Optional<VertexPath> path(int from, int to) {
+        if (!nextHops.hasPath(from, to)) {
+            return Optional.empty();
+        }
+        List<Integer> vertices = new ArrayList<>();
+        int current = from;
+        vertices.add(current);
+        while (current != to) {
+            current = nextHops.get(current, to);
+            if (current == NextHopTable.NONE || vertices.size() > vertexCount()) {
+                throw new IllegalStateException(
+                        "path from " + from + " to " + to + " is not well defined"
+                                + " (likely a negative cycle)");
+            }
+            vertices.add(current);
+        }
+        return Optional.of(new VertexPath(vertices, distances.get(from, to)));
+    }
+}
