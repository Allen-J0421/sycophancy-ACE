+package floydwarshall.demo;
+
+import floydwarshall.graph.WeightedGraph;
+
+/**
+ * Reusable sample graphs for demos and documentation.
+ */
+public final class ExampleGraphs {
+
+    private ExampleGraphs() {
+    }
+
+    /**
+     * The five-vertex directed graph used as the canonical Floyd-Warshall
+     * example. Edges (from, to, weight):
+     * <pre>
+     *   0->1:4  0->3:5
+     *   1->2:1  1->4:6
+     *   2->0:2  2->3:3
+     *   3->2:1  3->4:2
+     *   4->0:1  4->3:4
+     * </pre>
+     */
+    public static WeightedGraph classicFiveVertex() {
+        return WeightedGraph.builder(5)
+                .addEdge(0, 1, 4)
+                .addEdge(0, 3, 5)
+                .addEdge(1, 2, 1)
+                .addEdge(1, 4, 6)
+                .addEdge(2, 0, 2)
+                .addEdge(2, 3, 3)
+                .addEdge(3, 2, 1)
+                .addEdge(3, 4, 2)
+                .addEdge(4, 0, 1)
+                .addEdge(4, 3, 4)
+                .build();
+    }
+}
