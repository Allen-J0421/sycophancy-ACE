+++ b/src/main/java/floydwarshall/matrix/IntSquareMatrix.java
@@ -0,0 +1,100 @@
+package floydwarshall.matrix;
+
+import java.util.Arrays;
+
+/**
+ * A mutable square matrix of {@code int} values with bounds-checked access.
+ *
+ * <p>This is a thin, defensive wrapper around a {@code int[][]} that guarantees
+ * the square invariant and copies data on construction and export, so callers
+ * cannot accidentally alias internal state. It carries no algorithm-specific
+ * semantics; sentinels such as "infinity" are the concern of the caller.
+ */
+public final class IntSquareMatrix {
+
+    private final int size;
+    private final int[][] cells;
+
+    private IntSquareMatrix(int size, int[][] cells) {
+        this.size = size;
+        this.cells = cells;
+    }
+
+    /** Creates a {@code size x size} matrix with every cell set to {@code fill}. */
+    public static IntSquareMatrix filled(int size, int fill) {
+        if (size < 0) {
+            throw new IllegalArgumentException("size must be non-negative, got " + size);
+        }
+        int[][] cells = new int[size][size];
+        for (int[] row : cells) {
+            Arrays.fill(row, fill);
+        }
+        return new IntSquareMatrix(size, cells);
+    }
+
+    /**
+     * Creates a matrix from a defensive copy of {@code source}, which must be
+     * square (every row the same length as the number of rows).
+     */
+    public static IntSquareMatrix copyOf(int[][] source) {
+        int size = source.length;
+        int[][] cells = new int[size][];
+        for (int i = 0; i < size; i++) {
+            if (source[i].length != size) {
+                throw new IllegalArgumentException(
+                        "matrix is not square: row " + i + " has length "
+                                + source[i].length + ", expected " + size);
+            }
+            cells[i] = source[i].clone();
+        }
+        return new IntSquareMatrix(size, cells);
+    }
+
+    public int size() {
+        return size;
+    }
+
+    public int get(int row, int col) {
+        checkIndex(row, col);
+        return cells[row][col];
+    }
+
+    public void set(int row, int col, int value) {
+        checkIndex(row, col);
+        cells[row][col] = value;
+    }
+
+    /** @return an independent {@link IntSquareMatrix} with identical contents. */
+    public IntSquareMatrix copy() {
+        return copyOf(cells);
+    }
+
+    /** @return a defensive {@code int[][]} copy of this matrix. */
+    public int[][] toArray() {
+        int[][] out = new int[size][];
+        for (int i = 0; i < size; i++) {
+            out[i] = cells[i].clone();
+        }
+        return out;
+    }
+
+    private void checkIndex(int row, int col) {
+        if (row < 0 || row >= size || col < 0 || col >= size) {
+            throw new IndexOutOfBoundsException(
+                    "(" + row + ", " + col + ") out of bounds for size " + size);
+        }
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) {
+            return true;
+        }
+        return o instanceof IntSquareMatrix other && Arrays.deepEquals(cells, other.cells);
+    }
+
+    @Override
+    public int hashCode() {
+        return Arrays.deepHashCode(cells);
+    }
+}
diff --git a/src/test/java/floydwarshall/FloydWarshallTest.java b/src/test/java/floydwarshall/FloydWarshallTest.java
new file mode 100644
index 0000000..b77323f
--- /dev/null
+++ b/src/test/java/floydwarshall/FloydWarshallTest.java
@@ -0,0 +1,130 @@
+package floydwarshall;
+
+import floydwarshall.algorithm.AllPairsShortestPaths;
+import floydwarshall.algorithm.FloydWarshallSolver;
+import floydwarshall.algorithm.VertexPath;
+import floydwarshall.demo.ExampleGraphs;
+import floydwarshall.graph.WeightedGraph;
+
+import java.util.List;
+import java.util.Optional;
+
+/**
+ * Dependency-free test suite for the Floyd-Warshall library. Run via
+ * {@code java floydwarshall.FloydWarshallTest}; exits non-zero on failure.
+ */
+public final class FloydWarshallTest {
+
+    private static final int INF = AllPairsShortestPaths.INFINITY;
+
+    public static void main(String[] args) {
+        TestAssertions a = new TestAssertions();
+        int failures = 0;
+        failures += run("classic distances match baseline", () -> classicDistances(a), a);
+        failures += run("path reconstruction", () -> pathReconstruction(a), a);
+        failures += run("unreachable vertex", () -> unreachable(a), a);
+        failures += run("negative cycle detection", () -> negativeCycle(a), a);
+        failures += run("matrix input is not mutated", () -> inputNotMutated(a), a);
+        failures += run("matrix and graph agree", () -> matrixMatchesGraph(a), a);
+
+        System.out.println();
+        System.out.println(a.checks() + " checks executed.");
+        if (failures > 0) {
+            System.out.println(failures + " test(s) FAILED.");
+            System.exit(1);
+        }
+        System.out.println("All tests passed.");
+    }
+
+    private static int run(String name, Runnable test, TestAssertions a) {
+        try {
+            test.run();
+            System.out.println("[PASS] " + name);
+            return 0;
+        } catch (Throwable t) {
+            System.out.println("[FAIL] " + name + ": " + t.getMessage());
+            return 1;
+        }
+    }
+
+    private static void classicDistances(TestAssertions a) {
+        AllPairsShortestPaths r = new FloydWarshallSolver().solve(ExampleGraphs.classicFiveVertex());
+        int[][] expected = {
+                {0, 4, 5, 5, 7},
+                {3, 0, 1, 4, 6},
+                {2, 6, 0, 3, 5},
+                {3, 7, 1, 0, 2},
+                {1, 5, 5, 4, 0},
+        };
+        for (int i = 0; i < expected.length; i++) {
+            for (int j = 0; j < expected.length; j++) {
+                a.assertEquals(expected[i][j], r.distance(i, j).orElse(INF),
+                        "distance(" + i + "," + j + ")");
+            }
+        }
+    }
+
+    private static void pathReconstruction(TestAssertions a) {
+        AllPairsShortestPaths r = new FloydWarshallSolver().solve(ExampleGraphs.classicFiveVertex());
+        Optional<VertexPath> path = r.path(1, 0);
+        a.assertTrue(path.isPresent(), "path 1->0 should exist");
+        a.assertEquals(List.of(1, 2, 0), path.get().vertices(), "path 1->0 vertices");
+        a.assertEquals(3, path.get().totalCost(), "path 1->0 cost");
+        a.assertEquals(0, r.path(2, 2).orElseThrow().totalCost(), "self path cost");
+    }
+
+    private static void unreachable(TestAssertions a) {
+        WeightedGraph g = WeightedGraph.builder(3).addEdge(0, 1, 1).build();
+        AllPairsShortestPaths r = new FloydWarshallSolver().solve(g);
+        a.assertTrue(r.distance(0, 2).isEmpty(), "vertex 2 unreachable");
+        a.assertTrue(r.path(0, 2).isEmpty(), "no path to vertex 2");
+        a.assertEquals(1, r.distance(0, 1).orElseThrow(), "0->1 reachable");
+    }
+
+    private static void negativeCycle(TestAssertions a) {
+        WeightedGraph g = WeightedGraph.builder(2)
+                .addEdge(0, 1, 1)
+                .addEdge(1, 0, -2)
+                .build();
+        AllPairsShortestPaths r = new FloydWarshallSolver().solve(g);
+        a.assertTrue(r.hasNegativeCycle(), "negative cycle should be detected");
+
+        WeightedGraph acyclic = WeightedGraph.builder(2).addEdge(0, 1, 5).build();
+        a.assertTrue(!new FloydWarshallSolver().solve(acyclic).hasNegativeCycle(),
+                "no false-positive negative cycle");
+    }
+
+    private static void inputNotMutated(TestAssertions a) {
+        int[][] matrix = {
+                {0, 4, INF},
+                {INF, 0, 1},
+                {2, INF, 0},
+        };
+        int[][] before = {
+                {0, 4, INF},
+                {INF, 0, 1},
+                {2, INF, 0},
+        };
+        new FloydWarshallSolver().solve(matrix);
+        for (int i = 0; i < before.length; i++) {
+            for (int j = 0; j < before.length; j++) {
+                a.assertEquals(before[i][j], matrix[i][j], "input cell (" + i + "," + j + ")");
+            }
+        }
+    }
+
+    private static void matrixMatchesGraph(TestAssertions a) {
+        FloydWarshallSolver solver = new FloydWarshallSolver();
+        AllPairsShortestPaths fromGraph = solver.solve(ExampleGraphs.classicFiveVertex());
+        int[][] matrix = {
+                {0, 4, INF, 5, INF},
+                {INF, 0, 1, INF, 6},
+                {2, INF, 0, 3, INF},
+                {INF, INF, 1, 0, 2},
+                {1, INF, INF, 4, 0},
+        };
+        AllPairsShortestPaths fromMatrix = solver.solve(matrix);
+        a.assertEquals(fromGraph.distanceMatrix(), fromMatrix.distanceMatrix(),
+                "graph and matrix inputs yield identical distances");
+    }
+}
