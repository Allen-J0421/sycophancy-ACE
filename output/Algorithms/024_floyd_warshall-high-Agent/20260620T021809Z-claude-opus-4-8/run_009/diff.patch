diff --git a/src/main/java/floydwarshall/graph/package-info.java b/src/main/java/floydwarshall/graph/package-info.java
new file mode 100644
index 0000000..15c5a22
--- /dev/null
+++ b/src/main/java/floydwarshall/graph/package-info.java
@@ -0,0 +1,32 @@
+/**
+ * The immutable graph domain model and ways to construct it.
+ *
+ * <p>A {@link floydwarshall.graph.WeightedGraph} is a directed graph over the
+ * vertices {@code 0 .. vertexCount()-1} whose edges
+ * ({@link floydwarshall.graph.Edge}) carry weights of type {@code W}. Graphs are
+ * immutable and are assembled through a validating
+ * {@link floydwarshall.graph.WeightedGraph.Builder}, which guarantees every edge
+ * references existing vertices. Parallel edges are permitted; the solver keeps
+ * the cheapest weight between any ordered pair.
+ *
+ * <h2>Building from a matrix</h2>
+ * Clients who hold their edges in adjacency-matrix form can use
+ * {@link floydwarshall.graph.Graphs} instead of the builder. Each
+ * {@code matrix[i][j]} is interpreted as the weight of the directed edge
+ * {@code i -> j} (the diagonal included, so a meaningful self-loop is preserved);
+ * a cell denoting "no edge" is skipped — {@code null} in the generic
+ * {@link floydwarshall.graph.Graphs#fromMatrix(Object[][]) fromMatrix}, or an
+ * explicit sentinel in the {@code int} convenience
+ * {@link floydwarshall.graph.Graphs#fromIntMatrix(int[][], int) fromIntMatrix}.
+ *
+ * <pre>{@code
+ * WeightedGraph<Integer> g = WeightedGraph.<Integer>builder(3)
+ *         .addEdge(0, 1, 4)
+ *         .addEdge(1, 2, 1)
+ *         .build();
+ *
+ * // or, from a matrix where `inf` marks the absence of an edge:
+ * WeightedGraph<Integer> h = Graphs.fromIntMatrix(matrix, inf);
+ * }</pre>
+ */
+package floydwarshall.graph;
diff --git a/src/main/java/floydwarshall/matrix/package-info.java b/src/main/java/floydwarshall/matrix/package-info.java
new file mode 100644
index 0000000..f7ca5b3
--- /dev/null
+++ b/src/main/java/floydwarshall/matrix/package-info.java
@@ -0,0 +1,14 @@
+/**
+ * The sentinel-free square matrix used to hold distances.
+ *
+ * <p>{@link floydwarshall.matrix.SquareMatrix} is a mutable {@code size x size}
+ * grid of weights of type {@code W} with bounds-checked access. An unset cell
+ * represents "no value" — for shortest paths, an unreachable pair — and is
+ * surfaced as an empty {@link java.util.Optional} rather than any magic number,
+ * so no sentinel can leak to callers.
+ *
+ * <p>The class is deliberately free of algorithm-specific semantics: the meaning
+ * of "unset" is the caller's concern. It provides defensive {@code copy()} so a
+ * result can hand out a matrix without exposing its internal state.
+ */
+package floydwarshall.matrix;
diff --git a/src/main/java/floydwarshall/package-info.java b/src/main/java/floydwarshall/package-info.java
new file mode 100644
index 0000000..9abd1fb
--- /dev/null
+++ b/src/main/java/floydwarshall/package-info.java
@@ -0,0 +1,51 @@
+/**
+ * A small, well-factored implementation of the Floyd-Warshall all-pairs
+ * shortest-path algorithm over directed graphs with <em>generic</em> edge
+ * weights.
+ *
+ * <h2>Pipeline</h2>
+ * <ol>
+ *   <li>Build a {@link floydwarshall.graph.WeightedGraph} — directly with its
+ *       builder, or from an adjacency matrix via {@link floydwarshall.graph.Graphs}.</li>
+ *   <li>Run {@link floydwarshall.algorithm.FloydWarshallSolver} configured with a
+ *       {@link floydwarshall.weight.WeightSystem} for the weight type.</li>
+ *   <li>Query the resulting {@link floydwarshall.algorithm.AllPairsShortestPaths}
+ *       for distances, reconstructed paths, and negative-cycle status.</li>
+ *   <li>Optionally render the distance matrix with
+ *       {@link floydwarshall.format.DistanceMatrixFormatter}.</li>
+ * </ol>
+ *
+ * <h2>Design principles</h2>
+ * <ul>
+ *   <li><b>Separation of concerns.</b> Weight arithmetic, graph representation,
+ *       the solver, the result/query API, and formatting are independent,
+ *       individually testable units, one per sub-package.</li>
+ *   <li><b>Generic weights.</b> Nothing is tied to {@code int}; the algorithm is
+ *       parameterised over a weight type {@code W} (see
+ *       {@link floydwarshall.weight}).</li>
+ *   <li><b>No sentinels.</b> "Unreachable" is the <em>absence</em> of a value,
+ *       surfaced as an empty {@link java.util.Optional} — there is no infinity
+ *       constant to leak (see {@link floydwarshall.matrix}).</li>
+ *   <li><b>No input mutation.</b> Solving copies into fresh state, unlike the
+ *       original in-place implementation.</li>
+ *   <li><b>Correctness extras.</b> Negative-weight cycles are detected, and
+ *       actual shortest paths can be reconstructed (see
+ *       {@link floydwarshall.algorithm}).</li>
+ * </ul>
+ *
+ * <h2>Sub-packages</h2>
+ * <ul>
+ *   <li>{@link floydwarshall.weight} — the {@code (sum, compare, zero)} weight
+ *       abstraction and ready-made systems for {@code Integer}/{@code Long}/{@code Double}.</li>
+ *   <li>{@link floydwarshall.graph} — the immutable graph domain model and
+ *       matrix-based factories.</li>
+ *   <li>{@link floydwarshall.matrix} — the bounds-checked, sentinel-free square
+ *       matrix used to hold distances.</li>
+ *   <li>{@link floydwarshall.algorithm} — the solver, its result, and path
+ *       reconstruction.</li>
+ *   <li>{@link floydwarshall.format} — human-readable rendering of distance
+ *       matrices.</li>
+ *   <li>{@link floydwarshall.demo} — a runnable entry point and sample graphs.</li>
+ * </ul>
+ */
+package floydwarshall;
diff --git a/src/main/java/floydwarshall/weight/package-info.java b/src/main/java/floydwarshall/weight/package-info.java
