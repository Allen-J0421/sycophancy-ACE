new file mode 100644
index 0000000..3c17bc5
--- /dev/null
+++ b/src/main/java/floydwarshall/algorithm/package-info.java
@@ -0,0 +1,24 @@
+/**
+ * The Floyd-Warshall solver, its result, and shortest-path reconstruction.
+ *
+ * <p>{@link floydwarshall.algorithm.FloydWarshallSolver} computes all-pairs
+ * shortest paths in {@code O(V^3)} time and {@code O(V^2)} space over any weight
+ * type, supporting negative weights. It never mutates its input graph; it builds
+ * fresh state and returns a {@link floydwarshall.algorithm.AllPairsShortestPaths}.
+ *
+ * <p>The result answers three questions, none of which require comparing against
+ * a sentinel:
+ * <ul>
+ *   <li>{@link floydwarshall.algorithm.AllPairsShortestPaths#distance(int, int)
+ *       distance(from, to)} — the shortest cost, or empty if unreachable.</li>
+ *   <li>{@link floydwarshall.algorithm.AllPairsShortestPaths#path(int, int)
+ *       path(from, to)} — an actual shortest {@link floydwarshall.algorithm.VertexPath},
+ *       reconstructed from a successor table
+ *       ({@link floydwarshall.algorithm.NextHopTable}) rather than stored
+ *       explicitly for every pair.</li>
+ *   <li>{@link floydwarshall.algorithm.AllPairsShortestPaths#hasNegativeCycle()
+ *       hasNegativeCycle()} — whether a reachable negative-weight cycle exists,
+ *       detected rather than silently producing meaningless distances.</li>
+ * </ul>
+ */
+package floydwarshall.algorithm;
