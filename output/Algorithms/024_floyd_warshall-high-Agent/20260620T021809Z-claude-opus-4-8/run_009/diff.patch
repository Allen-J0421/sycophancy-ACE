index 0000000..1b45235
--- /dev/null
+++ b/src/main/java/floydwarshall/weight/package-info.java
@@ -0,0 +1,25 @@
+/**
+ * The weight abstraction the solver is parameterised over.
+ *
+ * <p>{@link floydwarshall.weight.WeightSystem} captures the arithmetic
+ * Floyd-Warshall needs over an arbitrary weight type {@code W}: a
+ * {@link floydwarshall.weight.WeightSystem#zero() zero} (the cost of a
+ * zero-length path and additive identity), a
+ * {@link floydwarshall.weight.WeightSystem#sum(Object, Object) sum} to combine
+ * consecutive segments, and a
+ * {@link floydwarshall.weight.WeightSystem#compare(Object, Object) compare} to
+ * order costs. Together these form a min-plus-style structure.
+ *
+ * <p>Crucially, no explicit "infinity" is required: unreachable pairs are
+ * modelled as the absence of a weight, so implementations only describe finite
+ * costs. Negative cycles are detected by comparing a cycle's cost against
+ * {@code zero()}.
+ *
+ * <p>Ready-made implementations are provided for the common numeric types
+ * ({@link floydwarshall.weight.IntWeightSystem},
+ * {@link floydwarshall.weight.LongWeightSystem},
+ * {@link floydwarshall.weight.DoubleWeightSystem}). To support a custom weight
+ * type, implement {@code WeightSystem<W>}; implementations are expected to be
+ * stateless and thread-safe.
+ */
+package floydwarshall.weight;
