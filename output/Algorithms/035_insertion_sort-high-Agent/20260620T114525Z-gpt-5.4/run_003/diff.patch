+    private static <T> void insert(T[] values, int index, Comparator<? super T> comparator) {
+        T value = values[index];
+        int position = index - 1;
+
+        while (position >= 0 && comparator.compare(values[position], value) > 0) {
+            values[position + 1] = values[position];
+            position--;
+        }
