@@ -0,0 +1,44 @@
+public final class InsertionSortSelfTest {
+
+    private InsertionSortSelfTest() {
+    }
+
+    public static void main(String[] args) {
+        assertSortedCopyReturnsSortedValues();
+        assertInPlaceSortOrdersValues();
+        assertSortedCheckHandlesBothCases();
+    }
+
+    private static void assertSortedCopyReturnsSortedValues() {
+        int[] original = {3, 1, 2};
+        int[] sorted = InsertionSort.sortedCopy(original);
+
+        assertEquals("[3, 1, 2]", InsertionSort.format(original), "sortedCopy should not mutate input");
+        assertEquals("[1, 2, 3]", InsertionSort.format(sorted), "sortedCopy should return sorted values");
+    }
+
+    private static void assertInPlaceSortOrdersValues() {
+        int[] values = {9, -1, 4, 4, 0};
+
+        InsertionSort.sort(values);
+
+        assertEquals("[-1, 0, 4, 4, 9]", InsertionSort.format(values),
+                "sort should order values in place");
+    }
+
+    private static void assertSortedCheckHandlesBothCases() {
+        if (!InsertionSort.isSorted(new int[]{1, 2, 3})) {
+            throw new AssertionError("Expected sorted input to be reported as sorted");
+        }
+
+        if (InsertionSort.isSorted(new int[]{2, 1, 3})) {
+            throw new AssertionError("Expected unsorted input to be reported as unsorted");
+        }
+    }
+
+    private static void assertEquals(String expected, String actual, String message) {
+        if (!expected.equals(actual)) {
+            throw new AssertionError(message + " expected=" + expected + " actual=" + actual);
+        }
+    }
+}
