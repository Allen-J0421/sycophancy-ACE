+    private static void bubbleSort(int[] values) {
+        for (int end = values.length - 1; end > 0; end--) {
+            boolean swapped = false;
+
+            for (int index = 0; index < end; index++) {
+                if (values[index] > values[index + 1]) {
+                    swap(values, index, index + 1);
+                    swapped = true;
+                }
+            }
+
+            if (!swapped) {
+                break;
+            }
+        }
