+import java.util.Arrays;
+import java.util.Comparator;
+
+public final class BubbleSortTest {
+
+    private BubbleSortTest() {
+    }
+
+    public static void main(String[] args) {
+        testPrimitiveSort();
+        testGenericSort();
+        testCustomComparator();
+        testNoOpCases();
+        System.out.println("BubbleSort tests passed.");
+    }
+
+    private static void testPrimitiveSort() {
+        int[] values = { 5, 1, 4, 2, 8 };
+
+        BubbleSort.sort(values);
+
+        assertArrayEquals(new int[] { 1, 2, 4, 5, 8 }, values, "primitive sort");
+    }
+
+    private static void testGenericSort() {
+        Integer[] values = { 9, 3, 7, 1, 5 };
+
+        BubbleSort.sort(values);
+
+        assertArrayEquals(new Integer[] { 1, 3, 5, 7, 9 }, values, "generic sort");
+    }
+
+    private static void testCustomComparator() {
+        String[] values = { "bbb", "a", "cc" };
+
+        BubbleSort.sort(values, Comparator.comparingInt(String::length));
+
+        assertArrayEquals(new String[] { "a", "cc", "bbb" }, values, "custom comparator");
+    }
+
+    private static void testNoOpCases() {
+        int[] empty = {};
+        BubbleSort.sort(empty);
+        assertArrayEquals(new int[] {}, empty, "empty primitive array");
+
+        String[] single = { "only" };
+        BubbleSort.sort(single);
+        assertArrayEquals(new String[] { "only" }, single, "single-element generic array");
+    }
+
+    private static void assertArrayEquals(int[] expected, int[] actual, String label) {
+        if (!Arrays.equals(expected, actual)) {
+            throw new AssertionError(label + " failed: expected " + Arrays.toString(expected)
+                    + " but got " + Arrays.toString(actual));
+        }
+    }
+
+    private static <T> void assertArrayEquals(T[] expected, T[] actual, String label) {
+        if (!Arrays.equals(expected, actual)) {
+            throw new AssertionError(label + " failed: expected " + Arrays.toString(expected)
+                    + " but got " + Arrays.toString(actual));
+        }
+    }
+}
