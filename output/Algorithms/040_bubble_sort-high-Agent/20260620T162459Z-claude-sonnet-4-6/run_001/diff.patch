+package sorting;
+
+public class IntArrayFormatter {
+
+    public static String format(int[] arr) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < arr.length; i++) {
+            if (i > 0) {
+                sb.append(' ');
+            }
+            sb.append(arr[i]);
+        }
+        return sb.toString();
+    }
+}
