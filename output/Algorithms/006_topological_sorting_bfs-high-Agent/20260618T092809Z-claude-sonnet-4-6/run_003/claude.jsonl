 return result;\n    }\n\n    public static void main(String[] args) {\n        Graph g = new Graph(6);\n        g.addEdge(0, 1);\n        g.addEdge(1, 2);\n        g.addEdge(2, 3);\n        g.addEdge(4, 5);\n        g.addEdge(5, 1);\n        g.addEdge(5, 2);\n\n        System.out.println(topoSort(g));\n    }\n}\n","numLines":70,"startLine":1,"totalLines":70}}}
