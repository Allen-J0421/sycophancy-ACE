ext] == 0) {\n                    ready.add(next);\n                }\n            }\n        }\n\n        if (order.size() != n) {\n            throw new IllegalArgumentException(\n                \"Graph contains a cycle; no topological ordering exists\");\n        }\n        return order;\n    }\n\n    private static int[] computeIndegrees(List<List<Integer>> adj) {\n        int[] indegree = new int[adj.size()];\n        for (List<Integer> successors : adj) {\n            for (int next : successors) {\n                indegree[next]++;\n            }\n        }\n        return indegree;\n    }\n\n    private static List<List<Integer>> newGraph(int vertexCount) {\n        List<List<Integer>> adj = new ArrayList<>(vertexCount);\n        for (int i = 0; i < vertexCount; i++) {\n            adj.add(new ArrayList<>());\n        }\n        return adj;\n    }\n\n    private static void addEdge(List<List<Integer>> adj, int from, int to) {\n        adj.get(from).add(to);\n    }\n\n    public static void main(String[] args) {\n        List<List<Integer>> adj = newGraph(6);\n        addEdge(adj, 0, 1);\n        addEdge(adj, 1, 2);\n        addEdge(adj, 2, 3);\n        addEdge(adj, 4, 5);\n        addEdge(adj, 5, 1);\n        addEdge(adj, 5, 2);\n\n        List<Integer> order = topoSort(adj);\n        StringBuilder sb = new StringBuilder();\n        for (int vertex : order) {\n            sb.append(vertex).append(' ');\n        }\n        System.out.println(sb.toString().trim());\n    }\n}\n","structuredPatch":[{"oldStart":8,"oldLines":7,"newStart":8,"newLines":7,"lines":["  * in-degrees). The graph is represented as an adjacency list where index {@code i}","  * holds the list of vertices that vertex {@code i} points to.","  */","-class TopologicalSort {","+public class TopologicalSort {"," ","     /**","      * Returns a topological ordering of the graph's vertices."]}],"userModified":false,"replaceAll":false}}
