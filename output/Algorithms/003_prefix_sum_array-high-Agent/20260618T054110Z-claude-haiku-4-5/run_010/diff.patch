diff --git a/StrategyDecorator.java b/StrategyDecorator.java
new file mode 100644
index 0000000..03bfadc
--- /dev/null
+++ b/StrategyDecorator.java
@@ -0,0 +1,15 @@
+/**
+ * Base decorator for wrapping computation strategies with additional behavior.
+ */
+public abstract class StrategyDecorator implements ComputationStrategy {
+    protected final ComputationStrategy delegate;
+
+    public StrategyDecorator(ComputationStrategy delegate) {
+        this.delegate = delegate;
+    }
+
+    @Override
+    public String getName() {
+        return delegate.getName() + " (decorated)";
+    }
+}
diff --git a/ValidationStrategy.java b/ValidationStrategy.java
new file mode 100644
index 0000000..74e5a44
--- /dev/null
+++ b/ValidationStrategy.java
@@ -0,0 +1,21 @@
+import java.util.List;
+
+/**
+ * Decorator strategy that validates input before delegating to wrapped strategy.
+ */
+public class ValidationStrategy extends StrategyDecorator {
+    public ValidationStrategy(ComputationStrategy delegate) {
+        super(delegate);
+    }
+
+    @Override
+    public List<Long> compute(int[] arr) {
+        InputValidator.validate(arr);
+        return delegate.compute(arr);
+    }
+
+    @Override
+    public String getName() {
+        return "Validating " + delegate.getName();
+    }
+}
