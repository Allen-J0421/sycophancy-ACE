             throw new IllegalArgumentException("Input array cannot be empty");
@@ -29,6 +50,29 @@ public class PrefixSum {
             result.add(sum);
         }
 
+        if (cacheEnabled) {
+            cache.addAll(result);
+        }
+
         return result;
     }
+
