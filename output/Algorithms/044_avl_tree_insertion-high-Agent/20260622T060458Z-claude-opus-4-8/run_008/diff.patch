+    private static void removeKeepsTreeSortedAndBalanced() {
+        int n = 4_000;
+        AVLTree<Integer> tree = new AVLTree<>();
+        for (int i = 0; i < n; i++) {
+            tree.insert(i);
+        }
+
+        List<Integer> expected = new ArrayList<>();
+        for (int i = 0; i < n; i++) {
+            if (i % 2 == 0) {
+                tree.remove(i); // remove the evens
+            } else {
+                expected.add(i);
+            }
+        }
