+    private final class InOrderIterator implements Iterator<T> {
+        private final Deque<Node<T>> stack = new ArrayDeque<>();
+        private final T hi;
+        private final boolean hasHi;
+        private T lastReturned;
+        private boolean canRemove;
+        private int expectedModCount = modCount;
+
+        InOrderIterator(T lo, boolean hasLo, T hi, boolean hasHi) {
+            this.hi = hi;
+            this.hasHi = hasHi;
+            // Seed the stack with the path to the smallest in-range element.
+            Node<T> node = root;
+            while (node != null) {
+                if (!hasLo || compare(node.value, lo) >= 0) {
+                    stack.push(node);
+                    node = node.left;
+                } else {
+                    node = node.right;
+                }
+            }
+        }
+
+        @Override
+        public boolean hasNext() {
+            checkForComodification();
+            return !stack.isEmpty() && (!hasHi || compare(stack.peek().value, hi) < 0);
+        }
+
+        @Override
