-        System.out.println("contains 25: " + tree.contains(25));
-        System.out.println("contains 99: " + tree.contains(99));
+
+        check(tree.preOrder().equals(List.of(30, 20, 10, 25, 40, 50)), "pre-order");
+        check(tree.inOrder().equals(List.of(10, 20, 25, 30, 40, 50)), "sorted order");
+        check(tree.size() == 6, "size");
+        check(tree.height() == 3, "height");
+        check(tree.contains(25) && !tree.contains(99), "contains");
+        check(tree.min() == 10 && tree.max() == 50, "min/max");
+        check(tree.floor(26).equals(Optional.of(25)), "floor");
+        check(tree.ceiling(26).equals(Optional.of(30)), "ceiling");
+        check(tree.floor(5).isEmpty() && tree.ceiling(99).isEmpty(), "out-of-range queries");
+
+        // Inserting a duplicate is a no-op; re-inserting after removal is not.
+        check(!tree.insert(25), "duplicate insert reports no change");
+        check(tree.remove(30) && !tree.remove(30), "remove reports change once");
+        tree.validate();
+        check(tree.inOrder().equals(List.of(10, 20, 25, 40, 50)), "order after remove");
+        check(tree.size() == 5, "size after remove");
+
+        // Stress the balancing with a larger, adversarial (ascending) sequence.
+        AVLTree<Integer> big = new AVLTree<>();
+        for (int i = 1; i <= 1000; i++) {
+            big.insert(i);
+        }
+        big.validate();
+        check(big.height() <= 11, "balanced height for 1000 ascending inserts");
+        for (int i = 1; i <= 1000; i += 2) {
+            big.remove(i);
+        }
+        big.validate();
+        check(big.size() == 500, "size after bulk removal");
