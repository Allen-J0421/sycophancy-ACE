+/**
+ * Demonstrates and self-tests the {@link AVLTree} API. Every operation is
+ * checked with assertions and the tree's invariants are re-validated after each
+ * mutation, so a clean run is evidence of correctness rather than something to
+ * eyeball.
+ */
 class Main {
     public static void main(String[] args) {
         AVLTree<Integer> tree = new AVLTree<>();
         for (int key : new int[] {10, 20, 30, 40, 50, 25}) {
             tree.insert(key);
         }
+        tree.validate();
 
