+package hashmap;
+
+import java.util.Arrays;
+import java.util.Objects;
+import java.util.function.BiConsumer;
+
+/**
+ * A hash map implemented with <em>open addressing</em> and <em>linear probing</em>.
+ *
+ * <p>Keys and values are generic. {@code null} keys are not permitted; {@code null}
+ * values are. Collisions are resolved by scanning forward (with w鸥-around) to the
+ * next free slot (with wrap-around). Deleted slots are marked with
+ * <em>tombstones</em> so that probe sequences are not broken; tombstones are
+ * reclaimed during insertion and cleared on the next resize.
+ *
+ * <p>The backing table always has a power-of-two length, so the slot index is
+ * computed with a fast bit-mask rather than a modulo. The table grows
+ * automatically once the fraction of occupied slots (live entries plus
+ * tombstones) exceeds the configured load factor, keeping operations amortized
+ * {@code O(1)}.
+ *
+ * <p>This class is <strong>not</strong> thread-safe.
+ *
+ * @param <K> the type of keys maintained by this map
+ * @param <V> the type of mapped values
+ */
+public final class OpenAddressingHashMap<K, V> {
+
+    /** Default initial capacity; must be a power of two. */
+    private static final int DEFAULT_CAPACITY = 16;
+
+    /** Default fraction of occupied slots that triggers a resize. */
+    private static final double DEFAULT_LOAD_FACTOR = 0.5;
+
+    /** A single key/value slot. A tombstone is an entry whose {@code key} is null. */
+    private static final class Entry<K, V> {
+        final K key;
+        V value;
+
+        Entry(K key, V value) {
+            this.key = key;
+            this.value = value;
+        }
+
+        boolean isTombstone() {
+            return key == null;
+        }
+    }
+
+    /** Shared tombstone marker; distinguishable from {@code null} (never used) slots. */
+    private static final Entry<?, ?> TOMBSTONE = new Entry<>(null, null);
+
+    private Entry<K, V>[] table;
+
+    /** Number of live (non-tombstone) entries. */
+    private int size;
+
+    /** Live entries plus tombstones; the table is resized based on this figure. */
+    private int occupiedSlots;
+
+    private final double loadFactor;
+
+    /** Creates an empty map with the default capacity and load factor. */
+    public OpenAddressingHashMap() {
+        this(DEFAULT_CAPACITY, DEFAULT_LOAD_FACTOR);
+    }
+
+    /**
+     * Creates an empty map with the given initial capacity and the default load factor.
+     *
+     * @param initialCapacity a hint for the number of entries to hold without resizing
+     * @throws IllegalArgumentException if {@code initialCapacity} is not positive
+     */
+    public OpenAddressingHashMap(int initialCapacity) {
+        this(initialCapacity, DEFAULT_LOAD_FACTOR);
+    }
+
+    /**
+     * Creates an empty map with the given initial capacity and load factor.
+     *
+     * @param initialCapacity a hint for the number of entries to hold without resizing
+     * @param loadFactor      the fraction of occupied slots that triggers a resize,
+     *                        in the open interval {@code (0, 1)}
+     * @throws IllegalArgumentException if {@code initialCapacity} is not positive
+     *                                  or {@code loadFactor} is not in {@code (0, 1)}
+     */
+    @SuppressWarnings("unchecked")
+    public OpenAddressingHashMap(int initialCapacity, double loadFactor) {
+        if (initialCapacity <= 0) {
+            throw new IllegalArgumentException("initialCapacity must be positive: " + initialCapacity);
+        }
+        if (!(loadFactor > 0.0 && loadFactor < 1.0) || Double.isNaN(loadFactor)) {
+            throw new IllegalArgumentException("loadFactor must be in (0, 1): " + loadFactor);
+        }
+        this.table = (Entry<K, V>[]) new Entry[tableSizeFor(initialCapacity)];
+        this.loadFactor = loadFactor;
+    }
+
+    /**
+     * Associates {@code value} with {@code key}, replacing any previous mapping.
+     *
+     * @param key   the key, which must not be {@code null}
+     * @param value the value to associate (may be {@code null})
+     * @return the previous value for {@code key}, or {@code null} if there was none
+     * @throws NullPointerException if {@code key} is {@code null}
+     */
+    public V put(K key, V value) {
+        Objects.requireNonNull(key, "key must not be null");
+
+        if (occupiedSlots + 1 > table.length * loadFactor) {
+            resize(table.length * 2);
+        }
+
+        int firstTombstone = -1;
+        int index = indexFor(key);
+        while (true) {
+            Entry<K, V> slot = table[index];
+            if (slot == null) {
+                // Reuse the earliest tombstone seen on the probe path, if any.
+                int target = (firstTombstone >= 0) ? firstTombstone : index;
+                if (firstTombstone < 0) {
+                    occupiedSlots++;
+                }
+                table[target] = new Entry<>(key, value);
+                size++;
+                return null;
+            }
+            if (slot.isTombstone()) {
+                if (firstTombstone < 0) {
+                    firstTombstone = index;
+                }
+            } else if (slot.key.equals(key)) {
+                V previous = slot.value;
+                slot.value = value;
+                return previous;
+            }
+            index = next(index);
+        }
+    }
+
+    /**
+     * Returns the value associated with {@code key}, or {@code null} if none.
+     *
+     * <p>Note that a {@code null} return may also mean the key is mapped to
+     * {@code null}; use {@link #containsKey(Object)} to distinguish the two.
+     *
+     * @param key the key to look up (may be {@code null}, which is never present)
+     * @return the associated value, or {@code null} if the key is absent
+     */
+    public V get(K key) {
+        Entry<K, V> slot = findEntry(key);
+        return slot == null ? null : slot.value;
+    }
+
+    /**
+     * Returns {@code true} if this map contains a mapping for {@code key}.
+     *
+     * @param key the key to test (may be {@code null}, which is never present)
+     * @return whether the key is present
+     */
+    public boolean containsKey(K key) {
+        return findEntry(key) != null;
+    }
+
+    /**
+     * Removes the mapping for {@code key} if present.
+     *
+     * @param key the key whose mapping should be removed
+     * @return the value that was associated with {@code key}, or {@code null} if absent
+     */
+    public V remove(K key) {
+        if (key == null) {
+            return null;
+        }
+        int index = indexFor(key);
+        while (true) {
+            Entry<K, V> slot = table[index];
+            if (slot == null) {
+                return null;
+            }
+            if (!slot.isTombstone() && slot.key.equals(key)) {
+                V previous = slot.value;
+                table[index] = tombstone();
+                size--;
+                // occupiedSlots is unchanged: the tombstone still occupies the slot.
+                return previous;
+            }
+            index = next(index);
+        }
+    }
+
+    /** Returns the number of live entries in this map. */
+    public int size() {
+        return size;
+    }
+
+    /** Returns {@code true} if this map contains no entries. */
+    public boolean isEmpty() {
+        return size == 0;
+    }
+
+    /** Removes all entries, keeping the current table capacity. */
+    public void clear() {
+        Arrays.fill(table, null);
+        size = 0;
+        occupiedSlots = 0;
+    }
+
+    /**
+     * Performs {@code action} for every live entry, in unspecified order.
+     *
+     * @param action the action to apply to each key/value pair
+     * @throws NullPointerException if {@code action} is {@code null}
+     */
+    public void forEach(BiConsumer<? super K, ? super V> action) {
+        Objects.requireNonNull(action, "action must not be null");
+        for (Entry<K, V> slot : table) {
+            if (slot != null && !slot.isTombstone()) {
+                action.accept(slot.key, slot.value);
+            }
+        }
+    }
+
+    @Override
+    public String toString() {
+        StringBuilder sb = new StringBuilder("{");
+        boolean[] first = {true};
+        forEach((k, v) -> {
+            if (!first[0]) {
+                sb.append(", ");
+            }
+            first[0] = false;
+            sb.append(k).append('=').append(v);
+        });
+        return sb.append('}').toString();
+    }
+
+    // ----------------------------------------------------------------------
+    // Internal helpers
+    // ----------------------------------------------------------------------
+
+    /** Locates the live entry for {@code key}, or {@code null} if absent. */
+    private Entry<K, V> findEntry(K key) {
+        if (key == null) {
+            return null;
+        }
+        int index = indexFor(key);
+        while (true) {
+            Entry<K, V> slot = table[index];
+            if (slot == null) {
+                return null;
+            }
+            if (!slot.isTombstone() && slot.key.equals(key)) {
+                return slot;
+            }
+            index = next(index);
+        }
+    }
+
+    /** Computes the home slot for {@code key} using a spread hash and bit-mask. */
+    private int indexFor(K key) {
+        int h = key.hashCode();
+        h ^= (h >>> 16); // spread high bits into low bits to reduce clustering
+        return h & (table.length - 1);
+    }
+
+    /** Returns the next slot index, wrapping around the power-of-two table. */
+    private int next(int index) {
+        return (index + 1) & (table.length - 1);
+    }
+
+    @SuppressWarnings("unchecked")
+    private Entry<K, V> tombstone() {
+        return (Entry<K, V>) TOMBSTONE;
+    }
+
+    /** Rebuilds the table at {@code newCapacity}, dropping tombstones. */
+    @SuppressWarnings("unchecked")
+    private void resize(int newCapacity) {
+        Entry<K, V>[] old = table;
+        table = (Entry<K, V>[]) new Entry[newCapacity];
+        size = 0;
+        occupiedSlots = 0;
+        for (Entry<K, V> slot : old) {
+            if (slot != null && !slot.isTombstone()) {
+                put(slot.key, slot.value);
+            }
+        }
+    }
+
+    /** Rounds {@code cap} up to the nearest power of two (at least 1). */
+    private static int tableSizeFor(int cap) {
+        int n = -1 >>> Integer.numberOfLeadingZeros(cap - 1);
+        return (n < 0) ? 1 : n + 1;
+    }
+}
