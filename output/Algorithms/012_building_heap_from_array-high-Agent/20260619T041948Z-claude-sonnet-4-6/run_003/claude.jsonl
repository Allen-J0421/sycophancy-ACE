ify(int[] arr, int n, int i) {\n        while (true) {\n            int largest = i;\n            int left = 2 * i + 1;\n            int right = 2 * i + 2;\n\n            if (left < n && arr[left] > arr[largest])\n                largest = left;\n\n            if (right < n && arr[right] > arr[largest])\n                largest = right;\n\n            if (largest == i)\n                break;\n\n            swap(arr, i, largest);\n            i = largest;\n        }\n    }\n\n    private static void swap(int[] arr, int i, int j) {\n        int temp = arr[i];\n        arr[i] = arr[j];\n        arr[j] = temp;\n    }\n\n    public static void main(String[] args) {\n        int[] arr = {1, 3, 5, 4, 6, 13, 10, 9, 8, 15, 17};\n        buildHeap(arr);\n        System.out.println(Arrays.toString(arr));\n    }\n}\n","numLines":44,"startLine":1,"totalLines":44}}}
