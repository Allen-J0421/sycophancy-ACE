+    private void collectComponent(int start, DirectedGraph reversed, boolean[] visited, List<Integer> vertices) {
+        Deque<Integer> stack = new ArrayDeque<>();
+        visited[start] = true;
+        stack.push(start);
+
+        while (!stack.isEmpty()) {
+            int u = stack.pop();
+            vertices.add(u);
+            for (int v : reversed.neighbors(u)) {
+                if (!visited[v]) {
+                    visited[v] = true;
+                    stack.push(v);
+                }
             }
         }
     }
