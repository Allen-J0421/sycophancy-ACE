-    DirectedGraph(Map<V, List<V>> adjacency) {
+    DirectedGraph(Map<V, ? extends List<V>> adjacency) {
         // Defensive copy preserving insertion order; lists made unmodifiable.
         Map<V, List<V>> copy = new LinkedHashMap<>();
