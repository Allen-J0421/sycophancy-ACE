@@ -12,4 +13,18 @@ class RodCuttingProblem {
     int rodLength() {
         return prices.maxLength();
     }
+
+    private static void validate(int[] prices) {
+        if (prices == null) {
+            throw new IllegalArgumentException("prices must not be null");
+        }
+        if (prices.length < 2) {
+            throw new IllegalArgumentException("prices must contain at least one entry (index 0 is an unused sentinel)");
+        }
+        for (int i = 1; i < prices.length; i++) {
+            if (prices[i] < 0) {
+                throw new IllegalArgumentException("prices must be non-negative, but prices[" + i + "] = " + prices[i]);
+            }
+        }
+    }
 }
