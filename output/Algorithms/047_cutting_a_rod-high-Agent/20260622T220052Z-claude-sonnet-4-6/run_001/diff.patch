@@ -0,0 +1,56 @@
+import java.util.ArrayList;
+import java.util.List;
+
+class RodCuttingSolver {
+
+    private static class BestCut {
+        final int length;
+        final int revenue;
+
+        BestCut(int length, int revenue) {
+            this.length = length;
+            this.revenue = revenue;
+        }
+    }
+
+    RodCuttingSolution solve(RodCuttingProblem problem) {
+        int n = problem.rodLength();
+        PriceTable prices = problem.prices();
+        RevenueTable revenue = new RevenueTable(n + 1);
+        CutChoiceTable cutChoice = new CutChoiceTable(n + 1);
+
+        for (int i = 1; i <= n; i++) {
+            BestCut best = findBestCut(i, prices, revenue);
+            revenue.set(i, best.revenue);
+            cutChoice.set(i, best.length);
+        }
+
+        return new RodCuttingSolution(revenue.revenueFor(n), reconstructCuts(n, cutChoice));
+    }
+
+    private BestCut findBestCut(int rodLength, PriceTable prices, RevenueTable revenue) {
+        int bestRevenue = Integer.MIN_VALUE;
+        int bestCutLength = -1;
+
+        for (int cutLength = 1; cutLength <= rodLength; cutLength++) {
+            int candidate = prices.priceFor(cutLength) + revenue.revenueFor(rodLength - cutLength);
+            if (candidate > bestRevenue) {
+                bestRevenue = candidate;
+                bestCutLength = cutLength;
+            }
+        }
+
+        return new BestCut(bestCutLength, bestRevenue);
+    }
+
+    private List<Integer> reconstructCuts(int n, CutChoiceTable cutChoice) {
+        List<Integer> cuts = new ArrayList<>();
+        int remaining = n;
+        while (remaining > 0) {
+            int cut = cutChoice.cutFor(remaining);
+            cuts.add(cut);
+            remaining -= cut;
+        }
+        return cuts;
+    }
+}
