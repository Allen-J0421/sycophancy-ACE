new file mode 100644
index 0000000..7a7c8fa
--- /dev/null
+++ b/CutChoiceTable.java
@@ -0,0 +1,17 @@
+import java.util.ArrayList;
+import java.util.List;
+
+class CutChoiceTable extends LengthIndexedValues {
+    CutChoiceTable(int size) {
+        super(size);
+    }
+
+    List<Integer> reconstructCuts(int remaining) {
+        List<Integer> cuts = new ArrayList<>();
+        while (remaining > 0) {
+            cuts.add(get(remaining));
+            remaining -= get(remaining);
+        }
+        return cuts;
+    }
+}
diff --git a/LengthIndexedValues.java b/LengthIndexedValues.java
new file mode 100644
index 0000000..6fdcdd9
--- /dev/null
+++ b/LengthIndexedValues.java
@@ -0,0 +1,15 @@
+class LengthIndexedValues {
+    private final int[] values;
+
+    LengthIndexedValues(int size) {
+        values = new int[size + 1];
+    }
+
+    int get(int length) {
+        return values[length];
+    }
+
+    void set(int length, int value) {
+        values[length] = value;
+    }
+}
