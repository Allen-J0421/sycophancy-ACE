@@ -0,0 +1,21 @@
+class PriceTable {
+    private final int[] prices;
+
+    PriceTable(int[] prices) {
+        if (prices == null || prices.length < 2) {
+            throw new IllegalArgumentException("prices must have at least one length entry (index 1+)");
+        }
+        this.prices = prices.clone();
+    }
+
+    int rodLength() {
+        return prices.length - 1;
+    }
+
+    int priceAt(int length) {
+        if (length < 1 || length >= prices.length) {
+            throw new IllegalArgumentException("length out of range: " + length);
+        }
+        return prices[length];
+    }
+}
diff --git a/RodCuttingSolver.java b/RodCuttingSolver.java
new file mode 100644
index 0000000..dacfc6a
--- /dev/null
+++ b/RodCuttingSolver.java
@@ -0,0 +1,16 @@
+class RodCuttingSolver implements Solver {
+
+    @Override
+    public int solve(PriceTable prices) {
+        int n = prices.rodLength();
+        int[] dp = new int[n + 1];
+
+        for (int i = 1; i <= n; i++) {
+            for (int j = 1; j <= i; j++) {
+                dp[i] = Math.max(dp[i], prices.priceAt(j) + dp[i - j]);
+            }
+        }
+
+        return dp[n];
+    }
+}
