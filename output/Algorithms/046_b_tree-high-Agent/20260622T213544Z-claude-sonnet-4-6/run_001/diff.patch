index 0000000..e00800f
--- /dev/null
+++ b/Main.java
@@ -0,0 +1,22 @@
+public class Main {
+    public static void main(String[] args) {
+        BTree tree = new BTree(3);
+        tree.insert(10);
+        tree.insert(20);
+        tree.insert(5);
+        tree.insert(6);
+        tree.insert(12);
+        tree.insert(30);
+        tree.insert(7);
+        tree.insert(17);
+
+        System.out.print("Traversal of the constructed tree:");
+        tree.traverse();
+        System.out.println();
+
+        int[] searchKeys = {6, 15};
+        for (int key : searchKeys) {
+            System.out.println(key + ": " + (tree.contains(key) ? "Present" : "Not Present"));
+        }
+    }
+}
