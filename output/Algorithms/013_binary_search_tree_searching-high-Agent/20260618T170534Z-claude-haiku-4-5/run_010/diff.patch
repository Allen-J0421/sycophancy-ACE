+// Range aggregation statistics
+class RangeStatistics<T extends Comparable<T> & Numeric> {
+    public final T min;
+    public final T max;
+    public final double sum;
+    public final double average;
+    public final int count;
+
+    public RangeStatistics(T min, T max, double sum, double average, int count) {
+        this.min = min;
+        this.max = max;
+        this.sum = sum;
+        this.average = average;
+        this.count = count;
+    }
+
+    @Override
+    public String toString() {
+        return String.format("RangeStats{min=%s, max=%s, sum=%.2f, avg=%.2f, count=%d}",
+                           min, max, sum, average, count);
+    }
+}
