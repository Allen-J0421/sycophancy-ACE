ing[] args) {\n        int[] start = {1, 3, 0, 5, 8, 5};\n        int[] finish = {2, 4, 6, 7, 9, 9};\n\n        System.out.println(activitySelection(start, finish));\n    }\n}\n","structuredPatch":[{"oldStart":16,"oldLines":7,"newStart":16,"newLines":7,"lines":["         List<Activity> activities = IntStream.range(0, n)","             .mapToObj(i -> new Activity(start[i], finish[i]))","             .sorted(Comparator.comparingInt(Activity::finish))","-            .collect(Collectors.toList());","+            .toList();"," ","         return countSelected(activities);","     }"]}],"userModified":false,"replaceAll":false}}
