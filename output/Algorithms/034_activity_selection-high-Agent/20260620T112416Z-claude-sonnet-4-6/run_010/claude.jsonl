g[] args) {\n        int[] start = {1, 3, 0, 5, 8, 5};\n        int[] finish = {2, 4, 6, 7, 9, 9};\n\n        System.out.println(activitySelection(start, finish));\n    }\n}\n","structuredPatch":[{"oldStart":16,"oldLines":7,"newStart":16,"newLines":7,"lines":["         }","         return countSelected(IntStream.range(0, start.length)","             .mapToObj(i -> new Activity(start[i], finish[i]))","-            .sorted(Comparator.comparingInt(Activity::finish))","+            .sorted()","             .toList());","     }"," "]}],"userModified":false,"replaceAll":false}}
