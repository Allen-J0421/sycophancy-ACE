diff --git a/search/Found.java b/search/Found.java
new file mode 100644
index 000000000..1993b2529
--- /dev/null
+++ b/search/Found.java
@@ -0,0 +1,24 @@
+package search;
+
+import java.util.Objects;
+import java.util.function.IntFunction;
+import java.util.function.Supplier;
+
+public record Found(int index) implements SearchResult {
+    public Found {
+        if (index < 0) {
+            throw new IllegalArgumentException("index must not be negative");
+        }
+    }
+
+    @Override
+    public <T> T map(IntFunction<? extends T> foundMapper, Supplier<? extends T> notFoundSupplier) {
+        Objects.requireNonNull(foundMapper, "foundMapper must not be null");
+        return foundMapper.apply(index);
+    }
+
+    @Override
+    public int orElse(int defaultIndex) {
+        return index;
+    }
+}
diff --git a/search/NotFound.java b/search/NotFound.java
new file mode 100644
index 000000000..2ab4670c0
--- /dev/null
+++ b/search/NotFound.java
@@ -0,0 +1,18 @@
+package search;
+
+import java.util.Objects;
+import java.util.function.IntFunction;
+import java.util.function.Supplier;
+
+public record NotFound() implements SearchResult {
+    @Override
+    public <T> T map(IntFunction<? extends T> foundMapper, Supplier<? extends T> notFoundSupplier) {
+        Objects.requireNonNull(notFoundSupplier, "notFoundSupplier must not be null");
+        return notFoundSupplier.get();
+    }
+
+    @Override
+    public int orElse(int defaultIndex) {
+        return defaultIndex;
+    }
+}
diff --git a/search/SearchResult.java b/search/SearchResult.java
new file mode 100644
index 000000000..e491635ef
--- /dev/null
+++ b/search/SearchResult.java
@@ -0,0 +1,18 @@
+package search;
+
+import java.util.function.IntFunction;
+import java.util.function.Supplier;
+
+public sealed interface SearchResult permits Found, NotFound {
+    <T> T map(IntFunction<? extends T> foundMapper, Supplier<? extends T> notFoundSupplier);
+
+    int orElse(int defaultIndex);
+
+    static SearchResult found(int index) {
+        return new Found(index);
+    }
+
+    static SearchResult notFound() {
+        return new NotFound();
+    }
+}
