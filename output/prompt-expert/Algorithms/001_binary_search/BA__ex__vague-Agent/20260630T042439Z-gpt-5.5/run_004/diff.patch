diff --git a/SearchRequest.java b/SearchRequest.java
new file mode 100644
index 000000000..345b69bee
--- /dev/null
+++ b/SearchRequest.java
@@ -0,0 +1,24 @@
+class SearchRequest<T extends Comparable<? super T>> {
+    private final T[] values;
+    private final T target;
+
+    SearchRequest(T[] values, T target) {
+        if (values == null) {
+            throw new IllegalArgumentException("values must not be null");
+        }
+        if (target == null) {
+            throw new IllegalArgumentException("target must not be null");
+        }
+
+        this.values = values.clone();
+        this.target = target;
+    }
+
+    T[] values() {
+        return values.clone();
+    }
+
+    T target() {
+        return target;
+    }
+}
diff --git a/SearchResult.java b/SearchResult.java
new file mode 100644
index 000000000..fe540ba59
--- /dev/null
+++ b/SearchResult.java
@@ -0,0 +1,29 @@
+class SearchResult {
+    private static final int NOT_FOUND_INDEX = -1;
+
+    private final int index;
+
+    private SearchResult(int index) {
+        this.index = index;
+    }
+
+    static SearchResult found(int index) {
+        if (index < 0) {
+            throw new IllegalArgumentException("index must not be negative");
+        }
+
+        return new SearchResult(index);
+    }
+
+    static SearchResult notFound() {
+        return new SearchResult(NOT_FOUND_INDEX);
+    }
+
+    boolean isFound() {
+        return index != NOT_FOUND_INDEX;
+    }
+
+    int index() {
+        return index;
+    }
+}
