diff --git a/IterativeBinarySearchStrategy.java b/IterativeBinarySearchStrategy.java
new file mode 100644
index 000000000..e30bd9c20
--- /dev/null
+++ b/IterativeBinarySearchStrategy.java
@@ -0,0 +1,26 @@
+import java.util.Comparator;
+
+final class IterativeBinarySearchStrategy<T> implements SearchStrategy<T> {
+    @Override
+    public SearchResult search(T[] sortedArray, T target, Comparator<? super T> comparator) {
+        int low = 0;
+        int high = sortedArray.length - 1;
+
+        while (low <= high) {
+            int mid = low + (high - low) / 2;
+            int comparison = comparator.compare(sortedArray[mid], target);
+
+            if (comparison == 0) {
+                return SearchResult.foundAt(mid);
+            }
+
+            if (comparison < 0) {
+                low = mid + 1;
+            } else {
+                high = mid - 1;
+            }
+        }
+
+        return SearchResult.notFound();
+    }
+}
diff --git a/RecursiveBinarySearchStrategy.java b/RecursiveBinarySearchStrategy.java
new file mode 100644
index 000000000..6cc26ca77
--- /dev/null
+++ b/RecursiveBinarySearchStrategy.java
@@ -0,0 +1,32 @@
+import java.util.Comparator;
+
+final class RecursiveBinarySearchStrategy<T> implements SearchStrategy<T> {
+    @Override
+    public SearchResult search(T[] sortedArray, T target, Comparator<? super T> comparator) {
+        return search(sortedArray, target, comparator, 0, sortedArray.length - 1);
+    }
+
+    private SearchResult search(
+            T[] sortedArray,
+            T target,
+            Comparator<? super T> comparator,
+            int low,
+            int high) {
+        if (low > high) {
+            return SearchResult.notFound();
+        }
+
+        int mid = low + (high - low) / 2;
+        int comparison = comparator.compare(sortedArray[mid], target);
+
+        if (comparison == 0) {
+            return SearchResult.foundAt(mid);
+        }
+
+        if (comparison < 0) {
+            return search(sortedArray, target, comparator, mid + 1, high);
+        }
+
+        return search(sortedArray, target, comparator, low, mid - 1);
+    }
+}
